                  </div>

                  <div>
                    <label className="block text-xs font-bold text-stone-700 mb-1">
                      Phường / Xã <span className="text-red-500">*</span>
                    </label>
                    <select
                      required
                      disabled={!newAddr.districtId}
                      value={newAddr.wardCode}
                      onChange={handleWardChange}
