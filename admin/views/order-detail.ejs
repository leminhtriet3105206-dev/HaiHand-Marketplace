<!-- ORDER DETAIL VIEW (Inner Content Only for AdminLayout Outlet) -->
<div class="space-y-6 max-w-4xl mx-auto">
    
    <!-- Title & Back Link -->
    <div class="flex items-center justify-between">
        <div>
            <div class="flex items-center gap-2.5">
                <h2 class="text-2xl lg:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
                    📋 Chi Tiết Đơn Hàng
                </h2>
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-purple-100 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 border border-purple-200/60 dark:border-purple-800">
                    #<%= order._id.toString().slice(-6).toUpperCase() %>
                </span>
            </div>
            <p class="text-slate-500 dark:text-slate-400 text-xs mt-1 font-medium">
                Ngày đặt: <%= new Date(order.createdAt).toLocaleString('vi-VN') %>
            </p>
        </div>
        <a href="/orders" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:text-purple-600 dark:hover:text-purple-400 hover:bg-purple-50 dark:hover:bg-slate-700/80 transition text-xs font-bold">
            <i class="fas fa-arrow-left text-[10px]"></i>
            <span>Quay lại</span>
        </a>
    </div>

    <!-- Main Order Details Card -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl shadow-sm border border-slate-200/80 dark:border-slate-800 overflow-hidden transition-colors duration-200">
        <div class="bg-gradient-to-r from-purple-600 to-indigo-600 p-6 text-white flex justify-between items-center">
            <div>
                <h3 class="text-lg font-black">Mã đơn: #<%= order._id.toString().slice(-6).toUpperCase() %></h3>
                <p class="text-xs opacity-80 mt-0.5">Trạng thái thanh toán & vận chuyển</p>
            </div>
            <div>
                <span class="px-3 py-1 rounded-full text-xs font-black uppercase bg-white/20 backdrop-blur-xs text-white border border-white/30">
                    <%= order.status %>
                </span>
            </div>
        </div>

        <div class="p-6 grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Left: Buyer & Seller Info -->
            <div class="space-y-6">
                <div>
                    <h4 class="text-slate-400 dark:text-slate-500 uppercase text-[10px] font-bold tracking-widest mb-3">Người mua</h4>
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-purple-100 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 flex items-center justify-center font-bold text-sm">
                            <%= (order.buyer?.name || 'U').charAt(0).toUpperCase() %>
                        </div>
                        <div>
                            <p class="font-bold text-slate-800 dark:text-slate-100 text-sm"><%= order.buyer?.name || 'Ẩn danh' %></p>
                            <p class="text-xs text-slate-400 dark:text-slate-500"><%= order.buyer?.email || 'Chưa có email' %></p>
                        </div>
                    </div>
                </div>

                <div class="pt-4 border-t border-slate-100 dark:border-slate-800">
                    <h4 class="text-slate-400 dark:text-slate-500 uppercase text-[10px] font-bold tracking-widest mb-3">Người bán</h4>
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-amber-100 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 flex items-center justify-center font-bold text-sm">
                            <%= (order.seller?.name || 'S').charAt(0).toUpperCase() %>
                        </div>
                        <div>
                            <p class="font-bold text-slate-800 dark:text-slate-100 text-sm"><%= order.seller?.name || 'Chưa xác định' %></p>
                            <p class="text-xs text-slate-400 dark:text-slate-500"><%= order.seller?.email || '' %></p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Products & Summary -->
            <div class="md:col-span-2 bg-slate-50 dark:bg-slate-800/40 rounded-2xl p-6 border border-slate-100 dark:border-slate-800">
                <h4 class="text-slate-700 dark:text-slate-300 font-bold mb-4 text-xs uppercase tracking-wider">Thông tin thanh toán</h4>
                <div class="space-y-3">
                    <div class="flex justify-between items-center text-xs">
                        <span class="text-slate-500 dark:text-slate-400">Địa chỉ giao hàng:</span>
                        <span class="font-medium text-slate-800 dark:text-slate-200"><%= order.address || 'Không có địa chỉ' %></span>
                    </div>
                    <div class="flex justify-between items-center text-xs">
                        <span class="text-slate-500 dark:text-slate-400">Số điện thoại liên hệ:</span>
                        <span class="font-medium text-slate-800 dark:text-slate-200"><%= order.phone || 'Không có SĐT' %></span>
                    </div>
                    <div class="flex justify-between items-center text-xs">
                        <span class="text-slate-500 dark:text-slate-400">Phương thức thanh toán:</span>
                        <span class="font-bold text-purple-600 dark:text-purple-400"><%= order.paymentMethod || 'HaiPay' %></span>
                    </div>
                </div>

                <div class="mt-6 pt-6 border-t-2 border-dashed border-slate-200 dark:border-slate-700 flex justify-between items-center">
                    <span class="text-slate-600 dark:text-slate-400 font-bold text-sm">TỔNG THANH TOÁN:</span>
                    <span class="text-2xl font-black text-emerald-600 dark:text-emerald-400"><%= (order.totalPrice || order.totalAmount || 0).toLocaleString('vi-VN') %> đ</span>
                </div>
            </div>
        </div>
    </div>

</div>