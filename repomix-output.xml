<file path="backend/views/orders.ejs">
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Quản lý đơn hàng - HaiHand Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap');
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-100 flex min-h-screen font-sans">
    
    <%- include('partials/sidebar', {active: 'orders'}) %>

    <div class="flex-1 p-10 h-screen overflow-y-auto ml-64">
        
        <div class="flex justify-between items-center mb-8">
            <h2 class="text-3xl font-black tracking-tight text-slate-800">🛍️ Quản lý Đơn hàng</h2>
            <div class="relative w-96">
                <span class="absolute left-3 top-2.5 text-slate-400">🔍</span>
                <input type="text" id="orderSearch" onkeyup="filterOrders()" placeholder="Tìm theo mã đơn hoặc tên khách..." 
                       class="w-full px-4 py-2 pl-10 border border-slate-300 rounded-xl shadow-sm focus:ring-2 focus:ring-blue-500 outline-none transition-all font-medium text-sm">
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
            <table class="w-full text-left border-collapse" id="ordersTable">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200 text-slate-400 text-[11px] font-black uppercase tracking-wider">
                        <th class="px-6 py-4">Mã đơn</th>
                        <th class="px-6 py-4">Khách hàng</th>
                        <th class="px-6 py-4">Ngày đặt</th>
                        <th class="px-6 py-4">Tổng tiền</th>
                        <th class="px-6 py-4">Trạng thái</th>
                        <th class="px-6 py-4 text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-sm">
                    <% if(orders && orders.length > 0) { %>
                        <% orders.forEach(order => { %>
                        <tr class="hover:bg-slate-50 transition-all order-row">
                            <td class="px-6 py-4 font-mono font-bold text-blue-600">
                                #<%= order._id.toString().slice(-6).toUpperCase() %>
                            </td>
                            <td class="px-6 py-4">
                                <div class="font-bold text-slate-800"><%= order.buyer?.name || 'N/A' %></div>
                                <div class="text-[11px] text-slate-400"><%= order.phone || 'Không có SĐT' %></div>
                            </td>
                            <td class="px-6 py-4 text-slate-500">
                                <%= new Date(order.createdAt).toLocaleDateString('vi-VN') %>
                            </td>
                            <td class="px-6 py-4 font-black text-slate-700">
                                <%= (order.totalPrice || 0).toLocaleString('vi-VN') %> đ
                            </td>
                            <td class="px-6 py-4">
                                <% if (order.status === 'Đã thanh toán cho người bán' || order.status === 'Đã hủy' || order.status === 'Hoàn thành') { %>
                                    <span class="px-3 py-1.5 rounded-lg text-[10px] font-black uppercase shadow-sm inline-block
                                        <%= order.status.includes('thanh toán') || order.status === 'Hoàn thành' ? 'bg-green-100 text-green-600' : 'bg-red-100 text-red-600' %>">
                                        <%= order.status %> 🔒
                                    </span>
                                <% } else { %>
                                    <form action="/orders/update-status/<%= order._id %>" method="POST">
                                        <select name="status" onchange="this.form.submit()" 
                                                class="px-3 py-1.5 rounded-lg text-[10px] font-black uppercase border-0 cursor-pointer shadow-sm transition-all bg-yellow-100 text-yellow-600">
                                            <option value="Chờ xác nhận" <%= order.status === 'Chờ xác nhận' ? 'selected' : '' %>>Chờ xác nhận</option>
                                            <option value="Đã thanh toán (Admin giữ tiền)" <%= order.status === 'Đã thanh toán (Admin giữ tiền)' ? 'selected' : '' %>>Đã thanh toán</option>
                                            <option value="Người bán đã chuẩn bị hàng" <%= order.status === 'Người bán đã chuẩn bị hàng' ? 'selected' : '' %>>Người bán chuẩn bị xong</option>
                                            <option value="Đang giao hàng" <%= order.status === 'Đang giao hàng' ? 'selected' : '' %>>Đang giao hàng</option>
                                            <option value="Hoàn thành" <%= order.status === 'Hoàn thành' ? 'selected' : '' %>>Hoàn thành</option>
                                            <option value="Đã hủy (Chờ hoàn tiền)" <%= order.status === 'Đã hủy (Chờ hoàn tiền)' ? 'selected' : '' %>>Chờ hoàn tiền</option>
                                            <option value="Đã hủy" <%= order.status === 'Đã hủy' ? 'selected' : '' %>>Đã hủy</option>
                                        </select>
                                    </form>
                                <% } %>
                            </td>
                            <td class="px-6 py-4 text-center flex justify-center items-center gap-2">
                                <button type="button" 
                                        onclick="openOrderDetails('<%= order._id %>', '<%= order.buyer?.name || `Ẩn danh` %>', '<%= order.phone %>', '<%= order.address %>', '<%= order.createdAt %>', '<%= order.updatedAt %>', '<%= order.totalPrice %>')" 
                                        class="bg-indigo-50 text-indigo-600 px-4 py-1.5 rounded-lg text-xs font-black hover:bg-indigo-600 hover:text-white transition-all border border-indigo-100">
                                    CHI TIẾT
                                </button>

                                <% if (order.status === 'Hoàn thành') { %>
                                    <button onclick="releaseFunds('<%= order._id %>')" 
                                            class="bg-green-600 text-white px-3 py-1.5 rounded-lg text-xs font-black hover:bg-green-700 shadow-md transition-all">
                                        GIẢI NGÂN
                                    </button>
                                <% } %>

                                <% if (order.status === 'Đã hủy (Chờ hoàn tiền)') { %>
                                    <button onclick="refundOrder('<%= order._id %>')" 
                                            class="bg-orange-500 text-white px-3 py-1.5 rounded-lg text-xs font-black hover:bg-orange-600 shadow-md transition-all">
                                        HOÀN TIỀN
                                    </button>
                                <% } %>
                                
                                <button onclick="deleteOrder('<%= order._id %>')" 
                                        class="bg-red-50 text-red-500 px-3 py-1.5 rounded-lg text-xs font-black hover:bg-red-600 hover:text-white transition-all border border-red-100">
                                    🗑️
                                </button>
                            </td>
                        </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="p-20 text-center text-slate-400 font-bold">Chưa có đơn hàng nào.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <div id="adminOrderModal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[9999] flex justify-center items-center transition-all">
        <div class="bg-white rounded-2xl shadow-2xl w-[500px] overflow-hidden transform scale-95 transition-transform" id="modalContent">
            <div class="bg-slate-900 p-4 flex justify-between items-center text-white font-bold">
                <h3>📋 Chi tiết đơn hàng</h3>
                <button onclick="closeOrderDetails()" class="text-2xl">&times;</button>
            </div>
            <div class="p-6 space-y-3 text-sm">
                <p><b>Mã đơn:</b> <span id="md-id"></span></p>
                <p><b>Khách hàng:</b> <span id="md-name"></span></p>
                <p><b>Số điện thoại:</b> <span id="md-phone"></span></p>
                <p><b>Địa chỉ:</b> <span id="md-address"></span></p>
                <p><b>Thời gian:</b> <span id="md-created"></span></p>
                <hr>
                <p class="text-right text-lg"><b>Tổng thu:</b> <span id="md-price" class="text-red-500 font-black"></span></p>
            </div>
            <div class="p-4 bg-slate-50 text-right">
                <button onclick="closeOrderDetails()" class="bg-slate-800 text-white px-6 py-2 rounded-lg font-bold text-sm">Đóng</button>
            </div>
        </div>
    </div>

    <script>
        
        function filterOrders() {
            const input = document.getElementById("orderSearch").value.toLowerCase();
            const rows = document.querySelectorAll(".order-row");
            rows.forEach(row => {
                row.style.display = row.innerText.toLowerCase().includes(input) ? "" : "none";
            });
        }

        
        async function deleteOrder(id) {
            if(!confirm("⚠️ Hành động này sẽ xóa vĩnh viễn dữ liệu đơn hàng. Tiếp tục?")) return;
            const res = await fetch(`/admin/orders/delete/${id}`, { method: 'POST' });
            if(res.ok) {
                alert("✅ Đã xóa đơn hàng!");
                location.reload();
            }
        }

        
        async function releaseFunds(orderId) {
            if(!confirm("💸 Xác nhận giải ngân 95% số tiền cho người bán?")) return;
            try {
                const res = await fetch(`/api/admin/release-funds/${orderId}`, { method: 'POST' });
                const data = await res.json();
                alert(data.message);
                if(res.ok) location.reload();
            } catch (e) {
                alert("❌ Lỗi hệ thống giải ngân!");
            }
        }

        
        async function refundOrder(orderId) {
            if(!confirm("💸 Xác nhận hoàn trả lại tiền vào ví HaiPay cho khách hàng?")) return;
            try {
                const res = await fetch(`/api/admin/refund-order/${orderId}`, { method: 'POST' });
                const data = await res.json();
                alert(data.message);
                if(res.ok) location.reload();
            } catch (e) {
                alert("❌ Lỗi hệ thống hoàn tiền!");
            }
        }

        
        function openOrderDetails(id, name, phone, address, created, updated, price) {
            document.getElementById('md-id').textContent = '#' + id.slice(-6).toUpperCase();
            document.getElementById('md-name').textContent = name;
            document.getElementById('md-phone').textContent = phone;
            document.getElementById('md-address').textContent = address;
            document.getElementById('md-created').textContent = new Date(created).toLocaleString('vi-VN');
            document.getElementById('md-price').textContent = Number(price).toLocaleString('vi-VN') + ' đ';
            document.getElementById('adminOrderModal').classList.remove('hidden');
            setTimeout(() => document.getElementById('modalContent').classList.remove('scale-95'), 10);
        }

        function closeOrderDetails() {
            document.getElementById('modalContent').classList.add('scale-95');
            setTimeout(() => document.getElementById('adminOrderModal').classList.add('hidden'), 150);
        }
    </script>
</body>
</html>
</file>

<file path="backend/views/posts.ejs">
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HaiHand Admin - Quản lý tin đăng</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f4f7f6; font-family: 'Inter', sans-serif; }
        .card-table { border: none; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.04); background: white; }
        .product-img { width: 55px; height: 55px; object-fit: cover; border-radius: 10px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
        .status-badge { font-size: 11px; padding: 6px 12px; border-radius: 50px; font-weight: 600; text-transform: uppercase; }
        .btn-action { border-radius: 8px; font-size: 13px; font-weight: 600; padding: 6px 15px; }
        .table thead th { background-color: #f8f9fa; border-top: none; color: #6c757d; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; }
    </style>
</head>
<body class="flex min-h-screen">

    <%- include('partials/sidebar') %>

    <div class="flex-1 p-10 h-screen overflow-y-auto w-full">
        <div class="container-fluid px-0">
            <div class="row align-items-center mb-4">
                <div class="col">
                    <h2 class="fw-bold m-0 text-dark">Kiểm duyệt tin đăng</h2>
                    <p class="text-muted small">Nơi đảm bảo nội dung sạch cho cộng đồng HaiHand</p>
                </div>
                <div class="col-auto">
                    <div class="input-group shadow-sm" style="width: 350px;">
                        <span class="input-group-text bg-white border-end-0 text-muted">🔍</span>
                        <input type="text" id="adminSearch" class="form-control border-start-0 py-2 ps-0" placeholder="Tìm sản phẩm, người bán..." onkeyup="filterPosts()">
                    </div>
                </div>
            </div>

            <div class="card card-table overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="postTable">
                        <thead>
                            <tr>
                                <th class="ps-4 py-3">Sản phẩm</th>
                                <th>Người bán</th>
                                <th>Giá niêm yết</th>
                                <th>Danh mục</th>
                                <th>Trạng thái</th>
                                <th class="text-center">Quản lý</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% posts.forEach(post => { %>
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center py-2">
                                        <% 
                                            
                                            let imgSrc = 'https://upload.wikimedia.org/wikipedia/commons/1/14/No_Image_Available.jpg';
                                            if (post.images && post.images.length > 0) {
                                                imgSrc = post.images[0].startsWith('http') ? post.images[0] : '/' + post.images[0].replace(/\\/g, '/');
                                            } else if (post.image) {
                                                imgSrc = post.image.startsWith('http') ? post.image : '/uploads/' + post.image;
                                            }
                                        %>
                                        <img src="<%= imgSrc %>" class="product-img me-3" onerror="this.src='https://upload.wikimedia.org/wikipedia/commons/1/14/No_Image_Available.jpg'">
                                        <div>
                                            <div class="fw-bold text-dark"><%= post.title %></div>
                                            <small class="text-muted"><i class="me-1">📍</i><%= post.location %></small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="small fw-bold"><%= post.author ? post.author.name : 'Vô danh' %></div>
                                    </div>
                                    <small class="text-muted"><%= post.author ? post.author.email : '' %></small>
                                </td>
                                <td>
                                    <span class="text-danger fw-bold">
                                        <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(post.price) %>
                                    </span>
                                </td>
                                <td><span class="badge bg-light text-secondary border px-2"><%= post.category %></span></td>
                                <td>
                                    <% if(post.status === 'PENDING') { %>
                                        <span class="badge bg-warning-subtle text-warning status-badge">⌛ Đang chờ</span>
                                    <% } else { %>
                                        <span class="badge bg-success-subtle text-success status-badge">✅ Đã duyệt</span>
                                    <% } %>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <% if(post.status === 'PENDING') { %>
                                            <button class="btn btn-sm btn-success btn-action" onclick="approvePost('<%= post._id %>')">Duyệt bài</button>
                                        <% } %>
                                        <button class="btn btn-sm btn-outline-danger btn-action" onclick="deletePost('<%= post._id %>')">Gỡ bỏ</button>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
                <div id="noResults" class="text-center py-5 d-none">
                    <div class="display-1 text-muted opacity-25 mb-3">📦</div>
                    <h5 class="text-muted">Không tìm thấy dữ liệu nào!</h5>
                </div>
            </div>
        </div>
    </div>

    <script>
        function filterPosts() {
            const input = document.getElementById("adminSearch").value.toLowerCase();
            const rows = document.querySelectorAll("#postTable tbody tr");
            let hasData = false;
            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                if (text.includes(input)) {
                    row.style.display = "";
                    hasData = true;
                } else {
                    row.style.display = "none";
                }
            });
            document.getElementById("noResults").classList.toggle("d-none", hasData);
        }

        
        async function deletePost(id) {
            if(!confirm("❗ Bẩm lão đại, ngài có chắc chắn muốn XÓA vĩnh viễn tin này chứ? Hành động này không thể hoàn tác!")) {
                return;
            }
            
            try {
                const response = await fetch(`/api/posts/${id}`, {
                    method: 'DELETE'
                });

                if (response.ok) {
                    alert("⚔️ Bẩm, đã trảm bài đăng thành công!");
                    window.location.reload(); 
                } else {
                    alert("Lỗi: Kẻ địch quá mạnh, không thể gỡ bỏ! (Hãy đảm bảo Server đã có API DELETE /api/posts/:id)");
                }
            } catch (error) {
                console.error("Lỗi Server:", error);
                alert("Đã xảy ra sự cố sập cầu dao khi kết nối với server!");
            }
        }

        
        function approvePost(id) {
            if (confirm("Phê duyệt bài đăng này để hiển thị công khai trên HaiHand?")) {
                window.location.href = "/posts/approve/" + id;
            }
        }
    </script>
</body>
</html>
</file>

<file path="backend/views/reports.ejs">
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Quản lý Báo cáo - HaiHand Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap');
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-100 flex min-h-screen font-sans">
    
    <%- include('partials/sidebar', {active: 'reports'}) %>

    <div class="flex-1 p-10 h-screen overflow-y-auto ml-64">
        
        <div class="flex justify-between items-center mb-8">
            <h2 class="text-3xl font-black tracking-tight text-slate-800">🚩 Quản lý Báo cáo Vi phạm</h2>
            <div class="bg-red-100 text-red-600 px-4 py-2 rounded-full text-xs font-black uppercase shadow-sm">
                Tổng cộng: <%= reports.length %> yêu cầu
            </div>
        </div>

        <% if(reports.length === 0) { %>
            <div class="bg-white rounded-2xl p-20 text-center shadow-sm border border-slate-200">
                <div class="text-6xl mb-4 opacity-50">🍃</div>
                <p class="font-bold text-slate-400">Hiện tại hệ thống sạch bóng vi phạm!</p>
            </div>
        <% } else { %>
            <div class="grid gap-6">
                <% reports.forEach(report => { %>
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 hover:border-red-300 transition-all flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                    <div class="flex gap-5 items-start">
                        <div class="bg-red-50 text-red-500 p-4 rounded-2xl text-2xl shadow-inner">
                            ⚠️
                        </div>
                        <div>
                            <div class="flex items-center gap-3 mb-1">
                                <h4 class="font-black text-slate-800 text-lg"><%= report.reason %></h4>
                                <span class="bg-slate-100 text-slate-500 text-[10px] px-2 py-0.5 rounded font-bold uppercase">
                                    <%= report.status %>
                                </span>
                            </div>
                            <p class="text-xs text-slate-500 mb-3">
                                Người gửi: <span class="font-bold text-slate-700"><%= report.reporter?.name || 'Ẩn danh' %></span> 
                                <span class="mx-2">|</span> 
                                Ngày: <span class="font-mono"><%= new Date(report.createdAt).toLocaleString('vi-VN') %></span>
                            </p>
                            
                            <% if(report.post) { %>
                                <a href="http://localhost:3000/post/<%= report.post._id %>" target="_blank" 
                                   class="inline-flex items-center gap-2 bg-blue-50 text-blue-600 px-3 py-1.5 rounded-lg text-[11px] font-black hover:bg-blue-600 hover:text-white transition-all border border-blue-100">
                                    🔗 XEM TIN ĐĂNG: <%= report.post.title %>
                                </a>
                            <% } else { %>
                                <span class="text-[11px] text-red-400 font-bold italic">Tin đăng này đã bị xóa trước đó.</span>
                            <% } %>
                        </div>
                    </div>
                    
                    <div class="flex flex-row md:flex-col gap-2 w-full md:w-auto">
                        <form action="/admin/reports/ignore/<%= report._id %>" method="POST" class="flex-1 md:w-full">
                            <button class="w-full px-5 py-2.5 bg-slate-100 text-slate-600 rounded-xl text-xs font-black hover:bg-slate-200 transition-all">
                                BỎ QUA
                            </button>
                        </form>
                        
                        <% if(report.post) { %>
                        <form action="/admin/posts/delete/<%= report.post._id %>" method="POST" onsubmit="return confirm('❗ Ní có chắc muốn XÓA VĨNH VIỄN bài viết vi phạm này không?')" class="flex-1 md:w-full">
                            <button class="w-full px-5 py-2.5 bg-red-600 text-white rounded-xl text-xs font-black hover:bg-red-700 shadow-lg shadow-red-200 transition-all">
                                XÓA VI PHẠM
                            </button>
                        </form>
                        <% } %>
                    </div>
                </div>
                <% }) %>
            </div>
        <% } %>
    </div>
</body>
</html>
</file>

<file path="backend/views/revenue.ejs">
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thống kê Doanh thu - HaiHand Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap');
        body { font-family: 'Inter', sans-serif; }

        /* 🚀 PHẦN FIX IN ẤN TRIỆT ĐỂ */
        @media print {
            /* 1. Xóa sạch Sidebar bằng mọi giá */
            #admin-sidebar, 
            .w-64, 
            aside, 
            .no-print, 
            button, 
            .bg-gradient-to-br {
                display: none !important;
                visibility: hidden !important;
                width: 0 !important;
                height: 0 !important;
                margin: 0 !important;
                padding: 0 !important;
                position: absolute !important; /* Đẩy ra khỏi luồng hiển thị */
            }

            /* 2. Ép nội dung chính tràn hết trang giấy, bỏ lề trái ml-64 */
            main, 
            .ml-64, 
            .flex-1 {
                margin-left: 0 !important;
                padding: 0 !important;
                width: 100% !important;
                display: block !important;
            }

            /* 3. Tiêu đề báo cáo khi in */
            .print-header {
                display: block !important;
                text-align: center;
                margin-bottom: 20px;
                border-bottom: 2px solid #000;
                padding-bottom: 10px;
            }

            /* 4. Định dạng lại bảng cho sát lề giấy in */
            .max-w-6xl {
                max-width: 100% !important;
                width: 100% !important;
            }
            
            .bg-white {
                box-shadow: none !important;
                border: 1px solid #ddd !important;
            }

            body {
                background: white !important;
            }
        }

        .print-header { display: none; }
    </style>
</head>
<body class="bg-slate-50 flex min-h-screen">

    <div id="admin-sidebar" class="no-print">
        <%- include('partials/sidebar', {active: 'revenue'}) %>
    </div>

    <main class="flex-1 p-10 ml-64 transition-all duration-300">
        <div class="max-w-6xl mx-auto">
            
            <div class="print-header">
                <h1 class="text-2xl font-bold uppercase">Báo cáo doanh thu chiết khấu HaiHand</h1>
                <p>Ngày xuất: <%= new Date().toLocaleString('vi-VN') %></p>
            </div>

            <div class="flex justify-between items-center mb-8 no-print">
                <div>
                    <h2 class="text-3xl font-black text-slate-800 tracking-tight">💰 Doanh thu sàn</h2>
                    <p class="text-slate-500 mt-1">Quản lý phí chiết khấu 5% giao dịch.</p>
                </div>
                <button onclick="window.print()" class="bg-slate-900 text-white px-6 py-2.5 rounded-xl font-bold hover:scale-105 transition shadow-lg flex items-center space-x-2">
                    <span>🖨️</span>
                    <span>Xuất báo cáo</span>
                </button>
            </div>

            <div class="bg-gradient-to-br from-yellow-400 to-orange-500 rounded-3xl p-8 text-white shadow-2xl shadow-orange-200 mb-10 relative overflow-hidden no-print">
                <div class="relative z-10">
                    <h6 class="text-sm font-bold uppercase tracking-widest opacity-80 mb-2">Tổng thu nhập sàn</h6>
                    <div class="flex items-baseline space-x-2">
                        <span class="text-5xl font-black"><%= totalRevenue.toLocaleString('vi-VN') %></span>
                        <span class="text-2xl font-bold opacity-80">VNĐ</span>
                    </div>
                </div>
                <div class="absolute right-[-20px] bottom-[-20px] text-[150px] opacity-20 rotate-12">💸</div>
            </div>

            <div class="bg-white rounded-3xl shadow-xl overflow-hidden border border-slate-100">
                <div class="p-6 border-b border-slate-50 bg-slate-50/50 no-print">
                    <h5 class="font-bold text-slate-800">Lịch sử thu phí chi tiết</h5>
                </div>
                <div class="overflow-x-auto p-4">
                    <table class="w-full text-left border-collapse border border-slate-100">
                        <thead>
                            <tr class="text-slate-400 text-xs uppercase tracking-widest border-b border-slate-100 bg-slate-50">
                                <th class="px-4 py-3 font-bold border text-center">Ngày giao dịch</th>
                                <th class="px-4 py-3 font-bold border text-center">Mã đơn</th>
                                <th class="px-4 py-3 font-bold border">Khách hàng</th>
                                <th class="px-4 py-3 font-bold text-right border">Giá trị đơn</th>
                                <th class="px-4 py-3 font-bold text-center border text-emerald-600">Lãi (5%)</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            <% if (revenueList.length === 0) { %>
                                <tr><td colspan="5" class="px-6 py-10 text-center text-slate-400 font-medium">Chưa có dữ liệu.</td></tr>
                            <% } %>
                            <% revenueList.forEach(item => { %>
                                <tr class="hover:bg-slate-50 transition">
                                    <td class="px-4 py-3 text-sm border text-center text-slate-500">
                                        <%= item.createdAt.toLocaleString('vi-VN', { dateStyle: 'short' }) %>
                                    </td>
