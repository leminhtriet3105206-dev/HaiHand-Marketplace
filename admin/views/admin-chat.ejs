<div class="space-y-4">
  <div>
    <h2 class="text-2xl lg:text-3xl font-black text-slate-900 dark:text-white">Trực ban CSKH</h2>
    <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Yêu cầu tư vấn đang chờ và hội thoại từ khách hàng HaiHand.</p>
  </div>
  <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden flex" style="height: min(680px, 75vh); min-height: 400px;">
    <aside class="w-1/3 min-w-48 border-r border-slate-200 dark:border-slate-800 overflow-y-auto p-3">
      <div class="font-bold mb-3">Hội thoại</div>
      <div id="support-conversations" class="space-y-1"></div>
    </aside>
    <section class="flex-1 flex flex-col min-w-0">
      <div id="support-name" class="p-4 font-bold border-b border-slate-200 dark:border-slate-800">Chọn khách hàng để xem tin nhắn</div>
      <div id="support-messages" class="flex-1 overflow-y-auto p-4 space-y-3"></div>
      <form id="support-form" class="p-3 border-t border-slate-200 dark:border-slate-800 flex gap-2">
        <input id="support-draft" class="flex-1 min-w-0 rounded-xl border border-slate-300 px-3 py-2 text-slate-900" maxlength="2000" placeholder="Nhập câu trả lời..." disabled>
        <button id="support-send" class="rounded-xl bg-amber-400 px-4 py-2 font-bold disabled:opacity-50" disabled>Gửi</button>
      </form>
      <p id="support-error" class="text-red-600 text-sm px-3 pb-2" role="alert"></p>
    </section>
  </div>
</div>
<script src="/js/admin-support-chat.js" defer></script>
