<file path="frontend/src/pages/ImageSearchPage.js">
import React, { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import axios from 'axios';
import { AppHeader } from '../components/AppHeader';
import { AppFooter } from '../components/AppFooter';
import { ProductCard } from '../components/ProductCard';

const API_URL = process.env.REACT_APP_API_URL || 'http://localhost:4000';
const IMAGE_TYPES = ['image/jpeg', 'image/png', 'image/webp'];

export default function ImageSearchPage() {
  const navigate = useNavigate();
  const [image, setImage] = useState('');
  const [description, setDescription] = useState('');
  const [products, setProducts] = useState([]);
  const [searched, setSearched] = useState(false);
  const [error, setError] = useState('');
  const [loading, setLoading] = useState(false);
  const [dragging, setDragging] = useState(false);

  const selectImage = (file) => {
    if (!file) return;
    if (!IMAGE_TYPES.includes(file.type) || file.size > 5 * 1024 * 1024) {
      setError('Chọn ảnh JPG, PNG hoặc WebP có dung lượng không quá 5 MB.');
      return;
    }
    const reader = new FileReader();
    reader.onload = () => {
      setImage(reader.result);
      setProducts([]);
      setSearched(false);
      setError('');
    };
    reader.onerror = () => setError('Không đọc được ảnh. Vui lòng chọn ảnh khác.');
    reader.readAsDataURL(file);
  };

  const handleSearch = async (event) => {
    event.preventDefault();
    if (!image || loading) return;
    setLoading(true);
    setError('');
    setSearched(false);
    try {
      const { data } = await axios.post(`${API_URL}/api/image-search/search`, {
        image,
        message: description.trim()
      });
      setProducts(data.products || []);
      setSearched(true);
    } catch (err) {
      setProducts([]);
      setError(err.response?.data?.error || 'Không thể tìm kiếm lúc này. Kiểm tra backend và LM Studio rồi thử lại.');
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="min-h-screen bg-[#FFFBEB] text-[#1C1917]">
      <AppHeader onSearch={(keyword) => navigate(`/products?search=${encodeURIComponent(keyword)}`)} />
      <main className="max-w-[1200px] mx-auto px-4 py-10 md:py-14">
        <div className="mb-8">
          <p className="text-sm font-semibold text-[#EA580C] mb-2">TÌM SẢN PHẨM</p>
          <h1 className="text-3xl font-bold tracking-tight">Tìm kiếm bằng hình ảnh</h1>
          <p className="mt-3 text-[#57534E] max-w-2xl">Tải ảnh món đồ bạn muốn tìm. Bạn có thể thêm vài từ mô tả để kết quả sát hơn.</p>
        </div>

        <form onSubmit={handleSearch} className="bg-white border border-[#E7E5E4] rounded-xl p-5 md:p-8 shadow-sm">
          <label
            htmlFor="image-search-file"
            onDragOver={(event) => { event.preventDefault(); setDragging(true); }}
            onDragLeave={(event) => { event.preventDefault(); setDragging(false); }}
            onDrop={(event) => {
              event.preventDefault();
              setDragging(false);
              if (!loading) selectImage(event.dataTransfer.files[0]);
            }}
            className={`flex flex-col items-center justify-center min-h-[240px] rounded-xl border-2 border-dashed cursor-pointer text-center px-4 transition-colors ${dragging ? 'border-[#EAB308] bg-[#FFFBEB]' : 'border-[#D6D3D1] bg-[#FAFAF9] hover:border-[#EAB308]'}`}
          >
            {image ? (
              <>
                <img src={image} alt="Ảnh đang tìm" className="max-h-52 max-w-full object-contain rounded-lg" />
                <span className="text-sm font-medium mt-3">Bấm hoặc kéo ảnh khác vào đây</span>
              </>
            ) : (
              <>
                <span className="text-4xl mb-3" aria-hidden="true">📷</span>
                <span className="font-semibold">Chọn ảnh hoặc kéo thả vào đây</span>
                <span className="text-sm text-[#57534E] mt-2">JPG, PNG, WebP · tối đa 5 MB</span>
              </>
            )}
          </label>
          <input
            id="image-search-file"
            type="file"
            accept="image/jpeg,image/png,image/webp"
            className="sr-only"
            disabled={loading}
            onChange={(event) => { selectImage(event.target.files?.[0]); event.target.value = ''; }}
          />
          <div className="mt-5 flex flex-col md:flex-row gap-3">
            <input
              type="text"
              value={description}
              onChange={(event) => setDescription(event.target.value)}
              maxLength={200}
              placeholder="Mô tả thêm, ví dụ: gà giống, màu đen... (không bắt buộc)"
              aria-label="Mô tả sản phẩm cần tìm"
              className="flex-1 min-w-0 h-11 px-4 rounded-lg border border-[#E7E5E4] focus:outline-none focus:border-[#EAB308]"
            />
            <button type="submit" disabled={!image || loading} className="h-11 px-7 rounded-lg bg-[#FACC15] hover:bg-[#EAB308] text-[#1C1917] font-semibold disabled:opacity-50 disabled:cursor-not-allowed">
              {loading ? 'Đang tìm kiếm...' : 'Tìm sản phẩm'}
            </button>
          </div>
          {error && <p role="alert" className="text-red-600 text-sm mt-3">{error}</p>}
        </form>

        {(loading || searched) && (
          <section className="mt-10" aria-live="polite">
            <h2 className="text-2xl font-bold mb-5">Kết quả tìm kiếm</h2>
            {loading ? (
              <p className="text-[#57534E]">AI đang đối chiếu ảnh với sản phẩm trong kho...</p>
            ) : products.length ? (
              <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                {products.map((product) => (
                  <ProductCard
                    key={product._id}
                    hideFavorite
                    product={{
                      id: product._id,
                      title: product.name,
                      price: product.price,
                      imageUrl: product.image,
                      location: product.location || 'Toàn quốc',
                      condition: product.condition,
                      timeAgo: 'Đang bán'
                    }}
                  />
                ))}
              </div>
            ) : (
              <p className="bg-white border border-[#E7E5E4] rounded-lg p-5 text-[#57534E]">Chưa tìm thấy sản phẩm phù hợp với ảnh này trong kho hiện tại. Thử ảnh rõ hơn hoặc thêm mô tả.</p>
            )}
          </section>
        )}
      </main>
      <AppFooter />
    </div>
  );
}
</file>

<file path="frontend/src/pages/InboxPage.js">
import React, { useState, useEffect, useRef } from 'react';
import axios from 'axios';
import { useNavigate } from 'react-router-dom';
import { useSocket } from '../context/SocketContext';

const InboxPage = () => {
  const [conversations, setConversations] = useState([]);
  const navigate = useNavigate();
  const { socket } = useSocket(); 
  const user = React.useMemo(() => {
    const stored = localStorage.getItem('user');
    return stored && stored !== "undefined" ? JSON.parse(stored) : {};
  }, []);
  const API_URL = process.env.REACT_APP_API_URL || 'http://localhost:4000';

  const fetchConversations = async () => {
    if (!user._id) return;
    try {
      const { data } = await axios.get(`${API_URL}/api/messages/conversations/${user._id}`);
      setConversations(data);
    } catch (err) { console.error(err); }
  };

  useEffect(() => {
    if (!user._id) return;
    fetchConversations(); 
    if (!socket) return;
    socket.on("updateInbox", fetchConversations);
    return () => {
      socket.off("updateInbox", fetchConversations);
    };
  }, [user._id, socket]);

  return (
    <div style={{ backgroundColor: '#fff', minHeight: '100vh' }}>
      
      <div className="py-3 px-3 shadow-sm d-flex align-items-center" style={{ backgroundColor: '#ffc107' }}>
        <button onClick={() => navigate('/')} className="btn btn-link text-dark p-0 me-3 text-decoration-none">
          <span style={{fontSize: '24px'}}>←</span>
        </button>
        <h5 className="fw-bold m-0 text-dark">Chat của tôi</h5>
      </div>

      <div className="container mt-2">
        {conversations.length === 0 ? (
          <div className="text-center py-5">
            <p className="text-muted">Chưa có cuộc hội thoại nào</p>
          </div>
        ) : (
          conversations.map((conv, idx) => (
            <div key={idx} className="d-flex align-items-center p-3 border-bottom" 
                 style={{ cursor: 'pointer' }}
                 onClick={() => navigate('/chat', { state: { receiver: conv.otherUser } })}>
              
              <div className="position-relative">
                <div className="rounded-circle bg-warning text-white d-flex align-items-center justify-content-center fw-bold" 
                     style={{ width: '50px', height: '50px', fontSize: '18px' }}>
                  {conv.otherUser.name?.charAt(0).toUpperCase()}
                </div>
                {conv.unreadCount > 0 && (
                  <span className="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-white">
                    {conv.unreadCount}
                  </span>
                )}
              </div>

              <div className="ms-3 flex-grow-1">
                <div className="d-flex justify-content-between align-items-center">
                  <h6 className="fw-bold mb-0 text-dark">{conv.otherUser.name}</h6>
                  <small className="text-muted" style={{fontSize: '11px'}}>
                    {new Date(conv.timestamp).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}
                  </small>
                </div>
                <div className="text-muted text-truncate" style={{ maxWidth: '250px', fontSize: '14px' }}>
                  {conv.lastMessage}
                </div>
              </div>
            </div>
          ))
        )}
      </div>
    </div>
  );
};

export default InboxPage;
</file>

<file path="frontend/src/pages/LoginPage.js">
import React, { useState } from 'react';
import { useNavigate, Link } from 'react-router-dom';
import axios from 'axios';
import { useToast } from '../components/Toast';


const LoginPage = () => {
  const toast = useToast();
  const navigate = useNavigate();
  const API_URL = process.env.REACT_APP_API_URL || 'http://localhost:4000';

  const [isForgotMode, setIsForgotMode] = useState(false);
  const [loginForm, setLoginForm] = useState({ email: '', password: '' });
  
  
  const [forgotEmail, setForgotEmail] = useState('');
  const [otpForm, setOtpForm] = useState({ otp: '', newPassword: '' });
  const [isOtpSent, setIsOtpSent] = useState(false);
  const [isLoading, setIsLoading] = useState(false);

  
  const [showLoginPass, setShowLoginPass] = useState(false);
  const [showForgotPass, setShowForgotPass] = useState(false);

  
  
  
  const handleLogin = async (e) => {
    e.preventDefault();
    try {
      const { data } = await axios.post(`${API_URL}/api/users/login`, loginForm);
      const { walletBalance, pendingBalance, walletPin, ...safeLocalUser } = data || {};
      localStorage.setItem('user', JSON.stringify(safeLocalUser));
      window.dispatchEvent(new Event('userUpdated'));
      navigate('/');
    } catch (error) {
      toast.error('Lỗi', "❌ " + (error.response?.data?.message || "Đăng nhập thất bại!"));
    }
  };

  
  
  
  const handleSendOtp = async (e) => {
    e.preventDefault();
    if (!forgotEmail) return toast.warning('Chú ý', 'Vui lòng nhập Email!');
    setIsLoading(true);
    
    try {
        // M4: Xóa EmailJS ở frontend, chỉ gọi API backend sinh & gửi OTP bảo mật
        const { data } = await axios.post(`${API_URL}/api/users/send-otp`, { 
            email: forgotEmail.trim()
        });
        
        toast.info('Thông báo', "📩 " + (data?.message || "Nếu email tồn tại trong hệ thống, mã xác thực OTP đã được gửi đến hộp thư của bạn!"));
        setIsOtpSent(true); 
    } catch (error) {
        console.error("LỖI GỬI OTP:", error);
        const detail = error.response?.data?.message || error.message;
        toast.error('Lỗi', "❌ " + (typeof detail === 'string' ? detail : "Vui lòng thử lại sau!"));
    }
    setIsLoading(false);
  };

  
  
  
  const handleResetPassword = async (e) => {
    e.preventDefault();
    if (otpForm.newPassword.length < 6) return toast.error('Lỗi', '❌ Mật khẩu mới phải có ít nhất 6 ký tự!');
    try {
      const { data } = await axios.post(`${API_URL}/api/users/reset-password-otp`, {
        email: forgotEmail,
        otp: otpForm.otp,
        newPassword: otpForm.newPassword
      });
      toast.success('Thành công', "✅ " + data.message);
      
      setIsForgotMode(false);
      setIsOtpSent(false);
      setForgotEmail('');
      setOtpForm({ otp: '', newPassword: '' });
    } catch (error) { 
        toast.error('Lỗi', "❌ " + (error.response?.data?.message || "Mã xác thực không chính xác!")); 
    }
  };

  return (
    <div className="d-flex justify-content-center align-items-center vh-100" style={{ backgroundColor: '#F8F9FA' }}>
      <div className="card shadow-lg border-0 rounded-4 overflow-hidden" style={{ width: '420px' }}>
        
        <div className="bg-warning p-4 text-center">
            <div 
                onClick={() => navigate('/')} 
                style={{cursor: 'pointer', transition: '0.3s'}}
                onMouseOver={(e) => e.currentTarget.style.opacity = '0.8'}
                onMouseOut={(e) => e.currentTarget.style.opacity = '1'}
                className="d-flex justify-content-center"
            >
                <img src="/logo.png" alt="HaiHand" style={{height: '32px', objectFit: 'contain'}} />
            </div>
            <p className="text-white-50 small m-0 mt-1 fw-bold" style={{letterSpacing: '1px'}}>
                {isForgotMode ? 'XÁC THỰC BẢO MẬT' : 'TRUY CẬP HỆ THỐNG'}
            </p>
        </div>

        <div className="card-body p-4 p-sm-5">
            {!isForgotMode ? (
                
                <form onSubmit={handleLogin}>
                    <div className="mb-3">
                        <label className="form-label fw-bold small text-muted">Địa chỉ Email</label>
                        <input type="email" className="form-control bg-light py-2 border-0" placeholder="user@gmail.com" required value={loginForm.email} onChange={e => setLoginForm({...loginForm, email: e.target.value})} />
                    </div>
                    <div className="mb-4">
