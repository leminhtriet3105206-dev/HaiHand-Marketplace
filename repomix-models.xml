<file path="backend/scripts/migrate-seller-flow.js">
#!/usr/bin/env node
/**
 * Migration Script: Normalize Seller Flow Data (Products/Posts & Variants)
 *
 * Usage:
 *   node backend/scripts/migrate-seller-flow.js --dry-run   (default: preview only, no writes)
 *   node backend/scripts/migrate-seller-flow.js --apply     (apply changes to MongoDB)
 *
 * What this script normalizes:
 * 1. Product/Post `status` in collection `posts`:
 *    - 'PENDING', 'Pending', 'Chờ duyệt' -> 'pending'
 *    - 'APPROVED'                        -> 'active'
 *    - 'SOLD'                            -> 'out_of_stock'
 *    - 'DELETED', 'REJECTED', 'Bị từ chối', 'Đã ẩn' -> 'inactive'
 * 2. Product/Post `variants` array items:
 *    - Ensures `stock` (Number, default 0), `sku` (String, default ''), and `options` (Array) exist.
 */

require('dotenv').config();
const mongoose = require('mongoose');
const { Post } = require('../models/Product');

const STATUS_MAP = {
  PENDING: 'pending',
  Pending: 'pending',
  'Chờ duyệt': 'pending',
  APPROVED: 'active',
  SOLD: 'out_of_stock',
  DELETED: 'inactive',
  REJECTED: 'inactive',
  'Bị từ chối': 'inactive',
  'Đã ẩn': 'inactive'
};

async function runMigration({ apply = false } = {}) {
  const uri = process.env.MONGO_URI || process.env.MONGODB_URI;
  if (!uri) {
    console.error('[migrate-seller-flow] Missing MONGO_URI / MONGODB_URI environment variable.');
    process.exitCode = 1;
    return;
  }

  console.log(`[migrate-seller-flow] Mode: ${apply ? 'APPLY (WRITING TO DB)' : 'DRY-RUN (READ ONLY)'}`);
  await mongoose.connect(uri);

  try {
    const legacyStatuses = Object.keys(STATUS_MAP);
    const statusCandidates = await Post.find({
      $or: [
        { status: { $in: legacyStatuses } },
        { 'variants.0': { $exists: true } }
      ]
    }).lean();

    let statusCount = 0;
    let variantCount = 0;
    const bulkOps = [];

    for (const doc of statusCandidates) {
      const updateSet = {};

      if (doc.status && STATUS_MAP[doc.status]) {
        updateSet.status = STATUS_MAP[doc.status];
        statusCount += 1;
      }

      if (Array.isArray(doc.variants) && doc.variants.length > 0) {
        let variantChanged = false;
        const normalizedVariants = doc.variants.map((v) => {
          if (!v || typeof v !== 'object') return v;
          const next = { ...v };
          if (next.stock === undefined || next.stock === null) {
            next.stock = 0;
            variantChanged = true;
          }
          if (next.sku === undefined || next.sku === null) {
            next.sku = '';
            variantChanged = true;
          }
          if (!Array.isArray(next.options)) {
            next.options = [];
            variantChanged = true;
          }
          return next;
        });

        if (variantChanged) {
          updateSet.variants = normalizedVariants;
          variantCount += 1;
        }
      }

      if (Object.keys(updateSet).length > 0) {
        bulkOps.push({
          updateOne: {
            filter: { _id: doc._id },
            update: { $set: updateSet }
          }
        });
      }
    }

    console.log(`[migrate-seller-flow] Scanned ${statusCandidates.length} documents.`);
    console.log(`[migrate-seller-flow] Documents needing status normalization: ${statusCount}`);
    console.log(`[migrate-seller-flow] Documents needing variants normalization: ${variantCount}`);
    console.log(`[migrate-seller-flow] Total bulk update operations prepared: ${bulkOps.length}`);

    if (apply && bulkOps.length > 0) {
      const result = await Post.bulkWrite(bulkOps, { ordered: false });
      console.log(`[migrate-seller-flow] Applied updates. Modified count: ${result.modifiedCount}`);
    } else if (!apply) {
      console.log('[migrate-seller-flow] Dry-run complete. Re-run with --apply to persist changes.');
    }
  } finally {
    await mongoose.disconnect();
  }
}

if (require.main === module) {
  const args = process.argv.slice(2);
  const shouldApply = args.includes('--apply') && !args.includes('--dry-run');
  runMigration({ apply: shouldApply }).catch((err) => {
    console.error('[migrate-seller-flow] Error:', err);
    process.exit(1);
  });
}

module.exports = { runMigration, STATUS_MAP };
</file>

<file path="backend/scripts/reconcile.js">
/**
 * Script đối soát tài chính & ví ký quỹ HaiPay (H12 - CHỈ ĐỌC / READ-ONLY):
 * - KHÔNG tự sửa dữ liệu trong DB.
 * - Kiểm tra 3 nhóm bất thường:
 *   1. Đơn hàng đang ở trạng thái `paymentStatus: 'escrow'` nhưng `PaymentSession` tương ứng chưa `status: 'paid'`.
 *   2. Tài khoản người dùng có `walletBalance < 0` hoặc `pendingBalance < 0`.
 *   3. Tài khoản người bán có `pendingBalance` lệch so với tổng `sellerReceive` của các đơn hàng đang `paymentStatus: 'escrow'`.
 *
 * Cách chạy:
 *   node backend/scripts/reconcile.js
 */
require('dotenv').config();
const mongoose = require('mongoose');
const User = require('../models/User');
const Order = require('../models/Order');
const PaymentSession = require('../models/PaymentSession');
const { orderSellerId, calculateOrderSplit, fetchPlatformFeePercent } = require('../utils/b2c');

async function runReconciliation({ closeConnection = false } = {}) {
  const report = {
    checkedAt: new Date().toISOString(),
    escrowOrdersWithoutPaidSession: [],
    negativeBalanceUsers: [],
    pendingBalanceMismatches: []
  };

  if (mongoose.connection.readyState !== 1) {
    const uri = process.env.MONGO_URI || process.env.MONGODB_URI;
    if (!uri) {
      throw new Error('Thiếu biến môi trường MONGO_URI để chạy đối soát!');
    }
    await mongoose.connect(uri);
  }

  const feePercent = await fetchPlatformFeePercent();

  // 1. Đơn hàng escrow nhưng PaymentSession chưa paid
  const escrowOrders = await Order.find({
    $or: [
      { paymentStatus: 'escrow' },
      { status: 'Đã thanh toán (Admin giữ tiền)' }
    ]
  }).lean();

  const parentIds = [...new Set(escrowOrders.map((o) => o.parentOrderId).filter(Boolean))];
  const sessions = parentIds.length > 0
    ? await PaymentSession.find({ parentOrderId: { $in: parentIds } }).lean()
    : [];
  const sessionMap = new Map(sessions.map((s) => [s.parentOrderId, s]));

  const expectedPendingBySeller = {};

  for (const order of escrowOrders) {
    const pId = order.parentOrderId;
    const sess = pId ? sessionMap.get(pId) : null;
    if (order.paymentMethod !== 'COD' && (!sess || sess.status !== 'paid')) {
      report.escrowOrdersWithoutPaidSession.push({
        orderId: String(order._id),
        parentOrderId: pId || null,
        paymentMethod: order.paymentMethod,
        orderPaymentStatus: order.paymentStatus,
        sessionStatus: sess ? sess.status : 'MISSING_SESSION',
        totalPrice: order.totalPrice || 0
      });
    }

    const sId = orderSellerId(order);
    if (sId) {
      const { sellerReceive } = calculateOrderSplit(order, feePercent);
      expectedPendingBySeller[sId] = (expectedPendingBySeller[sId] || 0) + sellerReceive;
    }
  }

  // 2. Ví âm (walletBalance < 0 hoặc pendingBalance < 0)
  const negativeUsers = await User.find({
    $or: [
      { walletBalance: { $lt: 0 } },
      { pendingBalance: { $lt: 0 } }
    ]
  })
    .select('_id name email walletBalance pendingBalance')
    .lean();

  for (const u of negativeUsers) {
    report.negativeBalanceUsers.push({
      userId: String(u._id),
      email: u.email,
      walletBalance: u.walletBalance || 0,
      pendingBalance: u.pendingBalance || 0
    });
  }

  // 3. Đối chiếu pendingBalance của Seller với tổng sellerReceive của các đơn đang escrow
  const sellersWithPending = await User.find({
    $or: [
      { pendingBalance: { $gt: 0 } },
      { _id: { $in: Object.keys(expectedPendingBySeller).filter((id) => mongoose.Types.ObjectId.isValid(id)) } }
    ]
  })
    .select('_id name email pendingBalance')
    .lean();

  for (const seller of sellersWithPending) {
    const sId = String(seller._id);
    const actualPending = Math.round(Number(seller.pendingBalance) || 0);
    const expectedPending = Math.round(Number(expectedPendingBySeller[sId]) || 0);
    if (actualPending !== expectedPending) {
      report.pendingBalanceMismatches.push({
        sellerId: sId,
        email: seller.email,
        actualPendingBalance: actualPending,
        expectedPendingFromEscrowOrders: expectedPending,
        diff: actualPending - expectedPending
      });
    }
  }

  if (closeConnection && mongoose.connection.readyState === 1) {
    await mongoose.disconnect();
  }

  return report;
}

if (require.main === module) {
  runReconciliation({ closeConnection: true })
    .then((report) => {
      console.log('=== BÁO CÁO ĐỐI SOÁT VÍ & ESCROW HAIHAND (READ-ONLY) ===');
      console.log(JSON.stringify(report, null, 2));
      const totalIssues =
        report.escrowOrdersWithoutPaidSession.length +
        report.negativeBalanceUsers.length +
        report.pendingBalanceMismatches.length;
      console.log(`Tổng số mục lệch phát hiện: ${totalIssues}`);
      process.exit(0);
    })
    .catch((err) => {
      console.error('Lỗi khi chạy đối soát:', err.message);
      process.exit(1);
    });
}

module.exports = { runReconciliation };
</file>

