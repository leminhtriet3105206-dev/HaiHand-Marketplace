                                className={`py-3 rounded-xl font-bold text-sm border-2 transition-all ${depositAmount === amount.toString() ? 'border-[#EA580C] bg-orange-50 text-[#EA580C]' : 'border-stone-200 text-stone-600 hover:border-[#FACC15]'}`}
