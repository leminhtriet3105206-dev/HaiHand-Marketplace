<!-- SELLER APPLICATIONS VIEW (Inner Content Only for AdminLayout Outlet) -->
<div class="space-y-6">
    
    <!-- Title & Stats -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2.5">
                <h2 class="text-2xl lg:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
                    🏪 Duyệt Đăng Ký Shop B2C
                </h2>
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-100 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 border border-amber-200/60 dark:border-amber-800">
                    <%= typeof applications !== 'undefined' ? applications.length : 0 %> Hồ sơ
                </span>
            </div>
            <p class="text-slate-500 dark:text-slate-400 text-xs mt-1 font-medium">
                Kiểm định hồ sơ pháp lý và thông tin cửa hàng của người bán trước khi cấp quyền bán hàng B2C.
            </p>
        </div>
    </div>

    <!-- Applications Table Card -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl shadow-sm border border-slate-200/80 dark:border-slate-800 overflow-hidden transition-colors duration-200">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200/80 dark:border-slate-800 text-slate-500 dark:text-slate-400 font-bold uppercase text-[11px] tracking-wider">
                        <th class="p-4 px-6">Người dùng</th>
                        <th class="p-4 px-6">Thông tin Shop</th>
                        <th class="p-4 px-6 text-center">Trạng thái</th>
                        <th class="p-4 px-6">Ngày gửi</th>
                        <th class="p-4 px-6 text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 text-xs">
                    <% if (!applications || applications.length === 0) { %>
                    <tr><td colspan="5" class="p-12 text-center text-slate-400 dark:text-slate-500 italic">Chưa có hồ sơ đăng ký mở shop nào cần duyệt.</td></tr>
                    <% } %>
                    <% (applications || []).forEach(function(user) { %>
                    <tr class="hover:bg-purple-50/40 dark:hover:bg-slate-800/50 transition-colors">
                        <td class="p-4 px-6">
                            <p class="font-bold text-slate-800 dark:text-slate-100 text-sm"><%= user.name %></p>
                            <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5"><%= user.email %></p>
                        </td>
                        <td class="p-4 px-6">
                            <p class="font-bold text-purple-700 dark:text-purple-300 text-sm"><%= user.shopInfo && user.shopInfo.shopName ? user.shopInfo.shopName : '—' %></p>
                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5"><%= user.shopInfo && user.shopInfo.address ? user.shopInfo.address : 'Chưa nhập địa chỉ' %></p>
                        </td>
                        <td class="p-4 px-6 text-center">
                            <span class="text-[10px] font-bold px-2.5 py-1 rounded-full uppercase border <%= user.sellerStatus === 'pending' ? 'bg-amber-100 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 border-amber-200 dark:border-amber-800' : user.sellerStatus === 'approved' ? 'bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800' : 'bg-rose-100 dark:bg-rose-950/60 text-rose-700 dark:text-rose-300 border-rose-200 dark:border-rose-800' %>">
                                <%= user.sellerStatus === 'pending' ? 'Chờ duyệt' : user.sellerStatus === 'approved' ? 'Đã duyệt' : 'Từ chối' %>
                            </span>
                        </td>
                        <td class="p-4 px-6 text-slate-500 dark:text-slate-400 font-mono text-[11px]">
                            <%= user.sellerAppliedAt ? new Date(user.sellerAppliedAt).toLocaleString('vi-VN') : '—' %>
                        </td>
                        <td class="p-4 px-6 text-right space-x-1.5 whitespace-nowrap">
                            <% if (user.sellerStatus === 'pending') { %>
                            <form method="POST" action="/admin/approve-seller/<%= user._id %>" class="inline">
                                <button class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold px-3.5 py-1.5 rounded-xl shadow-sm transition">
                                    Duyệt
                                </button>
                            </form>
                            <form method="POST" action="/admin/reject-seller/<%= user._id %>" class="inline">
                                <button class="bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold px-3.5 py-1.5 rounded-xl shadow-sm transition">
                                    Từ chối
                                </button>
                            </form>
                            <% } else { %>
                                <span class="text-xs text-slate-400 dark:text-slate-500 font-medium italic">Đã xử lý</span>
                            <% } %>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

</div>
