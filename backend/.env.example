PORT=4000
NODE_ENV=development

# Required: create your own MongoDB connection string.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
FRONTEND_URL=http://localhost:3000
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Used by `npm start`. Docker Compose ships equivalent container-safe defaults.
LM_STUDIO_URL=http://localhost:1235/v1
# Optional override used only by Docker Compose.
LM_STUDIO_DOCKER_URL=http://host.docker.internal:1235/v1
AI_MODEL=qwen3-vl-4b-instruct
EMBEDDING_MODEL=text-embedding-bge-m3
VECTOR_INDEX_NAME=product_vector_index
IMAGE_VECTOR_INDEX_NAME=product_image_vector_index
IMAGE_EMBEDDING_MODEL=Xenova/siglip-base-patch16-224
IMAGE_EMBEDDING_DTYPE=q8
SIGLIP_CACHE_DIR=.cache/huggingface
RAG_INDEX_IMAGES=true

# Optional payment configuration.
VNP_TMNCODE=
VNP_HASHSECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURNURL=http://localhost:4000/vnpay_return
