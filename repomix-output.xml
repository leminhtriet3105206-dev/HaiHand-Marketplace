const crypto = require('crypto');
const bcrypt = require('bcryptjs');
const nodemailer = require('nodemailer');
const OtpToken = require('../models/OtpToken');

// Configure nodemailer transporter
const createTransporter = () => {
  const host = process.env.SMTP_HOST;
  const user = process.env.SMTP_USER;
  const pass = process.env.SMTP_PASS;

  if (host && user && pass) {
    return nodemailer.createTransport({
      host,
      port: Number(process.env.SMTP_PORT) || 587,
      secure: process.env.SMTP_SECURE === 'true',
      auth: { user, pass }
    });
  }

  // Fallback transporter (e.g. Gmail or simulated)
  if (process.env.EMAIL_USER && process.env.EMAIL_PASS) {
    return nodemailer.createTransport({
      service: 'gmail',
      auth: {
        user: process.env.EMAIL_USER,
        pass: process.env.EMAIL_PASS
      }
    });
  }

  return null;
};

const transporter = createTransporter();

/**
 * Generate 6-digit numeric OTP
 */
function generateNumericOtp(length = 6) {
  const min = Math.pow(10, length - 1);
  const max = Math.pow(10, length) - 1;
  return crypto.randomInt(min, max + 1).toString();
}

/**
 * Send OTP via Email / SMS simulation
 */
async function sendOtpEmail({ email, otp, purpose = 'LOGIN' }) {
  const purposeText = purpose === 'REGISTER' 
    ? 'Kích hoạt tài khoản Ví HaiPay' 
    : purpose === 'RESET_PASSWORD'
      ? 'Đặt lại mật khẩu tài khoản'
      : 'Đăng nhập vào Ví HaiPay';

  const htmlContent = `
    <div style="font-family: Arial, sans-serif; max-width: 520px; margin: 0 auto; padding: 24px; border: 1px solid #e2e8f0; border-radius: 16px; background-color: #ffffff;">
      <div style="text-align: center; margin-bottom: 20px;">
        <div style="display: inline-block; background-color: #0f172a; color: #facc15; font-weight: bold; font-size: 20px; padding: 10px 20px; border-radius: 9999px;">
          🛡️ HaiPay Wallet
        </div>
      </div>
      <h2 style="color: #0f172a; text-align: center; margin-bottom: 8px;">Mã xác thực OTP</h2>
      <p style="color: #64748b; font-size: 14px; text-align: center; margin-top: 0;">
        Yêu cầu: <strong>${purposeText}</strong>
      </p>
      
      <div style="background-color: #f8fafc; border: 2px dashed #cbd5e1; border-radius: 12px; padding: 20px; text-align: center; margin: 24px 0;">
        <span style="font-size: 36px; font-weight: 800; letter-spacing: 10px; color: #0284c7; font-family: monospace;">
          ${otp}
        </span>
      </div>

      <p style="color: #475569; font-size: 13px; line-height: 1.6;">
        ⏱️ Mã này có hiệu lực trong <strong>5 phút</strong>.<br>
        🔒 <strong>Bảo mật:</strong> Tuyệt đối không chia sẻ mã này cho bất kỳ ai, kể cả nhân viên HaiHand/HaiPay.
      </p>
      <hr style="border: none; border-top: 1px solid #f1f5f9; margin: 24px 0;">
      <p style="color: #94a3b8; font-size: 11px; text-align: center;">
        Nếu bạn không thực hiện yêu cầu này, vui lòng bỏ qua email hoặc liên hệ tổng đài 1900-6868.
      </p>
    </div>
  `;

  // Log to console ONLY in non-production environments (M4)
  if (process.env.NODE_ENV !== 'production') {
    console.log('\n==============================================');
    console.log(`🔑 [HaiPay OTP Service] Code for ${email}: ${otp}`);
    console.log(`📌 Purpose: ${purpose} | Expires in: 10 minutes`);
    console.log('==============================================\n');
  }

  if (transporter && email.includes('@')) {
    try {
      await transporter.sendMail({
        from: `"HaiPay Security" <${process.env.SMTP_USER || process.env.EMAIL_USER || 'no-reply@haihand.vn'}>`,
        to: email,
        subject: `[HaiPay] ${otp} là mã xác thực OTP của bạn`,
        html: htmlContent
      });
      return { sent: true };
    } catch (err) {
      console.warn('⚠️ SMTP sendMail warning (logged to console instead):', err.message);
      return { sent: false, error: err.message };
    }
  }

  return { sent: false, note: 'Logged to console' };
}

/**
 * Generate, hash, and persist OTP in database with 60s cooldown rate-limiting
 */
async function createAndSaveOtp(identifier, purpose = 'LOGIN') {
  const cleanIdentifier = identifier.trim().toLowerCase();
  
  // Rate Limiting Cooldown: Enforce minimum 60 seconds between OTP generation requests per identifier
  const existingRecent = await OtpToken.findOne({
    identifier: cleanIdentifier,
    purpose,
    createdAt: { $gt: new Date(Date.now() - 60 * 1000) }
  });

  if (existingRecent) {
    const remainingSec = Math.max(1, Math.ceil((existingRecent.createdAt.getTime() + 60000 - Date.now()) / 1000));
    const err = new Error(`Vui lòng đợi ${remainingSec} giây trước khi yêu cầu mã OTP mới`);
    err.statusCode = 429;
    throw err;
  }

  // Clear any existing expired OTP for this identifier and purpose
  await OtpToken.deleteMany({ identifier: cleanIdentifier, purpose });

  const rawOtp = generateNumericOtp(6);
  const otpHash = await bcrypt.hash(rawOtp, 10);

  await OtpToken.create({
    identifier: cleanIdentifier,
    otpHash,
    purpose,
    attempts: 0,
    createdAt: new Date()
  });

  // Dispatch email/message
  await sendOtpEmail({ email: cleanIdentifier, otp: rawOtp, purpose });

  return rawOtp;
}

/**
 * Verify OTP against stored hash with atomic attempt tracking
 */
async function verifyOtp(identifier, rawOtp, purpose = 'LOGIN') {
  const cleanIdentifier = identifier.trim().toLowerCase();
  
  // 1. Atomic attempt increment with boundary condition { attempts: { $lt: 5 } }
  // Prevents concurrency race conditions from brute-forcing OTPs
  const tokenRecord = await OtpToken.findOneAndUpdate(
    { identifier: cleanIdentifier, purpose, attempts: { $lt: 5 } },
    { $inc: { attempts: 1 } },
    { new: true }
  );

  if (!tokenRecord) {
    const existing = await OtpToken.findOne({ identifier: cleanIdentifier, purpose });
    if (existing && existing.attempts >= 5) {
      await OtpToken.deleteOne({ _id: existing._id });
      return { valid: false, message: 'Bạn đã nhập sai quá 5 lần quy định. Mã OTP đã bị hủy. Vui lòng lấy mã mới!' };
    }
    return { valid: false, message: 'Mã OTP đã hết hạn hoặc không tồn tại. Vui lòng lấy mã mới!' };
  }

  // Kiểm tra hết hạn 10 phút (600 giây - C8) ngay trong ứng dụng phòng khi MongoDB TTL index chưa quét
  const OTP_TTL_MS = 10 * 60 * 1000;
  if (tokenRecord.createdAt && Date.now() - new Date(tokenRecord.createdAt).getTime() > OTP_TTL_MS) {
    await OtpToken.deleteOne({ _id: tokenRecord._id });
    return { valid: false, message: 'Mã OTP đã hết hạn (quá 10 phút). Vui lòng lấy mã mới!' };
  }

  const isMatch = await bcrypt.compare(String(rawOtp).trim(), tokenRecord.otpHash);
  if (!isMatch) {
    const remaining = 5 - tokenRecord.attempts;
    if (remaining <= 0) {
      await OtpToken.deleteOne({ _id: tokenRecord._id });
      return { valid: false, message: 'Bạn đã nhập sai quá 5 lần. Mã OTP đã bị hủy!' };
    }
    return { valid: false, message: `Mã OTP không chính xác. Bạn còn ${remaining} lần thử!` };
  }

  // Consume OTP upon successful verification
  await OtpToken.deleteOne({ _id: tokenRecord._id });
  return { valid: true };
}

module.exports = {
  generateNumericOtp,
  sendOtpEmail,
  createAndSaveOtp,
  verifyOtp
};
</file>

<file path="backend/utils/password.js">
const crypto = require('crypto');
const bcrypt = require('bcryptjs');

const BCRYPT_COST = 10;
const BCRYPT_PREFIX_REGEX = /^\$2[aby]\$\d{2}\$/;

/**
 * Băm mật khẩu bằng bcrypt với cost >= 10 (C3, C4)
 */
async function hashPassword(plainPassword, cost = BCRYPT_COST) {
  if (typeof plainPassword !== 'string' || plainPassword.length === 0) {
    throw new Error('Mật khẩu phải là chuỗi ký tự không rỗng');
  }
  const safeCost = Math.max(10, Number(cost) || BCRYPT_COST);
  return bcrypt.hash(plainPassword, safeCost);
}

/**
 * So sánh hằng-thời-gian (constant-time) hai chuỗi để chống timing attack
 */
function timingSafeStringEqual(a, b) {
  if (typeof a !== 'string' || typeof b !== 'string') return false;
  const bufA = Buffer.from(a, 'utf-8');
  const bufB = Buffer.from(b, 'utf-8');
  if (bufA.length !== bufB.length) {
    // So sánh giả với chính bufA để giữ thời gian đồng đều trước khi trả về false
    crypto.timingSafeEqual(bufA, bufA);
    return false;
  }
  return crypto.timingSafeEqual(bufA, bufB);
}

/**
 * Kiểm tra mật khẩu (C3, C4):
 * - Hỗ trợ truyền vào `(userDoc, inputPassword)` hoặc `(storedPasswordString, inputPassword, userDoc)`.
 * - Nếu mật khẩu lưu trong DB đã có tiền tố `$2a$/$2b$/$2y$` -> dùng `bcrypt.compare`.
 * - Nếu mật khẩu lưu trong DB là chuỗi thô cũ (legacy plaintext) -> so sánh hằng-thời-gian (`timingSafeEqual`);
 *   nếu khớp thì **băm lại ngay bằng bcrypt (cost >= 10) và lưu vào DB** (lazy migration) để từ lần sau DB đã là bcrypt.
 */
async function verifyPassword(storedOrUser, input, optionalUserDoc = null) {
  if (typeof input !== 'string' || input.length === 0) {
    return false;
  }

  let userDoc = optionalUserDoc;
  let stored = storedOrUser;

  if (storedOrUser && typeof storedOrUser === 'object') {
    userDoc = storedOrUser;
    stored = storedOrUser.password;
  }

  if (typeof stored !== 'string' || stored.length === 0) {
    return false;
  }

  if (BCRYPT_PREFIX_REGEX.test(stored)) {
    return bcrypt.compare(input, stored);
  }

  // Legacy plaintext comparison (constant-time)
  const isMatch = timingSafeStringEqual(stored, input);
  if (!isMatch) {
    return false;
  }

  // Lazy migration: băm lại bằng bcrypt cost >= 10 và lưu ngay nếu có userDoc
  if (userDoc && typeof userDoc === 'object') {
    try {
      const upgradedHash = await hashPassword(input, BCRYPT_COST);
      userDoc.password = upgradedHash;
      if (typeof userDoc.save === 'function') {
        await userDoc.save();
      }
    } catch (upgradeErr) {
      console.warn('Lazy password migration warning:', upgradeErr.message);
    }
  }

  return true;
}

const PIN_MAX_ATTEMPTS = 5;
const PIN_LOCK_DURATION_MS = 15 * 60 * 1000; // 15 phút

/**
 * Kiểm tra mã PIN Ví HaiPay của User (H8):
 * - Băm / so sánh bằng `bcrypt.compare` (cost >= 10), hỗ trợ lazy migration nếu dữ liệu cũ lưu thô.
 * - Khóa 15 phút (`user.pinLockedUntil`) sau 5 lần nhập sai liên tiếp (`user.pinFailedAttempts`).
 */
async function verifyUserWalletPin(userDoc, inputPin) {
  if (!userDoc || typeof userDoc !== 'object') {
    return { ok: false, statusCode: 400, message: 'Không tìm thấy thông tin người dùng!' };
  }

  const now = new Date();
  if (userDoc.pinLockedUntil && new Date(userDoc.pinLockedUntil) > now) {
    const remainingMin = Math.max(1, Math.ceil((new Date(userDoc.pinLockedUntil).getTime() - now.getTime()) / 60000));
    return {
      ok: false,
      locked: true,
      statusCode: 423,
      message: `Mã PIN Ví HaiPay đang bị tạm khóa do nhập sai quá 5 lần. Vui lòng thử lại sau ${remainingMin} phút!`
    };
  }

  if (!userDoc.walletPin || typeof userDoc.walletPin !== 'string' || !userDoc.walletPin.trim()) {
    return {
      ok: false,
      noPin: true,
      statusCode: 400,
      message: 'Bạn chưa thiết lập mã PIN Ví HaiPay. Vui lòng thiết lập mã PIN 6 chữ số trong mục Ví HaiPay trước khi giao dịch!'
    };
  }

  if (typeof inputPin !== 'string' || !/^\d{6}$/.test(inputPin.trim())) {
    return {
      ok: false,
      statusCode: 400,
      message: 'Vui lòng nhập mã PIN Ví HaiPay hợp lệ (6 chữ số) để xác nhận giao dịch!'
    };
  }

  const cleanPin = inputPin.trim();
  const storedPin = userDoc.walletPin;
  let isMatch = false;

  if (BCRYPT_PREFIX_REGEX.test(storedPin)) {
    isMatch = await bcrypt.compare(cleanPin, storedPin);
  } else {
    isMatch = timingSafeStringEqual(storedPin, cleanPin);
    if (isMatch) {
      userDoc.walletPin = await hashPassword(cleanPin, BCRYPT_COST);
    }
  }

  if (!isMatch) {
    const attempts = (Number(userDoc.pinFailedAttempts) || 0) + 1;
    userDoc.pinFailedAttempts = attempts;
    let lockMsg = `Mã PIN Ví HaiPay không chính xác! (Còn ${Math.max(0, PIN_MAX_ATTEMPTS - attempts)} lần thử)`;
    let statusCode = 400;

    if (attempts >= PIN_MAX_ATTEMPTS) {
      userDoc.pinLockedUntil = new Date(Date.now() + PIN_LOCK_DURATION_MS);
      lockMsg = 'Bạn đã nhập sai mã PIN Ví HaiPay quá 5 lần. Mã PIN đã bị tạm khóa trong 15 phút!';
      statusCode = 423;
    }

    if (typeof userDoc.save === 'function') {
      try {
        await userDoc.save();
      } catch (saveErr) {
        console.warn('Save pinFailedAttempts warning:', saveErr.message);
      }
    }

    return {
      ok: false,
      locked: attempts >= PIN_MAX_ATTEMPTS,
      attempts,
      statusCode,
      message: lockMsg
    };
  }

  // Khớp mã PIN -> reset bộ đếm lỗi
  if ((userDoc.pinFailedAttempts && userDoc.pinFailedAttempts > 0) || userDoc.pinLockedUntil) {
    userDoc.pinFailedAttempts = 0;
    userDoc.pinLockedUntil = null;
    if (typeof userDoc.save === 'function') {
      try {
        await userDoc.save();
      } catch (saveErr) {}
    }
  } else if (!BCRYPT_PREFIX_REGEX.test(storedPin) && typeof userDoc.save === 'function') {
    try {
      await userDoc.save();
    } catch (saveErr) {}
  }

  return { ok: true, statusCode: 200 };
}

module.exports = {
  BCRYPT_COST,
  BCRYPT_PREFIX_REGEX,
  PIN_MAX_ATTEMPTS,
  PIN_LOCK_DURATION_MS,
  hashPassword,
  verifyPassword,
  verifyUserWalletPin,
  timingSafeStringEqual
};
</file>

<file path="backend/utils/vnpay.js">
const crypto = require('crypto');
const moment = require('moment');
const querystring = require('qs');

const { ensureTestEnvDefaults } = require('../config/env');

if (process.env.NODE_ENV === 'test') {
  ensureTestEnvDefaults(process.env);
}

function getVnpTmnCode() {
  return process.env.VNPAY_TMN_CODE || process.env.VNP_TMNCODE || '';
}

function getVnpHashSecret() {
  return process.env.VNPAY_HASH_SECRET || process.env.VNP_HASHSECRET || '';
}

function getVnpUrl() {
  return process.env.VNPAY_URL || process.env.VNP_URL || 'https://sandbox.vnpayment.vn/paymentv2/vpcpay.html';
}

function getVnpReturnUrl() {
  return process.env.VNPAY_RETURN_URL || process.env.VNP_RETURNURL || 'http://localhost:3000/haipay/return';
}

const vnp_TmnCode = getVnpTmnCode();
const vnp_HashSecret = getVnpHashSecret();
const vnp_Url = getVnpUrl();
const vnp_ReturnUrl = getVnpReturnUrl();

function sortObject(obj) {
  const sorted = {};
  const keys = [];
  for (const key in obj) {
    if (Object.prototype.hasOwnProperty.call(obj, key)) keys.push(encodeURIComponent(key));
  }
  keys.sort();
  for (const k of keys) {
    sorted[k] = encodeURIComponent(obj[k]).replace(/%20/g, '+');
  }
  return sorted;
}

function signParams(params) {
  const secret = getVnpHashSecret();
  if (!secret) {
    throw new Error('Missing VNPAY_HASH_SECRET in environment variables');
  }
  const signData = querystring.stringify(sortObject(params), { encode: false });
  return crypto.createHmac('sha512', secret).update(Buffer.from(signData, 'utf-8')).digest('hex');
}

const { timingSafeStringEqual } = require('./password');

/**
 * Strict verification (C5):
 * - Xóa hoàn toàn bản legacy trả true khi không có chữ ký.
 * - Thiếu hoặc sai `vnp_SecureHash` -> trả về `false`.
 * - So sánh hằng-thời-gian (`timingSafeStringEqual`) để chống timing attack.
 */
function verifyVnpayChecksumStrict(params, secureHash) {
  const hashToVerify = secureHash || (params && params.vnp_SecureHash);
  if (!hashToVerify || typeof hashToVerify !== 'string' || !params || typeof params !== 'object') {
    return false;
  }
  const p = { ...params };
  delete p.vnp_SecureHash;
  delete p.vnp_SecureHashType;
  let expected;
  try {
    expected = signParams(p);
  } catch (e) {
    return false;
  }
  return timingSafeStringEqual(hashToVerify.toLowerCase(), expected.toLowerCase());
}

const verifyVnpayChecksum = verifyVnpayChecksumStrict;

function buildVnpayPaymentUrl({ orderId, amount, ipAddr = '127.0.0.1', orderInfo, returnUrl, orderType = 'other' }) {
  const tmn = getVnpTmnCode();
  if (!tmn) {
    throw new Error('Missing VNPAY_TMN_CODE in environment variables');
  }
  const params = {
    vnp_Version: '2.1.0',
    vnp_Command: 'pay',
    vnp_TmnCode: tmn,
    vnp_Locale: 'vn',
    vnp_CurrCode: 'VND',
    vnp_TxnRef: orderId.toString(),
    vnp_OrderInfo: orderInfo || ('Thanh toan don hang HaiHand ' + orderId),
    vnp_OrderType: orderType,
    vnp_Amount: Math.round(Number(amount) * 100),
    vnp_ReturnUrl: returnUrl || getVnpReturnUrl(),
    vnp_IpAddr: ipAddr,
    vnp_CreateDate: moment(new Date()).format('YYYYMMDDHHmmss')
  };
  const sorted = sortObject(params);
  sorted.vnp_SecureHash = signParams(params);
  return getVnpUrl() + '?' + querystring.stringify(sorted, { encode: false });
}

function normalizeIp(req) {
  let ip = req.headers['x-forwarded-for'] || req.socket?.remoteAddress || '127.0.0.1';
  ip = ip.toString().split(',')[0].trim();
  if (ip.startsWith('::ffff:')) ip = ip.slice(7);
  if (ip === '::1') ip = '127.0.0.1';
  return ip;
}

module.exports = {
  vnp_TmnCode,
  vnp_HashSecret,
  vnp_Url,
  vnp_ReturnUrl,
  getVnpTmnCode,
  getVnpHashSecret,
  getVnpUrl,
  getVnpReturnUrl,
  sortObject,
  signParams,
  verifyVnpayChecksum,
  verifyVnpayChecksumStrict,
  buildVnpayPaymentUrl,
  normalizeIp
};
</file>

