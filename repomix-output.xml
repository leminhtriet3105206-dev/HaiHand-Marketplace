                className="w-full sm:w-auto px-8 py-3.5 bg-[#FACC15] hover:bg-yellow-400 text-stone-900 font-bold rounded-xl transition shadow-md"
              >
                Tiếp tục mua hàng
              </button>
            </div>
          </div>
        </main>
        <AppFooter />
      </div>
    );
