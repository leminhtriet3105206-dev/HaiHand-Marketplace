                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

</div>

<script>
    async function approveWithdraw(id) {
        if (confirm('⚠️ XÁC NHẬN NGHIỆP VỤ:\nBạn ĐÃ DÙNG APP NGÂN HÀNG để chuyển tiền mặt cho khách hàng này chưa?\n\nHành động này không thể hoàn tác!')) {
            try {
                const res = await fetch(`/admin/withdrawals/approve/${id}`, {
                    method: 'POST',
                    headers: { 'Accept': 'application/json' }
                });
                const data = await res.json().catch(() => ({}));
                if (res.ok) {
                    alert('🎉 ' + (data.message || 'Đã xác nhận giải ngân thành công!'));
                    if (typeof window.spaNavigate === 'function') {
                        window.spaNavigate('/admin/withdrawals');
                    } else {
                        window.location.reload();
                    }
                } else {
                    alert('❌ ' + (data.message || 'Có lỗi xảy ra, vui lòng thử lại!'));
                }
            } catch (err) {
                alert('❌ Mất kết nối tới máy chủ!');
            }
        }
    }

    async function rejectWithdraw(id) {
        const reason = prompt('Nhập lý do từ chối lệnh rút tiền (Số tiền sẽ tự động hoàn lại vào Ví HaiPay của người dùng):', 'Thông tin số tài khoản ngân hàng không hợp lệ');
        if (reason === null) return;
        try {
            const res = await fetch(`/admin/withdrawals/reject/${id}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({ reason })
            });
            const data = await res.json().catch(() => ({}));
            if (res.ok) {
                alert('↩️ ' + (data.message || 'Đã từ chối lệnh rút và hoàn tiền về Ví HaiPay thành công!'));
                if (typeof window.spaNavigate === 'function') {
                    window.spaNavigate('/admin/withdrawals');
                } else {
                    window.location.reload();
                }
            } else {
                alert('❌ ' + (data.message || 'Không thể từ chối lệnh rút tiền này!'));
            }
        } catch (err) {
            alert('❌ Mất kết nối tới máy chủ!');
        }
    }
</script>
