<file path="admin/views/users.ejs">
<!-- USER MANAGEMENT VIEW (Inner Content Only for AdminLayout Outlet) -->
<div class="space-y-6">
    
    <!-- Top Action Bar & Title -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
