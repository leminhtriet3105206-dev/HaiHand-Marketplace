<!-- EDIT POST VIEW (Inner Content Only for AdminLayout Outlet) -->
<div class="space-y-6 max-w-4xl mx-auto">
    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>
    <style>.ck-editor__editable { min-height: 200px; color: #1e293b; }</style>

    <!-- Title & Back Link -->
    <div class="flex items-center justify-between">
        <div>
            <div class="flex items-center gap-2.5">
                <h2 class="text-2xl lg:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
                    ✏️ Chỉnh Sửa Tin Đăng
                </h2>
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-purple-100 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 border border-purple-200/60 dark:border-purple-800">
                    #<%= post._id.toString().slice(-6).toUpperCase() %>
                </span>
            </div>
            <p class="text-slate-500 dark:text-slate-400 text-xs mt-1 font-medium">
                Cập nhật thông tin chi tiết bài đăng hoặc sản phẩm.
            </p>
        </div>
        <a href="/posts" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:text-purple-600 dark:hover:text-purple-400 hover:bg-purple-50 dark:hover:bg-slate-700/80 transition text-xs font-bold">
            <i class="fas fa-arrow-left text-[10px]"></i>
            <span>Quay lại</span>
        </a>
    </div>

    <!-- Edit Form Card -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl shadow-sm border border-slate-200/80 dark:border-slate-800 p-8 transition-colors duration-200">
        <form action="/post/update/<%= post._id %>" method="POST" enctype="multipart/form-data" class="space-y-6">
            
            <div>
                <label class="block text-slate-700 dark:text-slate-300 text-xs font-bold mb-1.5">Tiêu đề tin đăng <span class="text-rose-500">*</span></label>
                <input 
                    type="text" 
                    name="title" 
                    value="<%= post.title || post.name %>" 
                    class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 text-slate-800 dark:text-slate-100 text-xs rounded-2xl border border-slate-200 dark:border-slate-700 focus:border-purple-400 dark:focus:border-purple-500 focus:ring-4 focus:ring-purple-500/15 outline-none transition" 
                    required
                />
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-slate-700 dark:text-slate-300 text-xs font-bold mb-1.5">Giá đề xuất (VNĐ) <span class="text-rose-500">*</span></label>
                    <input 
                        type="number" 
                        name="price" 
                        value="<%= post.price %>" 
                        class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 text-slate-800 dark:text-slate-100 text-xs rounded-2xl border border-slate-200 dark:border-slate-700 focus:border-purple-400 dark:focus:border-purple-500 focus:ring-4 focus:ring-purple-500/15 outline-none transition" 
                        required
                    />
                </div>
                <div>
                    <label class="block text-slate-700 dark:text-slate-300 text-xs font-bold mb-1.5">Danh mục</label>
                    <input 
                        type="text" 
                        name="category" 
                        value="<%= post.category || 'Khác' %>" 
                        class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 text-slate-800 dark:text-slate-100 text-xs rounded-2xl border border-slate-200 dark:border-slate-700 focus:border-purple-400 dark:focus:border-purple-500 focus:ring-4 focus:ring-purple-500/15 outline-none transition" 
                    />
                </div>
            </div>

            <div>
                <label class="block text-slate-700 dark:text-slate-300 text-xs font-bold mb-1.5">Mô tả sản phẩm</label>
                <textarea id="editor" name="description"><%= post.description || '' %></textarea>
            </div>

            <div class="flex justify-end gap-3 pt-4">
                <a href="/posts" class="px-5 py-2.5 rounded-2xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-bold text-xs transition">
                    Hủy bỏ
                </a>
                <button type="submit" class="px-6 py-2.5 bg-purple-600 hover:bg-purple-700 text-white font-bold rounded-2xl shadow-md shadow-purple-500/25 transition text-xs">
                    💾 Lưu thay đổi
                </button>
            </div>

        </form>
    </div>

    <script>
        if (typeof ClassicEditor !== 'undefined') {
            ClassicEditor.create(document.querySelector('#editor')).catch(error => { console.error(error); });
        }
    </script>
</div>