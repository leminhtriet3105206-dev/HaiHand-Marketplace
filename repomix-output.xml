<file path="backend/routes/address.js">
const express = require('express');
const mongoose = require('mongoose');
const { protect } = require('../middleware/auth');
const User = require('../models/User');
const { pickAddressFields, isCompleteAddress, formatAddress } = require('../models/schemas/Address');

const router = express.Router();
const MAX_ADDRESSES = 10;

/** Ensure exactly one default and keep legacy `address`/`phone` strings in sync. */
function normalizeBook(user) {
  const list = user.addresses || [];
  if (list.length && !list.some((a) => a.isDefault)) list[0].isDefault = true;
  let seen = false;
  list.forEach((a) => {
    if (a.isDefault && !seen) seen = true;
    else a.isDefault = false;
  });
  const def = list.find((a) => a.isDefault);
  if (def) {
    user.address = formatAddress(def);
    if (!user.phone && def.phone) user.phone = def.phone;
  }
}

/**
 * Shared helper (also used by checkout): add an address to the user's book.
 * @returns the created sub-document
 */
async function addAddressToUser(userId, raw, { makeDefault = false } = {}) {
  const user = await User.findById(userId);
  if (!user) throw Object.assign(new Error('Không tìm thấy người dùng'), { status: 404 });
  const fields = pickAddressFields(raw);
  if (!isCompleteAddress(fields)) throw Object.assign(new Error('Địa chỉ chưa đầy đủ'), { status: 400 });

  // De-duplicate identical addresses
  const dup = user.addresses.find((a) =>
    a.street === fields.street && a.wardCode === fields.wardCode &&
    Number(a.districtId) === Number(fields.districtId) && a.phone === fields.phone && a.fullName === fields.fullName
  );
  let entry = dup;
  if (!entry) {
    if (user.addresses.length >= MAX_ADDRESSES) {
      throw Object.assign(new Error(`Tối đa ${MAX_ADDRESSES} địa chỉ`), { status: 400 });
    }
    user.addresses.push({ ...fields, isDefault: false });
    entry = user.addresses[user.addresses.length - 1];
  }
  if (makeDefault || user.addresses.length === 1) {
    user.addresses.forEach((a) => { a.isDefault = a._id.equals(entry._id); });
  }
  normalizeBook(user);
  await user.save();
  return { user, entry };
}

router.get('/', protect, async (req, res) => {
  const user = await User.findById(req.user._id).select('addresses address phone name');
  res.json({
    addresses: user.addresses || [],
    legacyAddress: (user.addresses || []).length === 0 ? (user.address || '') : '',
    profile: { name: user.name, phone: user.phone }
  });
});

router.post('/', protect, async (req, res) => {
  try {
    const { entry, user } = await addAddressToUser(req.user._id, req.body, { makeDefault: !!req.body.isDefault });
    res.status(201).json({ address: entry, addresses: user.addresses });
  } catch (err) {
    res.status(err.status || 500).json({ message: err.message });
  }
});

router.put('/:id', protect, async (req, res) => {
  try {
    if (!mongoose.Types.ObjectId.isValid(req.params.id)) return res.status(400).json({ message: 'ID không hợp lệ' });
    const user = await User.findById(req.user._id);
    const entry = user.addresses.id(req.params.id);
    if (!entry) return res.status(404).json({ message: 'Không tìm thấy địa chỉ' });
    const fields = pickAddressFields(req.body);
    if (!isCompleteAddress(fields)) return res.status(400).json({ message: 'Địa chỉ chưa đầy đủ' });
    entry.set(fields);
    if (req.body.isDefault) user.addresses.forEach((a) => { a.isDefault = a._id.equals(entry._id); });
    normalizeBook(user);
    await user.save();
    res.json({ address: entry, addresses: user.addresses });
  } catch (err) {
    res.status(500).json({ message: err.message });
  }
});

router.patch('/:id/default', protect, async (req, res) => {
  const user = await User.findById(req.user._id);
  const entry = user.addresses.id(req.params.id);
  if (!entry) return res.status(404).json({ message: 'Không tìm thấy địa chỉ' });
  user.addresses.forEach((a) => { a.isDefault = a._id.equals(entry._id); });
  normalizeBook(user);
  await user.save();
  res.json({ addresses: user.addresses });
});

router.delete('/:id', protect, async (req, res) => {
  const user = await User.findById(req.user._id);
  const entry = user.addresses.id(req.params.id);
  if (!entry) return res.status(404).json({ message: 'Không tìm thấy địa chỉ' });
  entry.deleteOne();
  normalizeBook(user);
  await user.save();
  res.json({ addresses: user.addresses });
});

module.exports = router;
module.exports.addAddressToUser = addAddressToUser;
</file>

<file path="backend/routes/haipay.js">
const express = require('express');
const bcrypt = require('bcryptjs');
const jwt = require('jsonwebtoken');
const User = require('../models/User');
const Transaction = require('../models/Transaction');
const { createAndSaveOtp, verifyOtp } = require('../utils/otpService');
const { JWT_SECRET, sanitizeUser } = require('../utils/b2c');

const router = express.Router();

/**
 * Middleware to authenticate HaiPay wallet session
 */
const requireWalletAuth = async (req, res, next) => {
  try {
    const authHeader = req.headers.authorization;
    if (!authHeader || !authHeader.startsWith('Bearer ')) {
      return res.status(401).json({ message: 'Vui lòng đăng nhập vào Ví HaiPay' });
    }

    const token = authHeader.split(' ')[1];
    const decoded = jwt.verify(token, JWT_SECRET);
    const user = await User.findById(decoded.id);

    if (!user) {
      return res.status(404).json({ message: 'Không tìm thấy người dùng' });
    }

    req.walletUser = user;
    next();
  } catch (err) {
    return res.status(401).json({ message: 'Phiên làm việc của Ví đã hết hạn hoặc không hợp lệ' });
  }
};

/**
 * POST /api/haipay/send-otp
 * Generates and dispatches OTP
 */
router.post('/send-otp', async (req, res) => {
  try {
    const { identifier, purpose = 'LOGIN' } = req.body;

    if (!identifier || !identifier.trim()) {
      return res.status(400).json({ message: 'Vui lòng cung cấp Email hoặc Số điện thoại' });
    }

    const cleanIdentifier = identifier.trim().toLowerCase();

    if (purpose === 'LOGIN') {
      const existingUser = await User.findOne({
        $or: [{ email: cleanIdentifier }, { phone: cleanIdentifier }]
      });

      if (!existingUser) {
        return res.status(404).json({ message: 'Tài khoản chưa được đăng ký trong hệ thống HaiHand' });
      }
    }

    // Generate & send OTP
    await createAndSaveOtp(cleanIdentifier, purpose);

    return res.status(200).json({
      success: true,
      message: `Mã OTP đã được gửi đến ${cleanIdentifier}. Vui lòng kiểm tra hộp thư (hoặc console server).`,
      expiresIn: 300
    });
  } catch (error) {
    console.error('Send OTP Error:', error);
    return res.status(500).json({ message: 'Lỗi khi gửi mã OTP: ' + error.message });
  }
});

/**
 * POST /api/haipay/register
 * Verifies OTP and activates the standalone wallet
 */
router.post('/register', async (req, res) => {
  try {
    const { email, phone, fullName, password, cccd, otp, pin } = req.body;

    if (!email || !otp) {
      return res.status(400).json({ message: 'Vui lòng điền đầy đủ Email và Mã OTP' });
    }

    const cleanEmail = email.trim().toLowerCase();

    // 1. Verify OTP
    const otpResult = await verifyOtp(cleanEmail, otp, 'REGISTER');
    if (!otpResult.valid) {
      return res.status(400).json({ message: otpResult.message });
    }

    // 2. Check if user already exists
    let user = await User.findOne({ email: cleanEmail });

    if (user) {
      // Activate wallet for existing user
      user.isWalletActive = true;
      if (phone) user.walletPhone = phone.trim();
      if (fullName && (!user.name || user.name === 'User')) user.name = fullName.trim();
      if (cccd) user.cccd = cccd.trim();
      if (pin) user.walletPin = await bcrypt.hash(pin.trim(), 8);
      user.walletRegisteredAt = new Date();
      await user.save();
    } else {
      // Create new user with active wallet
      if (!password) {
        return res.status(400).json({ message: 'Vui lòng đặt mật khẩu cho tài khoản mới' });
      }

      const hashedPassword = await bcrypt.hash(password, 10);
      let hashedPin = '';
      if (pin) hashedPin = await bcrypt.hash(pin.trim(), 8);

      user = new User({
        name: fullName ? fullName.trim() : cleanEmail.split('@')[0],
        email: cleanEmail,
        password: hashedPassword,
        phone: phone ? phone.trim() : '',
        walletPhone: phone ? phone.trim() : '',
        cccd: cccd ? cccd.trim() : '',
        walletPin: hashedPin,
        isWalletActive: true,
        walletRegisteredAt: new Date(),
        walletBalance: 0,
        pendingBalance: 0
      });
      await user.save();
    }

    // 3. Issue dedicated wallet JWT session
    const token = jwt.sign(
      {
        id: user._id,
        email: user.email,
        isWalletActive: true,
        sessionType: 'HAIPAY_WALLET'
      },
      JWT_SECRET,
      { expiresIn: '7d' }
    );

    return res.status(200).json({
      success: true,
      message: '🎉 Kích hoạt Ví HaiPay thành công!',
      token,
      user: sanitizeUser(user)
    });
  } catch (error) {
    console.error('HaiPay Register Error:', error);
    return res.status(500).json({ message: 'Lỗi kích hoạt ví: ' + error.message });
  }
});

/**
 * POST /api/haipay/login
 * Authenticates user credentials + verifies OTP to return specialized wallet session
 */
router.post('/login', async (req, res) => {
  try {
    const { identifier, password, otp } = req.body;

    if (!identifier || !identifier.trim()) {
      return res.status(400).json({ message: 'Vui lòng nhập Email hoặc Số điện thoại' });
    }

    const cleanIdentifier = identifier.trim().toLowerCase();
    const user = await User.findOne({
      $or: [{ email: cleanIdentifier }, { phone: cleanIdentifier }, { walletPhone: cleanIdentifier }]
    });

    if (!user) {
      return res.status(404).json({ message: 'Tài khoản không tồn tại trong hệ thống' });
    }

    // Verify password if provided
    if (password) {
      const isPasswordValid = await bcrypt.compare(password, user.password);
      if (!isPasswordValid) {
        return res.status(400).json({ message: 'Mật khẩu không chính xác' });
      }
    }

    // Step A: If no OTP provided yet, auto-generate & send OTP
    if (!otp) {
      await createAndSaveOtp(user.email, 'LOGIN');
      return res.status(200).json({
        requireOtp: true,
        email: user.email,
        message: `Mã OTP đã được gửi đến email ${user.email}. Vui lòng nhập mã để hoàn tất đăng nhập!`
      });
    }

    // Step B: Verify OTP
    const otpResult = await verifyOtp(user.email, otp, 'LOGIN');
    if (!otpResult.valid) {
      return res.status(400).json({ message: otpResult.message });
    }

    // Ensure wallet is marked active
    if (!user.isWalletActive) {
      user.isWalletActive = true;
      user.walletRegisteredAt = user.walletRegisteredAt || new Date();
      await user.save();
    }

    // Issue specialized wallet token
    const token = jwt.sign(
      {
        id: user._id,
        email: user.email,
        isWalletActive: true,
        sessionType: 'HAIPAY_WALLET'
      },
      JWT_SECRET,
      { expiresIn: '7d' }
    );

    return res.status(200).json({
      success: true,
      message: '🎉 Đăng nhập Ví HaiPay thành công!',
      token,
      user: sanitizeUser(user)
    });
  } catch (error) {
    console.error('HaiPay Login Error:', error);
    return res.status(500).json({ message: 'Lỗi đăng nhập Ví HaiPay: ' + error.message });
  }
});

/**
 * POST /api/haipay/verify-firebase
 * Handles phone number verification from Firebase Phone Auth
 */
router.post('/verify-firebase', async (req, res) => {
  try {
    const { phoneNumber, firebaseUid, fullName, email } = req.body;

    if (!phoneNumber || !phoneNumber.trim()) {
      return res.status(400).json({ message: 'Thiếu số điện thoại được xác thực từ Firebase' });
    }

    const cleanRawPhone = phoneNumber.trim();
    // Normalize phone numbers for search
    // Firebase returns E.164: +84912345678
    const localPhone = cleanRawPhone.startsWith('+84')
      ? '0' + cleanRawPhone.slice(3)
      : (cleanRawPhone.startsWith('84') ? '0' + cleanRawPhone.slice(2) : cleanRawPhone);
    const intlPhone = cleanRawPhone.startsWith('+')
      ? cleanRawPhone
      : (cleanRawPhone.startsWith('0') ? '+84' + cleanRawPhone.slice(1) : '+84' + cleanRawPhone);

    // Find user by either local or intl phone, or walletPhone, or firebaseUid
    let user = await User.findOne({
      $or: [
        { phone: localPhone },
        { phone: intlPhone },
        { walletPhone: localPhone },
        { walletPhone: intlPhone },
        ...(firebaseUid ? [{ firebaseUid }] : [])
      ]
    });

    if (user) {
      // Activate wallet if not already active
      user.isWalletActive = true;
      if (!user.walletPhone) user.walletPhone = localPhone;
      if (firebaseUid && !user.firebaseUid) user.firebaseUid = firebaseUid;
      if (!user.walletRegisteredAt) user.walletRegisteredAt = new Date();
      if (fullName && (!user.name || user.name.startsWith('Người dùng'))) {
        user.name = fullName.trim();
      }
      user.lastActive = new Date();
      await user.save();
    } else {
      // Create new user with active wallet
      const cleanEmail = email && email.trim() 
        ? email.trim().toLowerCase() 
        : `haipay_${localPhone.replace(/\D/g, '') || Date.now()}@haipay.vn`;

      // Check if email happens to exist
      const existingEmailUser = await User.findOne({ email: cleanEmail });
      const finalEmail = existingEmailUser 
        ? `haipay_${Date.now()}_${Math.floor(Math.random() * 1000)}@haipay.vn` 
        : cleanEmail;

      const randomPassword = await bcrypt.hash(`fb_auth_${firebaseUid || Date.now()}`, 10);

      user = new User({
        name: fullName && fullName.trim() ? fullName.trim() : `Người dùng HaiPay ${localPhone.slice(-4) || 'Mới'}`,
        email: finalEmail,
        phone: localPhone,
        walletPhone: localPhone,
        firebaseUid: firebaseUid || '',
        password: randomPassword,
        isWalletActive: true,
        walletRegisteredAt: new Date(),
        walletBalance: 0,
        pendingBalance: 0,
        lastActive: new Date()
      });

      await user.save();
    }

    // Issue standard HaiPay wallet JWT
    const token = jwt.sign(
      {
        id: user._id,
        email: user.email,
        phone: user.phone || user.walletPhone,
        isWalletActive: true,
        sessionType: 'HAIPAY_WALLET'
      },
      JWT_SECRET,
      { expiresIn: '7d' }
    );

    return res.status(200).json({
      success: true,
      message: '🎉 Xác thực Firebase SMS OTP thành công!',
      token,
      user: sanitizeUser(user)
    });
  } catch (error) {
    console.error('Firebase Auth Verification Error:', error);
    return res.status(500).json({ message: 'Lỗi đồng bộ Firebase với máy chủ: ' + error.message });
  }
});

/**
 * GET /api/haipay/me
 * Retrieves current wallet profile, balances, and transaction history
 */
router.get('/me', requireWalletAuth, async (req, res) => {
  try {
    const user = req.walletUser;
    const transactions = await Transaction.find({ user: user._id })
      .sort({ createdAt: -1 })
      .limit(50);

    return res.status(200).json({
      success: true,
      user: sanitizeUser(user),
      wallet: {
        walletBalance: user.walletBalance || 0,
        pendingBalance: user.pendingBalance || 0,
        isWalletActive: !!user.isWalletActive,
        walletPhone: user.walletPhone || user.phone || '',
        cccd: user.cccd || '',
        bankInfo: user.bankInfo || { name: '', accountNumber: '', accountName: '' },
        registeredAt: user.walletRegisteredAt
      },
      transactions
    });
  } catch (error) {
    console.error('HaiPay Me Error:', error);
    return res.status(500).json({ message: 'Lỗi lấy thông tin ví: ' + error.message });
  }
});

module.exports = router;
</file>

<file path="backend/routes/seller.js">
const express = require('express');
const { protect, isSeller, isAdmin } = require('../middleware/auth');
const User = require('../models/User');
const Order = require('../models/Order');
const { Post } = require('../models/Product');
const {
  sanitizeUser,
  canonicalStatus,
  productOwnerId,
  orderSellerId,
  orderBuyerId
} = require('../utils/b2c');
const shippingService = require('../services/shipping');
const { pickAddressFields, formatAddress, isCompleteAddress } = require('../models/schemas/Address');

module.exports = function createSellerRouter({ upload, sendNotification, sendAdminNotification, io }) {
  const router = express.Router();

  const parseVariants = (raw) => {
    if (!raw) return [];
    if (Array.isArray(raw)) return raw;
    try {
      const parsed = JSON.parse(raw);
      return Array.isArray(parsed) ? parsed : [];
    } catch (e) {
      return [];
    }
  };

  router.post('/api/users/apply-seller', protect, async (req, res) => {
    try {
      const user = await User.findById(req.user._id);
      if (!user) return res.status(404).json({ message: 'Không tìm thấy người dùng' });
      if (user.sellerStatus === 'approved' && user.isSeller) {
        return res.status(400).json({ message: 'Tài khoản đã là Seller được duyệt.' });
      }
      if (user.sellerStatus === 'pending') {
        return res.status(400).json({ message: 'Hồ sơ đang chờ Admin duyệt.' });
      }

      const shop = req.body.shopInfo || req.body;
      user.shopInfo = {
        shopName: shop.shopName || user.name,
        description: shop.description || '',
        address: shop.address || user.address || '',
        avatar: shop.avatar || user.avatar || '',
        banner: shop.banner || '',
        phone: shop.phone || user.phone || '',
        taxCode: shop.taxCode || user.taxId || ''
      };
      user.sellerStatus = 'pending';
      user.sellerAppliedAt = new Date();
      user.sellerRejectionReason = '';
      user.isSeller = false;
      await user.save();

      // Trigger 2: When a user applies for Seller status, create a notification for Admins
      try {
        if (typeof sendAdminNotification === 'function') {
          await sendAdminNotification(
            'Yêu cầu mở Shop',
            'Có yêu cầu mở Shop B2C mới!',
            '/admin/seller-applications',
            'SELLER'
          );
        } else {
          const Notification = require('../models/Notification');
          const notif = await Notification.create({
            title: 'Yêu cầu mở Shop',
            message: 'Có yêu cầu mở Shop B2C mới!',
            type: 'SELLER',
            link: '/admin/seller-applications',
            targetUrl: '/admin/seller-applications',
            isRead: false
          });
          if (io) io.emit('new_admin_notification', notif);
        }
      } catch (e) {
        console.error('Lỗi gửi thông báo seller:', e);
      }

      res.status(200).json({
        message: 'Đã gửi đăng ký mở Shop. Vui lòng chờ Admin duyệt.',
        user: sanitizeUser(user)
      });
    } catch (error) {
      res.status(500).json({ message: 'Lỗi gửi đăng ký Seller: ' + error.message });
    }
  });

  router.get('/api/admin/seller-applications', isAdmin, async (req, res) => {
    try {
      const status = req.query.status || 'pending';
      const query = status === 'all'
        ? { sellerStatus: { $in: ['pending', 'approved', 'rejected'] } }
        : { sellerStatus: status };
      const applications = await User.find(query)
        .select('-password')
        .sort({ sellerAppliedAt: -1, updatedAt: -1 });
      res.json({ applications });
    } catch (error) {
      res.status(500).json({ message: 'Lỗi tải hồ sơ Seller' });
    }
  });

  router.put('/api/admin/approve-seller/:id', isAdmin, async (req, res) => {
    try {
      const user = await User.findById(req.params.id);
      if (!user) return res.status(404).json({ message: 'Không tìm thấy người dùng' });
      user.isSeller = true;
      user.sellerStatus = 'approved';
      user.sellerApprovedAt = new Date();
      user.sellerRejectionReason = '';
      if (!user.shopInfo || !user.shopInfo.shopName) {
        user.shopInfo = {
          ...(user.shopInfo || {}),
          shopName: user.name,
          avatar: (user.shopInfo && user.shopInfo.avatar) || user.avatar || ''
        };
      }
      await user.save();

      if (sendNotification) {
        await sendNotification(
          user._id,
          '🎉 Shop đã được duyệt!',
          'Admin đã duyệt đăng ký bán hàng. Bạn có thể vào Kênh Người Bán để đăng sản phẩm.',
          'SYSTEM',
          '/seller-channel'
        );
      }

      res.json({ message: 'Đã duyệt Seller', user: sanitizeUser(user) });
    } catch (error) {
      res.status(500).json({ message: 'Lỗi duyệt Seller' });
    }
  });

  router.put('/api/admin/reject-seller/:id', isAdmin, async (req, res) => {
    try {
      const user = await User.findById(req.params.id);
      if (!user) return res.status(404).json({ message: 'Không tìm thấy người dùng' });
      user.isSeller = false;
      user.sellerStatus = 'rejected';
      user.sellerRejectionReason = req.body.reason || 'Hồ sơ chưa đủ điều kiện';
      await user.save();

      if (sendNotification) {
        await sendNotification(
          user._id,
          'Hồ sơ mở Shop bị từ chối',
          user.sellerRejectionReason,
          'SYSTEM',
          '/seller-register'
        );
      }

      res.json({ message: 'Đã từ chối hồ sơ Seller', user: sanitizeUser(user) });
    } catch (error) {
      res.status(500).json({ message: 'Lỗi từ chối Seller' });
    }
  });

  router.get('/api/seller/dashboard', protect, isSeller, async (req, res) => {
    try {
      const sellerId = req.user._id;
      const products = await Post.find({ $or: [{ sellerId }, { author: sellerId }] });
      const orders = await Order.find({ $or: [{ sellerId }, { seller: sellerId }] });

      const pending = orders.filter((o) => canonicalStatus(o.status) === 'Pending').length;
      const processing = orders.filter((o) => ['Processing', 'Shipped', 'Delivered'].includes(canonicalStatus(o.status))).length;
      const completed = orders.filter((o) => canonicalStatus(o.status) === 'Completed');
      const revenue = completed.reduce((sum, o) => sum + (o.totalPrice || 0) * 0.95, 0);
      const totalSales = completed.reduce((sum, o) => sum + (o.totalPrice || 0), 0);

      res.json({
        shop: req.user.shopInfo || {},
        stats: {
          productCount: products.length,
          activeProducts: products.filter((p) => p.status === 'active' || p.status === 'APPROVED').length,
          pendingOrders: pending,
          openOrders: processing,
          completedOrders: completed.length,
          totalSales,
          revenue,
          walletBalance: req.user.walletBalance || 0,
          pendingBalance: req.user.pendingBalance || 0
        }
      });
    } catch (error) {
      res.status(500).json({ message: 'Lỗi dashboard Seller' });
    }
  });

  router.get('/api/seller/shop', protect, isSeller, async (req, res) => {
    res.json({ shopInfo: req.user.shopInfo || {}, user: sanitizeUser(req.user) });
  });

  router.put('/api/seller/shop', protect, isSeller, upload.fields([
    { name: 'avatar', maxCount: 1 },
    { name: 'banner', maxCount: 1 }
  ]), async (req, res) => {
    try {
      const user = await User.findById(req.user._id);
      const current = user.shopInfo || {};
      const next = {
        shopName: req.body.shopName != null ? req.body.shopName : current.shopName,
        description: req.body.description != null ? req.body.description : current.description,
        address: req.body.address != null ? req.body.address : current.address,
        phone: req.body.phone != null ? req.body.phone : current.phone,
        taxCode: req.body.taxCode != null ? req.body.taxCode : current.taxCode,
        avatar: current.avatar,
        banner: current.banner,
        pickupAddress: current.pickupAddress
      };
      if (req.body.pickupAddress) {
        let pa = req.body.pickupAddress;
        if (typeof pa === 'string') {
          try { pa = JSON.parse(pa); } catch (e) {}
        }
        if (typeof pa === 'object' && pa) {
          const cleanPa = pickAddressFields(pa);
          next.pickupAddress = cleanPa;
          if (isCompleteAddress(cleanPa) && (!req.body.address || req.body.address === current.address)) {
            next.address = formatAddress(cleanPa);
          }
        }
      }
      if (req.files?.avatar?.[0]) next.avatar = req.files.avatar[0].path;
      if (req.files?.banner?.[0]) next.banner = req.files.banner[0].path;
      user.shopInfo = next;
      await user.save();
      res.json({ message: 'Đã lưu thông tin Shop', shopInfo: user.shopInfo, user: sanitizeUser(user) });
    } catch (error) {
      res.status(500).json({ message: 'Lỗi cập nhật Shop' });
    }
  });

  router.get('/api/seller/products', protect, isSeller, async (req, res) => {
    try {
      const products = await Post.find({
        $or: [{ sellerId: req.user._id }, { author: req.user._id }]
      }).sort({ createdAt: -1 });
      res.json(products);
    } catch (error) {
      res.status(500).json({ message: 'Lỗi tải sản phẩm' });
    }
  });

  router.post('/api/seller/products', protect, isSeller, upload.array('images', 8), async (req, res) => {
    try {
      const { name, title, sku, price, originalPrice, stockQuantity, quantity, category, location, description, condition, status, variants, details } = req.body;
      const displayName = (name || title || '').trim();
      if (!displayName || !price || !category) {
        return res.status(400).json({ message: 'Vui lòng nhập tên, giá và danh mục.' });
      }

      const imagePaths = (req.files || []).map((file) => file.path || file.secure_url || file.filename);
      let parsedDetails = {};
      if (details) {
        try { parsedDetails = typeof details === 'string' ? JSON.parse(details) : details; } catch (e) { parsedDetails = {}; }
      }

      const stock = Number(stockQuantity != null ? stockQuantity : quantity) || 0;

      // Check Auto-Approve setting from GlobalSetting
      let isAutoApprove = false;
      try {
        const Settings = require('../models/Settings');
        const setting = await Settings.findOne();
        isAutoApprove = setting && setting.autoApprovePosts === true;
      } catch (e) {}

      const postStatus = stock <= 0 ? 'out_of_stock' : (status === 'inactive' ? 'inactive' : (isAutoApprove ? 'active' : 'pending'));

      const product = new Post({
        name: displayName,
        title: displayName,
        sku: sku || '',
        price: Number(price),
        originalPrice: Number(originalPrice) || 0,
        stockQuantity: stock,
        quantity: stock,
        category,
        location: location || (req.user.shopInfo && req.user.shopInfo.address) || 'Toàn quốc',
        description: description || '',
        condition: condition || parsedDetails.condition || 'Mới',
        images: imagePaths,
        sellerId: req.user._id,
        author: req.user._id,
        variants: parseVariants(variants),
        details: parsedDetails,
        status: postStatus
      });
      await product.save();

      // Trigger 1: When a user/seller creates a new Product/Post (and auto-approve is false), automatically create a notification for Admins
      if (!isAutoApprove && postStatus === 'pending') {
        try {
          if (typeof sendAdminNotification === 'function') {
            await sendAdminNotification(
              'Tin đăng mới',
              'Có tin đăng mới chờ duyệt!',
              '/posts',
              'PRODUCT'
            );
          } else {
            const Notification = require('../models/Notification');
            const notif = await Notification.create({
              title: 'Tin đăng mới',
              message: 'Có tin đăng mới chờ duyệt!',
              type: 'PRODUCT',
              link: '/posts',
              targetUrl: '/posts',
              isRead: false
            });
            if (io) io.emit('new_admin_notification', notif);
          }
        } catch (e) {
          console.error('Lỗi gửi thông báo sản phẩm seller mới:', e);
        }
      }

      res.status(201).json({ message: 'Đã tạo sản phẩm', product });
    } catch (error) {
      res.status(500).json({ message: error.message || 'Lỗi tạo sản phẩm' });
    }
  });

  router.put('/api/seller/products/:id', protect, isSeller, upload.array('images', 8), async (req, res) => {
    try {
      const product = await Post.findById(req.params.id);
      if (!product) return res.status(404).json({ message: 'Không tìm thấy sản phẩm' });
      if (productOwnerId(product) !== req.user._id.toString()) {
        return res.status(403).json({ message: 'Không phải sản phẩm của Shop bạn' });
      }

      const fields = ['name', 'title', 'sku', 'price', 'originalPrice', 'stockQuantity', 'quantity', 'category', 'location', 'description', 'condition', 'status'];
      fields.forEach((key) => {
        if (req.body[key] !== undefined) product[key] = req.body[key];
      });
      if (req.body.name && !req.body.title) product.title = req.body.name;
      if (req.body.title && !req.body.name) product.name = req.body.title;
      if (req.body.stockQuantity != null) product.quantity = Number(req.body.stockQuantity);
      if (req.body.quantity != null && req.body.stockQuantity == null) product.stockQuantity = Number(req.body.quantity);
      if (req.body.variants) product.variants = parseVariants(req.body.variants);
      if (req.body.details) {
        try {
          product.details = typeof req.body.details === 'string' ? JSON.parse(req.body.details) : req.body.details;
        } catch (e) { }
      }
      if (req.files && req.files.length > 0) {
        product.images = req.files.map((file) => file.path || file.filename);
      }
      if (Number(product.stockQuantity) <= 0) product.status = 'out_of_stock';
      await product.save();
      res.json({ message: 'Đã cập nhật sản phẩm', product });
    } catch (error) {
      res.status(500).json({ message: 'Lỗi cập nhật sản phẩm' });
    }
  });

  router.delete('/api/seller/products/:id', protect, isSeller, async (req, res) => {
    try {
      const product = await Post.findById(req.params.id);
      if (!product) return res.status(404).json({ message: 'Không tìm thấy sản phẩm' });
      if (productOwnerId(product) !== req.user._id.toString()) {
        return res.status(403).json({ message: 'Không phải sản phẩm của Shop bạn' });
      }
      product.status = 'inactive';
      await product.save();
      res.json({ message: 'Đã ẩn sản phẩm', product });
    } catch (error) {
      res.status(500).json({ message: 'Lỗi xóa sản phẩm' });
    }
  });

  router.get('/api/seller/orders', protect, isSeller, async (req, res) => {
    try {
      const orders = await Order.find({
        $or: [{ sellerId: req.user._id }, { seller: req.user._id }]
      })
        .populate('buyer buyerId', 'name email phone address avatar')
        .populate('items', 'title name price images image stockQuantity')
        .sort({ createdAt: -1 });

      res.json(orders.map((order) => {
        const o = order.toObject();
        o.canonicalStatus = canonicalStatus(o.status);
        o.buyerId = orderBuyerId(o);
        o.sellerId = orderSellerId(o);
        return o;
      }));
    } catch (error) {
      res.status(500).json({ message: 'Lỗi tải đơn hàng Seller' });
    }
  });

  router.put('/api/seller/orders/:id/status', protect, isSeller, async (req, res) => {
    try {
      const order = await Order.findById(req.params.id).populate('buyer buyerId seller sellerId');
      if (!order) return res.status(404).json({ message: 'Không tìm thấy đơn hàng' });
      if (orderSellerId(order).toString() !== req.user._id.toString()) {
        return res.status(403).json({ message: 'Đơn này không thuộc Shop bạn' });
      }

      const current = canonicalStatus(order.status);
      const next = req.body.status;
      const shippingCode = req.body.shippingCode;
      const shippingCarrier = req.body.shippingCarrier;

      const allowed = {
        Pending: ['Processing', 'Cancelled'],
        Processing: ['Shipped', 'Cancelled'],
        Shipped: ['Delivered'],
        Delivered: ['Completed']
      };

      if (!allowed[current] || !allowed[current].includes(next)) {
        return res.status(400).json({ message: `Không thể chuyển từ ${current} sang ${next}` });
      }

      if (next === 'Cancelled' && ['Shipped', 'Delivered', 'Completed'].includes(current)) {
        return res.status(400).json({ message: 'Không thể hủy đơn đang giao / đã hoàn tất' });
      }

      order.status = next;
      if (shippingCode) order.shippingCode = shippingCode;
      if (shippingCarrier) order.shippingCarrier = shippingCarrier;
      if (next === 'Delivered') order.deliveredAt = new Date();
      if (next === 'Completed') order.completedAt = new Date();
      if (next === 'Cancelled') {
        order.cancelledAt = new Date();
        order.cancelReason = req.body.cancelReason || '';
      }
      await order.save();

      const buyerId = orderBuyerId(order);
      if (sendNotification && buyerId) {
        await sendNotification(
          buyerId,
          'Cập nhật đơn hàng',
          `Đơn #${order._id.toString().slice(-6).toUpperCase()} đã chuyển sang ${next}.`,
          'ORDER',
          '/profile?tab=orders_buy'
        );
      }

      res.json({ message: 'Đã cập nhật đơn hàng', order });
    } catch (error) {
      res.status(500).json({ message: 'Lỗi cập nhật đơn hàng' });
    }
  });

  /**
   * POST /api/seller/orders/:id/prepare
   * Seller clicks "Chuẩn bị hàng" -> creates carrier shipment, registers package with carrier,
   * obtains trackingCode and updates order status to 'Processing'.
   */
  router.post('/api/seller/orders/:id/prepare', protect, isSeller, async (req, res) => {
    try {
      const order = await Order.findById(req.params.id).populate('buyer buyerId');
      if (!order) return res.status(404).json({ message: 'Không tìm thấy đơn hàng' });
      if (orderSellerId(order).toString() !== req.user._id.toString()) {
        return res.status(403).json({ message: 'Đơn này không thuộc Shop bạn' });
      }

      const current = canonicalStatus(order.status);
      if (current !== 'Pending') {
        return res.status(400).json({
          message: `Đơn hàng đang ở trạng thái "${current}", chỉ có thể chuẩn bị đơn khi đang "Chờ xác nhận" (Pending).`
        });
      }

      // Check payment status for non-COD orders
      if (order.paymentMethod !== 'COD' && order.paymentStatus !== 'escrow') {
        return res.status(400).json({
          message: 'Đơn hàng chưa được thanh toán thành công, không thể tạo vận đơn giao hàng!'
        });
      }

      // Call shipping service to create shipment (GHN or Mock)
      const shipmentResult = await shippingService.createShipmentForOrder(order);

      order.shipment = shipmentResult;
      order.shippingCode = shipmentResult.trackingCode || '';
      order.shippingCarrier = shipmentResult.carrier || 'Giao Hàng Nhanh';
      order.status = 'Processing'; // Đang chuẩn bị hàng
      await order.save();

      const buyerId = orderBuyerId(order);
      if (sendNotification && buyerId) {
        await sendNotification(
          buyerId,
          '📦 Shop đang chuẩn bị hàng',
          `Đơn hàng #${order._id.toString().slice(-6).toUpperCase()} đã được Shop chuẩn bị với mã vận đơn ${order.shippingCode} (${order.shippingCarrier}).`,
          'ORDER',
          '/profile?tab=orders_buy'
        );
      }

      return res.status(200).json({
        success: true,
        message: '🎉 Chuẩn bị hàng thành công! Đã tạo mã vận đơn từ hãng vận chuyển.',
        trackingCode: order.shippingCode,
        carrier: order.shippingCarrier,
        order
      });
    } catch (error) {
      console.error('Prepare order error:', error);
      return res.status(error.status || 500).json({
        message: error.message || 'Lỗi khi tạo vận đơn giao hàng'
      });
    }
  });

  return router;
};
</file>

<file path="backend/routes/shipping.js">
const express = require('express');
const { protect } = require('../middleware/auth');
const shipping = require('../services/shipping');
const { pickAddressFields } = require('../models/schemas/Address');

const router = express.Router();

const handle = (fn) => async (req, res) => {
  try {
    await fn(req, res);
  } catch (err) {
    const status = err.status || 500;
    if (status >= 500) console.error('[Shipping route]', err);
    res.status(status).json({ message: err.message || 'Lỗi vận chuyển', code: err.code });
  }
};

// ---- Master data (public; used by address forms) ----
router.get('/provider', (req, res) => {
  const p = shipping.provider();
  res.json({ provider: p.NAME, carrier: p.CARRIER_LABEL });
});

router.get('/provinces', handle(async (req, res) => {
  res.json(await shipping.getProvinces());
}));

router.get('/districts', handle(async (req, res) => {
  if (!req.query.provinceId) return res.status(400).json({ message: 'Thiếu provinceId' });
  res.json(await shipping.getDistricts(req.query.provinceId));
}));

router.get('/wards', handle(async (req, res) => {
  if (!req.query.districtId) return res.status(400).json({ message: 'Thiếu districtId' });
  res.json(await shipping.getWards(req.query.districtId));
}));

/**
 * POST /api/shipping/calculate
 * Body: { sellerId, toAddress, items: [{ productId, quantity }] }
 * Origin address + product weights are always loaded server-side.
 */
router.post('/calculate', protect, handle(async (req, res) => {
  const { sellerId, toAddress, items } = req.body || {};
  if (!sellerId || !Array.isArray(items) || items.length === 0) {
    return res.status(400).json({ message: 'Thiếu sellerId hoặc danh sách sản phẩm', code: 'BAD_REQUEST' });
  }
  const q = await shipping.quotePackage({ sellerId, items, toAddress: pickAddressFields(toAddress) });
  res.json({
    sellerId,
    fee: q.fee,
    provider: q.provider,
    carrier: q.carrier,
    serviceId: q.serviceId,
    serviceTypeId: q.serviceTypeId,
    expectedDeliveryTime: q.expectedDeliveryTime,
    weight: q.weight
  });
}));

module.exports = router;
</file>

<file path="backend/scripts/migrate-c2c-to-b2c.js">
require('dotenv').config();
const mongoose = require('mongoose');
const User = require('../models/User');
const Order = require('../models/Order');
const { Post } = require('../models/Product');
const { canonicalStatus } = require('../utils/b2c');

async function migrate() {
  const uri = process.env.MONGO_URI || process.env.MONGODB_URI;
  if (!uri) {
    console.error('Thiếu MONGO_URI');
    process.exit(1);
  }
  await mongoose.connect(uri);

  const posters = await Post.distinct('author');
  const sellerIds = await Post.distinct('sellerId');
  const allSellerIds = [...new Set([...posters, ...sellerIds].filter(Boolean).map((id) => id.toString()))];

  let approved = 0;
  for (const id of allSellerIds) {
    const user = await User.findById(id);
    if (!user) continue;
    if (user.sellerStatus === 'approved' && user.isSeller) continue;
    user.isSeller = true;
    user.sellerStatus = 'approved';
    user.sellerApprovedAt = user.sellerApprovedAt || new Date();
    user.shopInfo = {
      shopName: (user.shopInfo && user.shopInfo.shopName) || user.name,
      description: (user.shopInfo && user.shopInfo.description) || user.bio || '',
      address: (user.shopInfo && user.shopInfo.address) || user.address || '',
      avatar: (user.shopInfo && user.shopInfo.avatar) || user.avatar || '',
      banner: (user.shopInfo && user.shopInfo.banner) || '',
      phone: (user.shopInfo && user.shopInfo.phone) || user.phone || '',
      taxCode: (user.shopInfo && user.shopInfo.taxCode) || user.taxId || ''
    };
    await user.save();
    approved += 1;
  }

  await User.updateMany(
    { sellerStatus: { $exists: false } },
    { $set: { isSeller: false, sellerStatus: 'none' } }
  );

  const posts = await Post.find({});
  let postUpdated = 0;
  for (const post of posts) {
    let changed = false;
    if (!post.sellerId && post.author) {
      post.sellerId = post.author;
      changed = true;
    }
    if (!post.author && post.sellerId) {
      post.author = post.sellerId;
      changed = true;
    }
    if (!post.name && post.title) {
      post.name = post.title;
      changed = true;
    }
    if (!post.title && post.name) {
      post.title = post.name;
      changed = true;
    }
    if (post.stockQuantity == null && post.quantity != null) {
      post.stockQuantity = post.quantity;
      changed = true;
    }
    if (post.quantity == null && post.stockQuantity != null) {
      post.quantity = post.stockQuantity;
      changed = true;
    }
    if (post.status === 'APPROVED') {
      post.status = 'active';
      changed = true;
    } else if (post.status === 'PENDING' || post.status === 'Pending') {
      post.status = 'inactive';
      changed = true;
    } else if (post.status === 'SOLD' || Number(post.stockQuantity) === 0) {
      post.status = 'out_of_stock';
      changed = true;
    }
    if (changed) {
      await post.save();
      postUpdated += 1;
    }
  }

  const orders = await Order.find({});
  let orderUpdated = 0;
  for (const order of orders) {
    let changed = false;
    if (!order.buyerId && order.buyer) {
      order.buyerId = order.buyer;
      changed = true;
    }
    if (!order.buyer && order.buyerId) {
      order.buyer = order.buyerId;
      changed = true;
    }
    if (!order.sellerId && order.seller) {
      order.sellerId = order.seller;
      changed = true;
    }
    if (!order.seller && order.sellerId) {
      order.seller = order.sellerId;
      changed = true;
    }
    if (order.status === 'Đã thanh toán (Admin giữ tiền)') {
      order.paymentStatus = 'escrow';
      changed = true;
    } else if (order.status === 'Đã thanh toán cho người bán') {
      order.paymentStatus = 'released';
      changed = true;
    } else if (order.status === 'Đã hủy (Chờ hoàn tiền)' || order.status === 'Đã hủy') {
      if (order.status === 'Đã hủy (Chờ hoàn tiền)') order.paymentStatus = 'refunded';
      changed = true;
    }
    const nextStatus = canonicalStatus(order.status);
    if (nextStatus !== order.status) {
      order.status = nextStatus;
      changed = true;
    }
    if ((!order.orderItems || order.orderItems.length === 0) && order.items && order.items.length) {
      const products = await Post.find({ _id: { $in: order.items } });
      order.orderItems = products.map((p) => ({
        productId: p._id,
        name: p.name || p.title,
        price: p.price,
        quantity: 1,
        image: (p.images && p.images[0]) || ''
      }));
      changed = true;
    }
    if (changed) {
      await order.save();
      orderUpdated += 1;
    }
  }

  console.log(JSON.stringify({ approvedSellers: approved, postUpdated, orderUpdated }, null, 2));
  await mongoose.disconnect();
}

migrate().catch((err) => {
  console.error(err);
  process.exit(1);
});
</file>

<file path="backend/services/shipping/ghnProvider.js">
/**
 * GHN (Giao Hàng Nhanh) provider.
 * Docs: https://api.ghn.vn/home/docs/detail
 * Sandbox base: https://dev-online-gateway.ghn.vn/shiip/public-api
 */
const NAME = 'ghn';
const CARRIER_LABEL = 'Giao Hàng Nhanh (GHN)';

const BASE = (process.env.GHN_API_URL || 'https://dev-online-gateway.ghn.vn/shiip/public-api').replace(/\/$/, '');
const TOKEN = process.env.GHN_TOKEN || '';
const SHOP_ID = process.env.GHN_SHOP_ID || '';
const TIMEOUT_MS = 10000;

const cache = new Map(); // master-data cache (rarely changes)

async function ghn(path, { method = 'POST', body, withShop = false } = {}) {
  const headers = { 'Content-Type': 'application/json', Token: TOKEN };
  if (withShop) headers.ShopId = String(SHOP_ID);

  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), TIMEOUT_MS);
  try {
    const res = await fetch(BASE + path, {
      method,
      headers,
      body: body ? JSON.stringify(body) : undefined,
      signal: ctrl.signal
    });
    const json = await res.json().catch(() => ({}));
    if (!res.ok || (json.code && json.code !== 200)) {
      const msg = json.code_message_value || json.message || `GHN HTTP ${res.status}`;
      const err = new Error(msg);
      err.status = res.status;
      err.ghn = json;
      throw err;
    }
    return json.data;
  } finally {
    clearTimeout(timer);
  }
}

async function cached(key, fn) {
  if (cache.has(key)) return cache.get(key);
  const value = await fn();
  cache.set(key, value);
  return value;
}

async function getProvinces() {
  return cached('provinces', async () => {
    const data = await ghn('/master-data/province', { method: 'GET' });
    return (data || []).map((p) => ({ id: p.ProvinceID, name: p.ProvinceName }))
      .sort((a, b) => a.name.localeCompare(b.name, 'vi'));
  });
}

async function getDistricts(provinceId) {
  return cached(`d:${provinceId}`, async () => {
    const data = await ghn('/master-data/district', { body: { province_id: Number(provinceId) } });
    return (data || []).map((d) => ({ id: d.DistrictID, name: d.DistrictName, provinceId: d.ProvinceID }));
  });
}

async function getWards(districtId) {
  return cached(`w:${districtId}`, async () => {
    const data = await ghn('/master-data/ward', { body: { district_id: Number(districtId) } });
    return (data || []).map((w) => ({ code: w.WardCode, name: w.WardName, districtId: w.DistrictID }));
  });
}

async function pickService(fromDistrictId, toDistrictId) {
  const services = await ghn('/v2/shipping-order/available-services', {
    body: { shop_id: Number(SHOP_ID), from_district: Number(fromDistrictId), to_district: Number(toDistrictId) }
  });
  // Prefer "Hàng nhẹ" (service_type_id 2), fallback to first
  return (services || []).find((s) => s.service_type_id === 2) || (services || [])[0] || { service_type_id: 2 };
}

async function calculateFee({ from, to, weight, insuranceValue = 0 }) {
  const service = await pickService(from.districtId, to.districtId);
  const body = {
    service_type_id: service.service_type_id || 2,
    service_id: service.service_id,
    from_district_id: Number(from.districtId),
    from_ward_code: String(from.wardCode),
    to_district_id: Number(to.districtId),
    to_ward_code: String(to.wardCode),
    weight: Math.max(1, Math.round(Number(weight) || 500)),
    length: 20, width: 15, height: 10,
    insurance_value: Math.min(Math.round(insuranceValue), 5000000)
  };
  const data = await ghn('/v2/shipping-order/fee', { body, withShop: true });

  let eta;
  try {
    const lt = await ghn('/v2/shipping-order/leadtime', {
      body: {
        from_district_id: body.from_district_id, from_ward_code: body.from_ward_code,
        to_district_id: body.to_district_id, to_ward_code: body.to_ward_code,
        service_id: service.service_id
      },
      withShop: true
    });
    if (lt?.leadtime) eta = new Date(lt.leadtime * 1000);
  } catch (_) { /* leadtime is optional */ }

  return {
    provider: NAME,
    carrier: CARRIER_LABEL,
    fee: Number(data.total) || 0,
    serviceId: service.service_id,
    serviceTypeId: service.service_type_id || 2,
    expectedDeliveryTime: eta
  };
}

async function createShipment({ order, from, to, weight, codAmount, items }) {
  const body = {
    payment_type_id: 1, // shop pays carrier (buyer already paid shipping to platform)
    required_note: 'CHOXEMHANGKHONGTHU',
    client_order_code: order._id.toString(),
    from_name: from.fullName, from_phone: from.phone, from_address: from.street,
    from_ward_name: from.wardName, from_district_name: from.districtName, from_province_name: from.provinceName,
    to_name: to.fullName, to_phone: to.phone, to_address: [to.street, to.wardName, to.districtName, to.provinceName].filter(Boolean).join(', '),
    to_ward_code: String(to.wardCode), to_district_id: Number(to.districtId),
    cod_amount: Math.round(codAmount || 0),
    weight: Math.max(1, Math.round(Number(weight) || 500)),
    length: 20, width: 15, height: 10,
    insurance_value: Math.min(Math.round(order.itemsSubtotal || 0), 5000000),
    service_type_id: order.shippingService?.serviceTypeId || 2,
    items: (items || []).map((i) => ({
      name: (i.name || 'Sản phẩm').slice(0, 100),
      quantity: i.quantity || 1,
      price: Math.round(i.price || 0),
      weight: Math.max(1, Math.round(i.weight || 500))
    }))
  };
  const data = await ghn('/v2/shipping-order/create', { body, withShop: true });
  return {
    provider: NAME,
    carrier: CARRIER_LABEL,
    trackingCode: data.order_code,
    fee: Number(data.total_fee) || 0,
    expectedDeliveryTime: data.expected_delivery_time ? new Date(data.expected_delivery_time) : undefined,
    raw: data
  };
}

module.exports = {
  NAME, CARRIER_LABEL,
  isConfigured: () => Boolean(TOKEN && SHOP_ID),
  calculateFee, createShipment, getProvinces, getDistricts, getWards
};
</file>

<file path="backend/services/shipping/index.js">
/**
 * Shipping service facade.
 * Chooses provider by SHIPPING_PROVIDER env (`ghn` | `mock`). Falls back to mock
 * automatically if GHN credentials are missing so local dev never breaks.
 */
const mongoose = require('mongoose');
const User = require('../../models/User');
const { Post } = require('../../models/Product');
const { isCompleteAddress, formatAddress } = require('../../models/schemas/Address');
const { productOwnerId } = require('../../utils/b2c');
const ghn = require('./ghnProvider');
const mock = require('./mockProvider');

function provider() {
  const wanted = (process.env.SHIPPING_PROVIDER || '').toLowerCase();
  if (wanted === 'mock') return mock;
  if (ghn.isConfigured()) return ghn;
  if (wanted === 'ghn') {
    console.warn('⚠️ [Shipping] SHIPPING_PROVIDER=ghn but GHN_TOKEN/GHN_SHOP_ID missing → using mock provider');
  }
  return mock;
}

class ShippingError extends Error {
  constructor(message, code, status = 400) {
    super(message);
    this.code = code;
    this.status = status;
  }
}

function sellerOrigin(seller) {
  const p = seller?.shopInfo?.pickupAddress;
  if (isCompleteAddress(p)) {
    return {
      fullName: p.fullName || seller.shopInfo?.shopName || seller.name,
      phone: p.phone || seller.shopInfo?.phone || seller.phone,
      street: p.street,
      provinceId: p.provinceId, provinceName: p.provinceName,
      districtId: p.districtId, districtName: p.districtName,
      wardCode: p.wardCode, wardName: p.wardName
    };
  }

  // Fallback to seller default address in address book if available
  const def = (seller?.addresses || []).find((a) => a.isDefault) || (seller?.addresses || [])[0];
  if (isCompleteAddress(def)) {
    return {
      fullName: def.fullName || seller.shopInfo?.shopName || seller.name,
      phone: def.phone || seller.shopInfo?.phone || seller.phone,
      street: def.street,
      provinceId: def.provinceId, provinceName: def.provinceName,
      districtId: def.districtId, districtName: def.districtName,
      wardCode: def.wardCode, wardName: def.wardName
    };
  }

  // If in mock mode, provide safe default origin warehouse so demo/test orders can always be prepared
  if (provider().NAME === 'mock') {
    return {
      fullName: seller?.shopInfo?.shopName || seller?.name || 'Kho Tổng HaiHand',
      phone: seller?.shopInfo?.phone || seller?.phone || '0901234567',
      street: '123 Nguyễn Huệ',
      provinceId: 202, provinceName: 'Hồ Chí Minh',
      districtId: 1442, districtName: 'Quận 1',
      wardCode: '144201', wardName: 'Phường Bến Nghé'
    };
  }

  return null;
}

/**
 * Resolve a seller package from raw items, validating ownership/stock server-side.
 * @param {string} sellerId
 * @param {{productId:string, quantity:number}[]} rawItems
 */
async function resolvePackage(sellerId, rawItems) {
  if (!mongoose.Types.ObjectId.isValid(sellerId)) {
    throw new ShippingError('Mã người bán không hợp lệ', 'INVALID_SELLER');
  }
  const seller = await User.findById(sellerId).select('name phone shopInfo isSeller sellerStatus');
  if (!seller) throw new ShippingError('Không tìm thấy người bán', 'SELLER_NOT_FOUND', 404);

  const ids = (rawItems || []).map((i) => i.productId).filter((id) => mongoose.Types.ObjectId.isValid(id));
  const products = await Post.find({ _id: { $in: ids } });
  const byId = new Map(products.map((p) => [p._id.toString(), p]));

  let weight = 0;
  let subtotal = 0;
  const items = [];
  for (const raw of rawItems || []) {
    const p = byId.get(String(raw.productId));
    if (!p) continue;
    if (productOwnerId(p) !== String(sellerId)) {
      throw new ShippingError(`Sản phẩm "${p.name || p.title}" không thuộc shop này`, 'OWNER_MISMATCH');
    }
    const qty = Math.max(1, Math.floor(Number(raw.quantity) || 1));
    const unitWeight = Number(p.weight) || 500;
    weight += unitWeight * qty;
    subtotal += (Number(p.price) || 0) * qty;
    items.push({ product: p, quantity: qty, unitWeight });
  }
  if (items.length === 0) throw new ShippingError('Gói hàng không có sản phẩm hợp lệ', 'EMPTY_PACKAGE');

  return { seller, items, weight, subtotal };
}

/**
 * Quote one seller package.
 * @returns {Promise<{fee:number, provider:string, carrier:string, serviceId?:number, serviceTypeId?:number, expectedDeliveryTime?:Date, weight:number}>}
 */
async function quotePackage({ sellerId, items, toAddress }) {
  if (!isCompleteAddress(toAddress)) {
    throw new ShippingError('Địa chỉ nhận hàng chưa đầy đủ (Tỉnh/Quận/Phường)', 'INCOMPLETE_DESTINATION');
  }
  const pkg = await resolvePackage(sellerId, items);
  const from = sellerOrigin(pkg.seller);
  if (!from) {
    throw new ShippingError(
      `Shop "${pkg.seller.shopInfo?.shopName || pkg.seller.name}" chưa thiết lập địa chỉ lấy hàng`,
      'SELLER_NO_PICKUP_ADDRESS'
    );
  }
  const p = provider();
  try {
    const q = await p.calculateFee({ from, to: toAddress, weight: pkg.weight, insuranceValue: pkg.subtotal });
    return { ...q, weight: pkg.weight, subtotal: pkg.subtotal, pkg };
  } catch (err) {
    console.error(`[Shipping:${p.NAME}] calculateFee failed:`, err.message);
    throw new ShippingError('Không tính được phí vận chuyển: ' + err.message, 'PROVIDER_ERROR', 502);
  }
}

/** Create a carrier shipment for a persisted Order. */
async function createShipmentForOrder(order) {
  const seller = await User.findById(order.sellerId || order.seller).select('name phone shopInfo');
  const from = sellerOrigin(seller);
  if (!from) throw new ShippingError('Shop chưa thiết lập địa chỉ lấy hàng (Cài đặt Shop)', 'SELLER_NO_PICKUP_ADDRESS');
  const to = order.shippingAddress;
  if (!isCompleteAddress(to)) {
    throw new ShippingError('Đơn hàng thiếu địa chỉ giao hàng có cấu trúc, không thể tạo vận đơn tự động', 'INCOMPLETE_DESTINATION');
  }
  const weight = (order.orderItems || []).reduce((s, i) => s + (Number(i.weight) || 500) * (i.quantity || 1), 0) || 500;
  const codAmount = order.paymentMethod === 'COD' ? order.totalPrice : 0;

  const p = provider();
  try {
    return await p.createShipment({ order, from, to, weight, codAmount, items: order.orderItems });
  } catch (err) {
    console.error(`[Shipping:${p.NAME}] createShipment failed:`, err.message);
    throw new ShippingError('Đơn vị vận chuyển từ chối tạo vận đơn: ' + err.message, 'PROVIDER_ERROR', 502);
  }
}

module.exports = {
  provider,
  ShippingError,
  sellerOrigin,
  resolvePackage,
  quotePackage,
  createShipmentForOrder,
  formatAddress,
  getProvinces: () => provider().getProvinces(),
  getDistricts: (id) => provider().getDistricts(id),
  getWards: (id) => provider().getWards(id)
};
</file>

<file path="backend/services/shipping/mockProvider.js">
const crypto = require('crypto');
const loc = require('./vnLocations');

/**
 * Deterministic mock carrier ("HaiHand Express").
 * Fee model (approximates GHN standard service):
 *   same district   : 15,000đ
 *   same province   : 22,000đ
 *   same region     : 30,000đ
 *   cross region    : 38,000đ
 *   + 5,000đ per extra 500g above the first 500g (capped at 50kg billing)
 */
const NAME = 'mock';
const CARRIER_LABEL = 'HaiHand Express';

function baseFee(from, to) {
  if (Number(from.districtId) === Number(to.districtId)) return 15000;
  if (Number(from.provinceId) === Number(to.provinceId)) return 22000;
  if (loc.regionOf(from.provinceId) === loc.regionOf(to.provinceId)) return 30000;
  return 38000;
}

function etaDays(from, to) {
  if (Number(from.provinceId) === Number(to.provinceId)) return 1;
  if (loc.regionOf(from.provinceId) === loc.regionOf(to.provinceId)) return 2;
  return 4;
}

async function calculateFee({ from, to, weight }) {
  const grams = Math.min(Math.max(Number(weight) || 500, 1), 50000);
  const extraSteps = Math.max(0, Math.ceil((grams - 500) / 500));
  const fee = baseFee(from, to) + extraSteps * 5000;
  const eta = new Date(Date.now() + etaDays(from, to) * 86400000);
  return {
    provider: NAME,
    carrier: CARRIER_LABEL,
    fee,
    serviceId: 53320,
    serviceTypeId: 2,
    expectedDeliveryTime: eta
  };
}

async function createShipment({ order, from, to, weight, codAmount }) {
  const quote = await calculateFee({ from, to, weight });
  const trackingCode = 'HHX' + crypto.randomBytes(4).toString('hex').toUpperCase();
  return {
    provider: NAME,
    carrier: CARRIER_LABEL,
    trackingCode,
    fee: quote.fee,
    expectedDeliveryTime: quote.expectedDeliveryTime,
    raw: { mock: true, clientOrderCode: order._id.toString(), codAmount }
  };
}

async function getProvinces() {
  return loc.provinces.map(({ id, name }) => ({ id, name, ProvinceID: id, ProvinceName: name }));
}
async function getDistricts(provinceId) {
  return (loc.districtsByProvince[Number(provinceId)] || []).map((d) => ({
    ...d,
    DistrictID: d.id,
    DistrictName: d.name
  }));
}
async function getWards(districtId) {
  return (loc.wardsByDistrict[Number(districtId)] || []).map((w) => ({
    ...w,
    WardCode: w.code,
    WardName: w.name
  }));
}

module.exports = { NAME, CARRIER_LABEL, calculateFee, createShipment, getProvinces, getDistricts, getWards };
</file>

