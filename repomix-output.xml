<file path="backend/views/users.ejs">
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>AdminPro - Quản lý người dùng</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 flex min-h-screen font-sans">
    
    <%- include('partials/sidebar') %>

    <div class="flex-1 p-10 h-screen overflow-y-auto">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-3xl font-bold text-slate-800">👥 Quản lý người dùng</h2>
            
            <div class="relative w-80">
                <input type="text" id="userSearch" onkeyup="filterUsers()" placeholder="Tìm tên, email, số điện thoại..." 
                       class="w-full px-4 py-2 pl-10 border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                <span class="absolute left-3 top-2.5 text-slate-400">🔍</span>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
            <table class="w-full text-left border-collapse" id="userTable">
                <thead class="bg-slate-50 border-b border-slate-200">
                    <tr>
                        <th class="p-4 font-bold text-slate-600 uppercase text-xs">Họ tên</th>
                        <th class="p-4 font-bold text-slate-600 uppercase text-xs">Liên hệ</th>
                        <th class="p-4 font-bold text-slate-600 uppercase text-xs">Vai trò</th>
                        <th class="p-4 font-bold text-slate-600 uppercase text-xs">Ngày tham gia</th>
                        <th class="p-4 font-bold text-slate-600 uppercase text-xs text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(user => { %>
                    <tr class="border-b border-slate-100 hover:bg-slate-50 transition user-row">
                        <td class="p-4 font-bold text-slate-700"><%= user.name %></td>
                        <td class="p-4 text-sm text-slate-600">
                            📧 <%= user.email %><br>
                            📞 <%= user.phone || 'Chưa cập nhật' %>
                        </td>
                        <td class="p-4">
                            <% if(user.role === 'Admin') { %>
                                <span class="bg-purple-100 text-purple-700 px-2 py-1 rounded text-xs font-bold">Admin</span>
                            <% } else { %>
                                <span class="bg-gray-100 text-gray-700 px-2 py-1 rounded text-xs font-bold">Khách hàng</span>
                            <% } %>
                        </td>
                        <td class="p-4 text-sm text-slate-500">
                            <%= new Date(user.createdAt).toLocaleDateString('vi-VN') %>
                        </td>
                        <td class="p-4 text-center space-x-2">
                            <a href="/users/edit/<%= user._id %>" class="inline-block text-blue-500 hover:text-blue-700 font-bold bg-blue-50 px-3 py-1 rounded hover:bg-blue-100 transition">
                                ✏️ Sửa
                            </a>
                            <a href="/users/delete/<%= user._id %>" onclick="return confirm('Xóa người dùng này?')" class="inline-block text-red-500 hover:text-red-700 font-bold bg-red-50 px-3 py-1 rounded hover:bg-red-100 transition">
                                🗑 Xóa
                            </a>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
            
            <div id="noResults" class="hidden text-center py-10">
                <p class="text-slate-500 text-lg">Không tìm thấy người dùng nào phù hợp!</p>
            </div>
        </div>
    </div>

    <script>
        function filterUsers() {
            const input = document.getElementById("userSearch").value.toLowerCase();
            const rows = document.querySelectorAll(".user-row");
            let hasData = false;
            
            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                if (text.includes(input)) {
                    row.style.display = "";
                    hasData = true;
                } else {
                    row.style.display = "none";
                }
            });
            if (hasData) {
                document.getElementById("noResults").classList.add("hidden");
                document.getElementById("userTable").classList.remove("hidden");
            } else {
                document.getElementById("noResults").classList.remove("hidden");
                document.getElementById("userTable").classList.add("hidden");
            }
        }
    </script>
</body>
</html>
</file>

<file path="backend/views/withdrawals.ejs">
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Duyệt Giải Ngân - HaiHand Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap');
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-100 flex min-h-screen">
    
    <%- include('partials/sidebar', {active: 'withdrawals'}) %>

    <div class="flex-1 p-10 h-screen overflow-y-auto ml-64">
        <h2 class="text-3xl font-black text-slate-800 mb-8 tracking-tight">🏧 Quản lý Rút tiền (Giải ngân)</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
            <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-200 border-l-4 border-l-blue-500 hover:shadow-md transition">
                <h3 class="text-slate-500 font-bold text-xs uppercase tracking-wider">Lệnh chờ xử lý</h3>
                <p class="text-4xl font-black text-slate-800 mt-2"><%= typeof withdrawals !== 'undefined' ? withdrawals.length : 0 %></p>
            </div>
            <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-200 border-l-4 border-l-orange-500 bg-orange-50/30 hover:shadow-md transition">
                <h3 class="text-orange-600 font-bold text-xs uppercase tracking-wider">Tổng tiền cần giải ngân</h3>
                <p class="text-3xl font-black text-orange-700 mt-2">
                    <%= (typeof withdrawals !== 'undefined' ? withdrawals.reduce((sum, w) => sum + w.amount, 0) : 0).toLocaleString('vi-VN') %> đ
                </p>
            </div>
        </div>

        <div class="bg-white rounded-3xl shadow-sm border border-slate-200 overflow-hidden">
            <div class="p-6 border-b border-slate-50 bg-slate-50/50 flex justify-between items-center">
                <h3 class="text-lg font-bold text-slate-800 flex items-center">
                    <span class="mr-2">📄</span> Danh sách yêu cầu rút tiền
                </h3>
            </div>
            
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="text-slate-400 text-[10px] uppercase tracking-widest border-b border-slate-50 bg-slate-50/30">
                            <th class="px-6 py-4">Thời gian tạo</th>
                            <th class="px-6 py-4">Tài khoản User</th>
                            <th class="px-6 py-4 text-right">Số tiền rút</th>
                            <th class="px-6 py-4 text-center">Trạng thái</th>
                            <th class="px-6 py-4 text-center">Thao tác Kế toán</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        <% if (typeof withdrawals === 'undefined' || withdrawals.length === 0) { %>
                            <tr>
                                <td colspan="5" class="px-6 py-10 text-center text-slate-400 font-medium italic">Không có yêu cầu rút tiền nào đang chờ xử lý. Tuyệt vời!</td>
                            </tr>
                        <% } else { %>
                            <% withdrawals.forEach(req => { %>
                                <tr class="hover:bg-slate-50/80 transition group">
                                    <td class="px-6 py-4 text-xs text-slate-500">
                                        <%= new Date(req.createdAt).toLocaleString('vi-VN', {hour: '2-digit', minute:'2-digit', day:'2-digit', month:'2-digit', year:'numeric'}) %>
                                    </td>
                                    <td class="px-6 py-4">
                                        <p class="font-bold text-slate-700 text-sm"><%= req.user?.name || 'Tài khoản ẩn danh' %></p>
                                        <p class="text-[10px] text-slate-400">Mã lệnh: #<%= req._id.toString().slice(-6).toUpperCase() %></p>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <span class="text-orange-600 font-black text-sm">-<%= req.amount.toLocaleString('vi-VN') %> đ</span>
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                        <span class="bg-yellow-100 text-yellow-700 px-3 py-1 rounded-lg text-[10px] font-black border border-yellow-200">ĐANG XỬ LÝ</span>
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                        <button onclick="approveWithdraw('<%= req._id %>')" class="text-[10px] font-black text-white bg-green-500 px-4 py-2 rounded-xl hover:bg-green-600 shadow-sm shadow-green-100 transition transform hover:scale-105">
                                            ✅ ĐÃ CHUYỂN TIỀN
                                        </button>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        async function approveWithdraw(id) {
            
            if(confirm('⚠️ XÁC NHẬN NGHIỆP VỤ:\nBạn ĐÃ DÙNG APP NGÂN HÀNG để chuyển tiền mặt cho khách hàng này chưa?\n\nHành động này không thể hoàn tác!')) {
                try {
                    const res = await fetch(`/api/admin/withdraw/${id}/approve`, { method: 'PUT' });
                    if(res.ok) {
                        alert('🎉 Đã xác nhận giải ngân thành công! Ví của khách hàng đã cập nhật trạng thái.');
                        location.reload(); 
                    } else {
                        alert('❌ Có lỗi xảy ra, vui lòng thử lại!');
                    }
                } catch(err) {
                    alert('❌ Mất kết nối tới máy chủ!');
                }
            }
        }
    </script>
</body>
</html>
</file>

