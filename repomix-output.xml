<file path="frontend/src/components/ConfirmModal.js">
import React, { createContext, useContext, useState, useCallback } from 'react';

const ConfirmContext = createContext();

export const useConfirm = () => useContext(ConfirmContext);

export const ConfirmProvider = ({ children }) => {
  const [confirmState, setConfirmState] = useState({
    isOpen: false,
    title: 'Xác nhận',
    message: '',
    confirmText: 'Đồng ý',
    cancelText: 'Hủy',
    resolve: null
  });

  /**
   * Hỗ trợ truyền vào 1 chuỗi String HOẶC 1 object cấu hình { title, message, confirmText, cancelText }
   * Đảm bảo các trường lưu trong state luôn là kiểu String nguyên thủy để không gây crash React.
   */
  const confirm = useCallback((optionsOrMessage) => {
    return new Promise((resolve) => {
      if (typeof optionsOrMessage === 'object' && optionsOrMessage !== null) {
        setConfirmState({
          isOpen: true,
          title: String(optionsOrMessage.title || 'Xác nhận'),
          message: String(optionsOrMessage.message || ''),
          confirmText: String(optionsOrMessage.confirmText || 'Đồng ý'),
          cancelText: String(optionsOrMessage.cancelText || 'Hủy'),
          resolve
        });
      } else {
        setConfirmState({
          isOpen: true,
          title: 'Xác nhận',
          message: String(optionsOrMessage || ''),
          confirmText: 'Đồng ý',
          cancelText: 'Hủy',
          resolve
        });
      }
    });
  }, []);

  const handleConfirm = () => {
    if (confirmState.resolve) confirmState.resolve(true);
    setConfirmState({
      isOpen: false,
      title: 'Xác nhận',
      message: '',
      confirmText: 'Đồng ý',
      cancelText: 'Hủy',
      resolve: null
    });
  };

  const handleCancel = () => {
    if (confirmState.resolve) confirmState.resolve(false);
    setConfirmState({
      isOpen: false,
      title: 'Xác nhận',
      message: '',
      confirmText: 'Đồng ý',
      cancelText: 'Hủy',
      resolve: null
    });
  };

  return (
    <ConfirmContext.Provider value={confirm}>
      {children}
      {confirmState.isOpen && (
        <div className="fixed inset-0 z-[9999] flex items-center justify-center">
          <div
            className="absolute inset-0 bg-stone-900/40 backdrop-blur-sm"
            onClick={handleCancel}
          ></div>
          <div
            className="bg-white rounded-2xl shadow-2xl w-[90%] max-w-sm p-6 relative z-10 animate-in fade-in zoom-in duration-200"
            style={{ animation: 'toast-slide-down 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55)' }}
          >
            <div className="flex items-center gap-3 mb-4">
              <div className="w-10 h-10 rounded-full bg-orange-100 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" className="h-6 w-6 text-[#EA580C]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <h3 className="text-lg font-bold text-stone-800">{confirmState.title}</h3>
            </div>

            <p className="text-stone-600 mb-6 leading-relaxed">
              {confirmState.message}
            </p>

            <div className="flex justify-end gap-3">
              <button
                onClick={handleCancel}
                className="px-5 py-2.5 rounded-xl text-stone-600 font-bold hover:bg-stone-100 transition-colors"
              >
                {confirmState.cancelText}
              </button>
              <button
                onClick={handleConfirm}
                className="px-5 py-2.5 rounded-xl bg-[#FACC15] text-[#1C1917] font-bold hover:bg-[#EAB308] shadow-sm transition-colors"
              >
                {confirmState.confirmText}
              </button>
            </div>
          </div>
        </div>
      )}
    </ConfirmContext.Provider>
  );
};
</file>

<file path="frontend/src/components/FloatingAdminChat.js">
import React, { useState, useEffect, useRef } from 'react';
import { useNavigate } from 'react-router-dom';
import axios from 'axios';
import { useSocket } from '../context/SocketContext';
import { useToast } from './Toast';


const FloatingAdminChat = () => {
    const toast = useToast();
    const navigate = useNavigate();
    
    
    const [isHidden, setIsHidden] = useState(false); 
    const [isOpen, setIsOpen] = useState(false);
    const [adminUser, setAdminUser] = useState(null);
    const [messages, setMessages] = useState([]);
    const [newMessage, setNewMessage] = useState('');
    
    const { socket } = useSocket();
    const scrollRef = useRef();
    
    const currentUser = React.useMemo(() => {
        const stored = localStorage.getItem('user');
        return stored && stored !== "undefined" ? JSON.parse(stored) : null;
    }, []);
    const API_URL = process.env.REACT_APP_API_URL || 'http://localhost:4000';

    const isEmbedded = window.self !== window.top;
    const isAdmin = currentUser?.role === 'Admin';

    
    
    
    useEffect(() => {
        if (isAdmin || isEmbedded) return; 
        const fetchAdmin = async () => {
            try {
                const { data } = await axios.get(`${API_URL}/api/admin/contact`);
                setAdminUser(data);
            } catch (err) { console.error("Chưa có Admin CSKH"); }
        };
        fetchAdmin();
    }, [isAdmin, isEmbedded, API_URL]);

    useEffect(() => {
        if (isOpen && currentUser && adminUser && !isEmbedded) {
            axios.get(`${API_URL}/api/messages/${currentUser._id}/${adminUser._id}`)
                .then(res => setMessages(res.data))
                .catch(err => console.log(err));

            if (!socket) return;

            const handleGetMessage = (data) => {
                if (data.senderId === adminUser._id) {
                    setMessages(prev => [...prev, { sender: data.senderId, content: data.text, createdAt: Date.now() }]);
                }
            };

            socket.on('getMessage', handleGetMessage);
            return () => {
                socket.off('getMessage', handleGetMessage);
            };
        }
    }, [isOpen, currentUser, adminUser, isEmbedded, API_URL, socket]);

    useEffect(() => { scrollRef.current?.scrollIntoView({ behavior: 'smooth' }); }, [messages, isOpen]);

    
    if (isAdmin || isEmbedded || isHidden) return null;

    const handleToggle = (e) => {
        if (!currentUser) {
            toast.warning('Yêu cầu đăng nhập', "Bác vui lòng đăng nhập để chat với Hỗ trợ viên nhé!");
            navigate('/login');
            return;
        }
        if (!adminUser) {
            toast.info('Thông báo', "Hệ thống hiện tại chưa có Admin trực ban!");
            return;
        }
        setIsOpen(!isOpen);
    };

    const handleSendMessage = async (e) => {
        e.preventDefault();
        if (!newMessage.trim()) return;

        const messageData = new FormData();
        messageData.append('senderId', currentUser._id);
        messageData.append('receiverId', adminUser._id);
        messageData.append('text', newMessage);

        try {
            const { data } = await axios.post(`${API_URL}/api/messages`, messageData);
            if (socket) {
                socket.emit('sendMessage', { senderId: currentUser._id, receiverId: adminUser._id, text: newMessage });
            }
            setMessages(prev => [...prev, data]);
            setNewMessage('');
        } catch (err) { console.error("Lỗi gửi tin:", err); }
    };

    return (
        
        <div style={{ position: 'fixed', bottom: '30px', right: '30px', zIndex: 9999 }}>
            
            
            {isOpen && (
                <div className="bg-white shadow-lg rounded-4 overflow-hidden d-flex flex-column mb-3 position-relative" 
                     style={{ width: '350px', height: '450px', border: '1px solid #ddd', transition: 'opacity 0.3s' }}>
                    
                    <div className="bg-warning px-3 py-2 d-flex justify-content-between align-items-center shadow-sm">
                        <div className="d-flex align-items-center gap-2">
                            <div className="bg-white rounded-circle d-flex justify-content-center align-items-center fw-bold text-warning" style={{width:'35px', height:'35px'}}>🎧</div>
                            <div>
                                <h6 className="fw-bold mb-0 text-dark">Hỗ trợ CSKH</h6>
                                <small className="text-dark fw-bold" style={{fontSize: '10px'}}>● Luôn luôn lắng nghe</small>
                            </div>
                        </div>
                        <button onClick={() => setIsOpen(false)} className="btn btn-sm text-dark fs-5 fw-bold">✕</button>
                    </div>

                    <div className="flex-grow-1 p-3 overflow-auto d-flex flex-column gap-2" style={{ backgroundColor: '#f4f4f4' }}>
                        <div className="text-center mb-2"><small className="bg-secondary text-white px-2 py-1 rounded-pill" style={{fontSize: '10px'}}>Trò chuyện với Admin</small></div>
                        {messages.map((m, idx) => (
                            <div key={idx} ref={scrollRef} className={`d-flex ${m.sender === currentUser._id ? 'justify-content-end' : 'justify-content-start'}`}>
                                <div className={`p-2 rounded-3 shadow-sm ${m.sender === currentUser._id ? 'bg-warning text-dark' : 'bg-white text-dark'}`} style={{ maxWidth: '80%', fontSize: '14px', borderRadius: m.sender === currentUser._id ? '15px 15px 0 15px' : '15px 15px 15px 0' }}>
                                    {m.content}
                                </div>
                            </div>
                        ))}
                    </div>

                    <form onSubmit={handleSendMessage} className="p-2 bg-white border-top d-flex gap-2">
                        <input type="text" className="form-control rounded-pill bg-light border-0" placeholder="Nhập tin nhắn..." value={newMessage} onChange={(e) => setNewMessage(e.target.value)} style={{ fontSize: '14px' }} />
                        <button type="submit" className="btn btn-warning rounded-circle fw-bold shadow-sm d-flex justify-content-center align-items-center" style={{width: '40px', height: '40px'}}>➤</button>
                    </form>
                </div>
            )}

            
            <div className="position-absolute" style={{ bottom: '0', right: '0', width: '60px', height: '60px' }}>
                
                
                {!isOpen && (
                    <button 
                        onClick={(e) => { e.stopPropagation(); setIsHidden(true); }}
                        className="position-absolute bg-white text-danger rounded-circle border shadow-sm d-flex justify-content-center align-items-center hover-scale"
                        style={{ 
                            top: '-5px', left: '-5px', width: '22px', height: '22px', 
                            fontSize: '12px', fontWeight: 'black', zIndex: 10, cursor: 'pointer' 
                        }}
                        title="Tắt bong bóng Chat"
                    >
                        ✕
                    </button>
                )}

                
                <div 
                    onClick={handleToggle}
                    className="shadow-lg d-flex align-items-center justify-content-center w-100 h-100"
                    style={{
                        backgroundColor: '#ffc107', 
                        borderRadius: '50%',
                        cursor: 'pointer', 
                        transition: 'transform 0.2s', 
                        border: '3px solid white'
                    }}
                    onMouseOver={(e) => (e.currentTarget.style.transform = 'scale(1.1)')}
                    onMouseOut={(e) => (e.currentTarget.style.transform = 'scale(1)')}
                    title="Tư vấn chăm sóc khách hàng"
                >
                    {isOpen ? <span style={{ fontSize: '24px', fontWeight: 'bold' }}>✕</span> : <span style={{ fontSize: '28px' }}>🎧</span>}
                    
                    {!isOpen && <span className="position-absolute bg-success border border-2 border-white rounded-circle" style={{ top: '2px', right: '2px', width: '15px', height: '15px' }}></span>}
                </div>
            </div>

        </div>
    );
};

export default FloatingAdminChat;
</file>

<file path="frontend/src/components/FloatingAIChat.js">
import React, { useState, useEffect, useRef } from 'react';
import { useNavigate } from 'react-router-dom';
import axios from 'axios';

const FloatingAIChat = () => {
    const navigate = useNavigate();
    const [isOpen, setIsOpen] = useState(false);
    const [messages, setMessages] = useState([
        {
            sender: 'bot',
            text: 'Chào bạn! Mình là Trợ lý AI của sàn HaiHand 🤖. Bạn đang muốn tìm đồ gì, tầm giá bao nhiêu hoặc ở khu vực nào? Nhắn mình tìm giúp bạn nhé!',
            products: []
        }
    ]);
    const [input, setInput] = useState('');
    const [loading, setLoading] = useState(false);
    const messagesEndRef = useRef(null);

    const API_URL = process.env.REACT_APP_API_URL || 'http://localhost:4000';

    // Tự động cuộn xuống cuối khi có tin nhắn mới
    useEffect(() => {
        if (isOpen) {
            messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });
        }
    }, [messages, isOpen, loading]);

    const handleSend = async (messageText) => {
        const textToSend = messageText || input;
        if (!textToSend.trim() || loading) return;

        const messageToSend = textToSend.trim();
        const userMsg = { sender: 'user', text: messageToSend, products: [] };
        setMessages(prev => [...prev, userMsg]);
        setInput('');
        setLoading(true);

        try {
            // Lấy 6 tin nhắn gần nhất để làm ngữ cảnh hội thoại
            const historyToSend = messages
                .filter(m => m.text)
                .slice(-6)
                .map(m => ({
                    role: m.sender === 'user' ? 'user' : 'assistant',
                    content: m.text
                }));

            const res = await axios.post(`${API_URL}/api/chatbot/ask`, {
                message: messageToSend,
                history: historyToSend
            });

            const botReply = res.data.reply || 'Xin lỗi, mình chưa tìm thấy thông tin phù hợp.';
            const botProducts = res.data.products || [];

            setMessages(prev => [
                ...prev,
                { sender: 'bot', text: botReply, products: botProducts }
            ]);
        } catch (error) {
            console.error("Lỗi AI Chatbot:", error);
            setMessages(prev => [
                ...prev,
                {
                    sender: 'bot',
                    text: '⚠️ Trợ lý AI hiện đang tạm thời bận. Bạn vui lòng thử lại sau ít phút nhé!',
                    products: []
                }
            ]);
        } finally {
            setLoading(false);
        }
    };

    // Helper format chữ: biến **chữ đậm** thành <strong>
    const renderFormattedText = (content) => {
        if (!content) return null;
        const lines = content.split('\n');
        return lines.map((line, lineIdx) => {
            const parts = line.split(/(\*\*.*?\*\*)/g);
            return (
                <div key={lineIdx} style={{ minHeight: line.trim() ? 'auto' : '8px' }}>
                    {parts.map((part, pIdx) => {
                        if (part.startsWith('**') && part.endsWith('**')) {
                            return <strong key={pIdx} className="fw-bold">{part.slice(2, -2)}</strong>;
                        }
                        return <span key={pIdx}>{part}</span>;
                    })}
                </div>
            );
        });
    };

    return (
        <div style={{ zIndex: 99999 }}>
            {/* CỬA SỔ CHATBOX */}
            {isOpen && (
                <div 
                    className="shadow-2xl d-flex flex-column"
                    style={{
                        position: 'fixed',
                        bottom: '105px',
                        right: '30px',
                        width: '390px',
                        maxWidth: 'calc(100vw - 40px)',
                        height: '560px',
                        maxHeight: 'calc(100vh - 130px)',
                        backgroundColor: '#ffffff',
                        borderRadius: '20px',
                        overflow: 'hidden',
                        zIndex: 99999,
                        border: '1px solid #cbd5e1',
                        boxShadow: '0 20px 45px rgba(15, 23, 42, 0.25)'
                    }}
                >
                    {/* 1. Header (Cố định) */}
                    <div 
                        className="d-flex align-items-center justify-content-between px-3 py-3 text-white flex-shrink-0"
                        style={{
                            background: 'linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #d946ef 100%)'
                        }}
                    >
                        <div className="d-flex align-items-center gap-2">
                            <div 
                                className="bg-white rounded-circle d-flex align-items-center justify-content-center shadow-sm flex-shrink-0"
                                style={{ width: '38px', height: '38px', fontSize: '20px' }}
                            >
                                🤖
                            </div>
                            <div>
                                <h6 className="m-0 fw-bold" style={{ fontSize: '15px' }}>Trợ lý AI HaiHand</h6>
                                <div className="d-flex align-items-center gap-1" style={{ fontSize: '11px', opacity: 0.9 }}>
                                    <span className="bg-success rounded-circle" style={{ width: '7px', height: '7px' }}></span>
                                    <span>Qwen3-VL + RAG</span>
                                </div>
                            </div>
                        </div>
                        <button 
                            onClick={() => setIsOpen(false)}
                            className="btn btn-sm text-white rounded-circle d-flex align-items-center justify-content-center"
                            style={{ width: '30px', height: '30px', background: 'rgba(255,255,255,0.2)', border: 'none' }}
                            title="Đóng chat"
                        >
                            ✕
                        </button>
                    </div>

                    {/* 2. Vùng tin nhắn (Tự co giãn & cuộn mượt) */}
                    <div 
                        className="flex-grow-1 p-3"
                        style={{ 
                            backgroundColor: '#f8fafc', 
                            fontSize: '14px',
                            overflowY: 'auto',
                            minHeight: 0
                        }}
                    >
                        {messages.map((msg, idx) => (
                            <div 
                                key={idx} 
                                className={`d-flex mb-3 ${msg.sender === 'user' ? 'justify-content-end' : 'justify-content-start'}`}
                            >
                                {msg.sender === 'bot' && (
                                    <div 
                                        className="rounded-circle d-flex align-items-center justify-content-center me-2 flex-shrink-0 shadow-sm"
                                        style={{ width: '28px', height: '28px', backgroundColor: '#e0e7ff', fontSize: '14px' }}
                                    >
                                        🤖
                                    </div>
                                )}
                                <div style={{ maxWidth: '85%' }}>
                                    <div 
                                        className="p-3 shadow-sm"
                                        style={{
                                            borderRadius: msg.sender === 'user' ? '18px 18px 4px 18px' : '18px 18px 18px 4px',
                                            backgroundColor: msg.sender === 'user' ? '#6366f1' : '#ffffff',
                                            color: msg.sender === 'user' ? '#ffffff' : '#1e293b',
                                            lineHeight: '1.5'
                                        }}
                                    >
                                        {renderFormattedText(msg.text)}
                                    </div>

                                    {/* Danh sách thẻ sản phẩm kèm theo */}
                                    {msg.products && msg.products.length > 0 && (
                                        <div className="mt-2 d-flex flex-column gap-2">
                                            {msg.products.map((prod, pIdx) => (
                                                <div 
                                                    key={pIdx}
                                                    onClick={() => {
                                                        if (prod._id) navigate(`/post/${prod._id}`);
                                                    }}
                                                    className="bg-white border rounded-3 p-2 d-flex align-items-center gap-2 shadow-sm transition"
                                                    style={{ cursor: 'pointer', transition: 'transform 0.15s ease' }}
                                                    onMouseOver={e => e.currentTarget.style.transform = 'translateY(-2px)'}
                                                    onMouseOut={e => e.currentTarget.style.transform = 'translateY(0)'}
                                                >
                                                    {prod.image ? (
                                                        <img 
                                                            src={prod.image} 
                                                            alt={prod.name} 
                                                            className="rounded-2 object-fit-cover flex-shrink-0"
                                                            style={{ width: '52px', height: '52px' }}
                                                            onError={(e) => { e.target.src = 'https://via.placeholder.com/52'; }}
                                                        />
                                                    ) : (
                                                        <div 
                                                            className="rounded-2 bg-light d-flex align-items-center justify-content-center flex-shrink-0"
                                                            style={{ width: '52px', height: '52px', fontSize: '20px' }}
                                                        >
                                                            🛍️
                                                        </div>
                                                    )}
                                                    <div className="flex-grow-1 overflow-hidden">
                                                        <div className="fw-bold text-truncate" style={{ fontSize: '13px', color: '#1e293b' }}>
                                                            {prod.name}
                                                        </div>
                                                        <div className="text-danger fw-bold" style={{ fontSize: '12px' }}>
                                                            {prod.price ? Number(prod.price).toLocaleString('vi-VN') + ' đ' : 'Liên hệ'}
                                                        </div>
                                                        <div className="text-muted text-truncate" style={{ fontSize: '11px' }}>
                                                            📍 {prod.location || 'Toàn quốc'}
                                                        </div>
                                                    </div>
                                                </div>
                                            ))}
                                        </div>
                                    )}
                                </div>
                            </div>
                        ))}

                        {/* Loading indicator */}
                        {loading && (
                            <div className="d-flex align-items-center gap-2 text-muted mb-2 ps-2" style={{ fontSize: '12px' }}>
                                <span>🤖 AI đang tra cứu kho hàng...</span>
                                <div className="spinner-border spinner-border-sm text-primary" role="status"></div>
                            </div>
                        )}

                        <div ref={messagesEndRef} />
                    </div>

                    {/* 3. Gợi ý câu hỏi nhanh (Quick chips - Cố định rõ ràng) */}
                    <div 
                        className="px-3 py-2 bg-white border-top d-flex gap-2 flex-shrink-0"
                        style={{ overflowX: 'auto', whiteSpace: 'nowrap' }}
                    >
                        <button 
                            onClick={() => handleSend("Liệt kê các loại xe có tại cửa hàng")}
                            className="btn btn-sm btn-outline-primary rounded-pill py-1 px-2 border"
                            style={{ fontSize: '11px', whiteSpace: 'nowrap' }}
                        >
                            🚗 Các loại xe
                        </button>
                        <button 
                            onClick={() => handleSend("Kiếm cho tôi xe đạp dưới 3tr")}
                            className="btn btn-sm btn-outline-secondary rounded-pill py-1 px-2 border"
                            style={{ fontSize: '11px', whiteSpace: 'nowrap' }}
                        >
                            🚲 Xe đạp &lt; 3tr
                        </button>
                        <button 
                            onClick={() => handleSend("Có mô hình lắp ráp nào không?")}
                            className="btn btn-sm btn-outline-secondary rounded-pill py-1 px-2 border"
                            style={{ fontSize: '11px', whiteSpace: 'nowrap' }}
                        >
                            🧩 Mô hình lắp ráp
                        </button>
                    </div>

                    {/* 4. Vùng nhập liệu (Cố định) */}
                    <form 
                        onSubmit={(e) => { e.preventDefault(); handleSend(); }} 
                        className="p-2 bg-white border-top d-flex gap-2 align-items-center flex-shrink-0"
                    >
                        <input 
                            type="text" 
                            className="form-control rounded-pill bg-light border-0 px-3" 
                            placeholder="Nhập tên món đồ cần tìm..." 
                            value={input} 
                            onChange={(e) => setInput(e.target.value)} 
                            disabled={loading}
                            style={{ fontSize: '13px' }} 
                        />
                        <button 
                            type="submit" 
                            disabled={loading || !input.trim()}
                            className="btn rounded-circle text-white shadow-sm d-flex justify-content-center align-items-center flex-shrink-0" 
                            style={{ 
                                width: '38px', 
                                height: '38px', 
                                background: 'linear-gradient(135deg, #6366f1, #d946ef)',
                                border: 'none'
                            }}
                        >
                            ➤
                        </button>
                    </form>
                </div>
            )}

            {/* NÚT TRÒN BONG BÓNG AI (CỐ ĐỊNH TRÊN NÚT TAI NGHE) */}
            <div 
                style={{ 
                    position: 'fixed',
                    right: '30px',
                    bottom: '105px',
                    width: '60px', 
                    height: '60px',
                    zIndex: 99998
                }}
            >
                <div 
                    onClick={() => setIsOpen(!isOpen)}
                    className="shadow-lg d-flex align-items-center justify-content-center w-100 h-100 position-relative"
                    style={{
                        background: isOpen 
                            ? '#64748b' 
                            : 'linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #d946ef 100%)', 
                        borderRadius: '50%',
                        cursor: 'pointer', 
                        transition: 'all 0.25s cubic-bezier(0.4, 0, 0.2, 1)', 
                        border: '3px solid white',
                        boxShadow: '0 8px 25px rgba(99, 102, 241, 0.45)'
                    }}
                    onMouseOver={(e) => e.currentTarget.style.transform = 'scale(1.1)'}
                    onMouseOut={(e) => e.currentTarget.style.transform = 'scale(1)'}
                    title="Trợ lý AI HaiHand - Bấm để tư vấn & tìm đồ"
                >
                    {isOpen ? (
                        <span style={{ fontSize: '22px', color: '#fff', fontWeight: 'bold' }}>✕</span>
                    ) : (
                        <div className="d-flex flex-column align-items-center justify-content-center text-white">
                            <span style={{ fontSize: '24px', lineHeight: '1' }}>🤖</span>
                            <span style={{ fontSize: '9px', fontWeight: 'bold', letterSpacing: '0.5px' }}>AI</span>
                        </div>
                    )}

                    {/* Dấu chấm phát sáng online */}
                    {!isOpen && (
                        <span 
                            className="position-absolute bg-info border border-2 border-white rounded-circle shadow-sm" 
                            style={{ top: '2px', right: '2px', width: '15px', height: '15px' }}
                        ></span>
                    )}
                </div>
            </div>
        </div>
    );
};

export default FloatingAIChat;
</file>

