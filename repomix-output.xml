        await axios.put(`${API_URL}/api/posts/${id}`, data);
        toast.success('Thành công', "Cập nhật tin thành công và đang chờ duyệt!");
        navigate('/profile');
    } catch (error) { 
        console.error("Lỗi đăng bài:", error);
