const jwt = require('jsonwebtoken');

const JWT_SECRET = process.env.JWT_SECRET || 'secret123';

const CATALOG_VISIBLE = ['active', 'APPROVED'];

const STATUS_TO_CANONICAL = {
  'Chờ xác nhận': 'Pending',
  'Chờ thanh toán VNPay': 'Pending',
  'Đã thanh toán (Admin giữ tiền)': 'Pending',
  'Người bán đã chuẩn bị hàng': 'Processing',
  'Đang giao hàng': 'Shipped',
  'Đang giao': 'Shipped',
  'Hoàn thành': 'Completed',
  'Đã thanh toán cho người bán': 'Completed',
  'Đã hủy': 'Cancelled',
  'Đã hủy (Chờ hoàn tiền)': 'Cancelled',
  Pending: 'Pending',
  Processing: 'Processing',
  Shipped: 'Shipped',
  Delivered: 'Delivered',
  Completed: 'Completed',
  Cancelled: 'Cancelled'
};

function canonicalStatus(status) {
  return STATUS_TO_CANONICAL[status] || status || 'Pending';
}

function productOwnerId(product) {
  if (!product) return '';
  const id = product.sellerId || product.author;
  return id ? id.toString() : '';
}

function orderBuyerId(order) {
  if (!order) return null;
  return order.buyerId || order.buyer;
}

function orderSellerId(order) {
  if (!order) return null;
  return order.sellerId || order.seller;
}

function isEscrow(order) {
  return order.paymentStatus === 'escrow' || order.status === 'Đã thanh toán (Admin giữ tiền)';
}

function sanitizeUser(user) {
  if (!user) return null;
  const o = typeof user.toObject === 'function' ? user.toObject() : { ...user };
  delete o.password;
  return o;
}

function signUserToken(user) {
  return jwt.sign(
    {
      id: user._id,
      role: user.role,
      isSeller: !!user.isSeller,
      sellerStatus: user.sellerStatus || 'none'
    },
    JWT_SECRET,
    { expiresIn: '7d' }
  );
}

function displayProductName(product) {
  if (!product) return 'Sản phẩm';
  return product.name || product.title || 'Sản phẩm';
}

module.exports = {
  JWT_SECRET,
  CATALOG_VISIBLE,
  canonicalStatus,
  productOwnerId,
  orderBuyerId,
  orderSellerId,
  isEscrow,
  sanitizeUser,
  signUserToken,
  displayProductName
};
</file>

<file path="backend/utils/otpService.js">
const crypto = require('crypto');
const bcrypt = require('bcryptjs');
const nodemailer = require('nodemailer');
const OtpToken = require('../models/OtpToken');

// Configure nodemailer transporter
const createTransporter = () => {
  const host = process.env.SMTP_HOST;
  const user = process.env.SMTP_USER;
  const pass = process.env.SMTP_PASS;

  if (host && user && pass) {
    return nodemailer.createTransport({
      host,
      port: Number(process.env.SMTP_PORT) || 587,
      secure: process.env.SMTP_SECURE === 'true',
      auth: { user, pass }
    });
  }

  // Fallback transporter (e.g. Gmail or simulated)
  if (process.env.EMAIL_USER && process.env.EMAIL_PASS) {
    return nodemailer.createTransport({
      service: 'gmail',
      auth: {
        user: process.env.EMAIL_USER,
        pass: process.env.EMAIL_PASS
      }
    });
  }

  return null;
};

const transporter = createTransporter();

/**
 * Generate 6-digit numeric OTP
 */
function generateNumericOtp(length = 6) {
  const min = Math.pow(10, length - 1);
  const max = Math.pow(10, length) - 1;
  return crypto.randomInt(min, max + 1).toString();
}

/**
 * Send OTP via Email / SMS simulation
 */
async function sendOtpEmail({ email, otp, purpose = 'LOGIN' }) {
  const purposeText = purpose === 'REGISTER' 
    ? 'Kích hoạt tài khoản Ví HaiPay' 
    : 'Đăng nhập vào Ví HaiPay';

  const htmlContent = `
    <div style="font-family: Arial, sans-serif; max-width: 520px; margin: 0 auto; padding: 24px; border: 1px solid #e2e8f0; border-radius: 16px; background-color: #ffffff;">
      <div style="text-align: center; margin-bottom: 20px;">
        <div style="display: inline-block; background-color: #0f172a; color: #facc15; font-weight: bold; font-size: 20px; padding: 10px 20px; border-radius: 9999px;">
          🛡️ HaiPay Wallet
        </div>
      </div>
      <h2 style="color: #0f172a; text-align: center; margin-bottom: 8px;">Mã xác thực OTP</h2>
      <p style="color: #64748b; font-size: 14px; text-align: center; margin-top: 0;">
        Yêu cầu: <strong>${purposeText}</strong>
      </p>
      
      <div style="background-color: #f8fafc; border: 2px dashed #cbd5e1; border-radius: 12px; padding: 20px; text-align: center; margin: 24px 0;">
        <span style="font-size: 36px; font-weight: 800; letter-spacing: 10px; color: #0284c7; font-family: monospace;">
          ${otp}
        </span>
      </div>

      <p style="color: #475569; font-size: 13px; line-height: 1.6;">
        ⏱️ Mã này có hiệu lực trong <strong>5 phút</strong>.<br>
        🔒 <strong>Bảo mật:</strong> Tuyệt đối không chia sẻ mã này cho bất kỳ ai, kể cả nhân viên HaiHand/HaiPay.
      </p>
      <hr style="border: none; border-top: 1px solid #f1f5f9; margin: 24px 0;">
      <p style="color: #94a3b8; font-size: 11px; text-align: center;">
        Nếu bạn không thực hiện yêu cầu này, vui lòng bỏ qua email hoặc liên hệ tổng đài 1900-6868.
      </p>
    </div>
  `;

  // Always log to console for instant developer feedback
  console.log('\n==============================================');
  console.log(`🔑 [HaiPay OTP Service] Code for ${email}: ${otp}`);
  console.log(`📌 Purpose: ${purpose} | Expires in: 5 minutes`);
  console.log('==============================================\n');

  if (transporter && email.includes('@')) {
    try {
      await transporter.sendMail({
        from: `"HaiPay Security" <${process.env.SMTP_USER || process.env.EMAIL_USER || 'no-reply@haihand.vn'}>`,
        to: email,
        subject: `[HaiPay] ${otp} là mã xác thực OTP của bạn`,
        html: htmlContent
      });
      return { sent: true };
    } catch (err) {
      console.warn('⚠️ SMTP sendMail warning (logged to console instead):', err.message);
      return { sent: false, error: err.message };
    }
  }

  return { sent: false, note: 'Logged to console' };
}

/**
 * Generate, hash, and persist OTP in database
 */
async function createAndSaveOtp(identifier, purpose = 'LOGIN') {
  const cleanIdentifier = identifier.trim().toLowerCase();
  
  // Clear any existing OTP for this identifier and purpose
  await OtpToken.deleteMany({ identifier: cleanIdentifier, purpose });

  const rawOtp = generateNumericOtp(6);
  const otpHash = await bcrypt.hash(rawOtp, 8);

  await OtpToken.create({
    identifier: cleanIdentifier,
    otpHash,
    purpose,
    attempts: 0
  });

  // Dispatch email/message
  await sendOtpEmail({ email: cleanIdentifier, otp: rawOtp, purpose });

  return rawOtp;
}

/**
 * Verify OTP against stored hash
 */
async function verifyOtp(identifier, rawOtp, purpose = 'LOGIN') {
  const cleanIdentifier = identifier.trim().toLowerCase();
  const tokenRecord = await OtpToken.findOne({ identifier: cleanIdentifier, purpose });

  if (!tokenRecord) {
    return { valid: false, message: 'Mã OTP đã hết hạn hoặc không tồn tại. Vui lòng lấy mã mới!' };
  }

  if (tokenRecord.attempts >= 5) {
    await OtpToken.deleteOne({ _id: tokenRecord._id });
    return { valid: false, message: 'Bạn đã nhập sai quá số lần quy định. Vui lòng yêu cầu mã mới!' };
  }

  const isMatch = await bcrypt.compare(rawOtp.trim(), tokenRecord.otpHash);
  if (!isMatch) {
    tokenRecord.attempts += 1;
    await tokenRecord.save();
    return { valid: false, message: 'Mã OTP không chính xác. Vui lòng thử lại!' };
  }

  // Consume OTP upon successful verification
  await OtpToken.deleteOne({ _id: tokenRecord._id });
  return { valid: true };
}

module.exports = {
  generateNumericOtp,
  sendOtpEmail,
  createAndSaveOtp,
  verifyOtp
};
</file>

<file path="backend/utils/vnpay.js">
const crypto = require('crypto');
const moment = require('moment');
const querystring = require('qs');

const vnp_TmnCode = process.env.VNP_TMNCODE || 'IYQYHLU4';
const vnp_HashSecret = process.env.VNP_HASHSECRET || 'BBZJECZFZLUQSVOBCVTQSPDPYQZKGUEB';
const vnp_Url = process.env.VNP_URL || 'https://sandbox.vnpayment.vn/paymentv2/vpcpay.html';
const vnp_ReturnUrl = process.env.VNP_RETURNURL || 'http://localhost:3000/haipay/return';

function sortObject(obj) {
  const sorted = {};
  const keys = [];
  for (const key in obj) {
    if (Object.prototype.hasOwnProperty.call(obj, key)) keys.push(encodeURIComponent(key));
  }
  keys.sort();
  for (const k of keys) {
    sorted[k] = encodeURIComponent(obj[k]).replace(/%20/g, '+');
  }
  return sorted;
}

function signParams(params) {
  const signData = querystring.stringify(sortObject(params), { encode: false });
  return crypto.createHmac('sha512', vnp_HashSecret).update(Buffer.from(signData, 'utf-8')).digest('hex');
}

/**
 * Legacy-tolerant verification: returns true when no hash is supplied.
 * Kept for backwards compatibility with old callers.
 */
function verifyVnpayChecksum(params, secureHash) {
  if (!secureHash) return true;
  return verifyVnpayChecksumStrict(params, secureHash);
}

/** Strict verification: a missing hash is a failure. */
function verifyVnpayChecksumStrict(params, secureHash) {
  if (!secureHash || !params) return false;
  const p = { ...params };
  delete p.vnp_SecureHash;
  delete p.vnp_SecureHashType;
  return secureHash.toLowerCase() === signParams(p).toLowerCase();
}

function buildVnpayPaymentUrl({ orderId, amount, ipAddr = '127.0.0.1', orderInfo, returnUrl }) {
  const params = {
    vnp_Version: '2.1.0',
    vnp_Command: 'pay',
    vnp_TmnCode: vnp_TmnCode,
    vnp_Locale: 'vn',
    vnp_CurrCode: 'VND',
    vnp_TxnRef: orderId.toString(),
    vnp_OrderInfo: orderInfo || ('Thanh toan don hang HaiHand ' + orderId),
    vnp_OrderType: 'other',
    vnp_Amount: Math.round(Number(amount) * 100),
    vnp_ReturnUrl: returnUrl || vnp_ReturnUrl,
    vnp_IpAddr: ipAddr,
    vnp_CreateDate: moment(new Date()).format('YYYYMMDDHHmmss')
  };
  const sorted = sortObject(params);
  sorted.vnp_SecureHash = signParams(params);
  return vnp_Url + '?' + querystring.stringify(sorted, { encode: false });
}

function normalizeIp(req) {
  let ip = req.headers['x-forwarded-for'] || req.socket?.remoteAddress || '127.0.0.1';
  ip = ip.toString().split(',')[0].trim();
  if (ip.startsWith('::ffff:')) ip = ip.slice(7);
  if (ip === '::1') ip = '127.0.0.1';
  return ip;
}

module.exports = {
  vnp_TmnCode,
  vnp_HashSecret,
  vnp_Url,
  vnp_ReturnUrl,
  sortObject,
  signParams,
  verifyVnpayChecksum,
  verifyVnpayChecksumStrict,
  buildVnpayPaymentUrl,
  normalizeIp
};
</file>

