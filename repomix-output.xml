          rows.push({
            productId,
            image: `images/${file}`,
            title: String(product.title || product.name || '').slice(0, 200),
            category: String(product.category || '').slice(0, 100)
          });
        } catch (error) {
          failed++;
          console.warn(`Bỏ qua ảnh ${productId}/${imageIndex}: ${error.message}`);
        }
