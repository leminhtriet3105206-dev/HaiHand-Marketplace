    await user.save();
    res.json({ message: user.isBanned ? 'Đã khóa tài khoản!' : 'Đã mở khóa tài khoản!', isBanned: user.isBanned });
  } catch (error) { res.status(500).json({ message: 'Lỗi server' }); }
});

