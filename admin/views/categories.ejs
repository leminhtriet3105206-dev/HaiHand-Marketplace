<!-- CATEGORIES VIEW (Inner Content Only for AdminLayout Outlet) -->
<div class="space-y-6">
    
    <!-- Title & Description -->
    <div>
        <div class="flex items-center gap-2.5">
            <h2 class="text-2xl lg:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
                📁 Quản Lý Danh Mục
            </h2>
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-purple-100 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 border border-purple-200/60 dark:border-purple-800">
                <%= typeof categories !== 'undefined' ? categories.length : 0 %> Danh mục
            </span>
        </div>
        <p class="text-slate-500 dark:text-slate-400 text-xs mt-1 font-medium">
            Quản trị các nhóm ngành hàng hóa trên toàn bộ sàn thương mại HaiHand.
        </p>
    </div>

    <!-- Layout: Add Category Form (Left) & Category List Table (Right) -->
    <div class="flex flex-col lg:flex-row gap-6">
        
        <!-- Add Category Form Card -->
        <div class="lg:w-1/3">
            <div class="bg-white dark:bg-slate-900 rounded-3xl shadow-sm border border-slate-200/80 dark:border-slate-800 overflow-hidden transition-colors duration-200">
                <div class="bg-gradient-to-r from-purple-600 to-indigo-600 text-white font-bold p-5 flex items-center justify-between">
                    <span class="text-sm font-extrabold">➕ Thêm danh mục mới</span>
                    <span class="text-xs opacity-75">B2C & C2C</span>
                </div>
                <div class="p-6">
                    <form action="/categories/add" method="POST" enctype="multipart/form-data" class="space-y-4">
                        <div>
                            <label class="block font-bold text-slate-700 dark:text-slate-300 text-xs mb-1.5">Tên danh mục <span class="text-rose-500">*</span></label>
                            <input 
                                type="text" 
                                class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 text-slate-800 dark:text-slate-100 text-xs rounded-2xl border border-slate-200 dark:border-slate-700 focus:border-purple-400 dark:focus:border-purple-500 focus:ring-4 focus:ring-purple-500/15 outline-none transition" 
                                name="name" 
                                placeholder="Ví dụ: Đồ điện tử, Thời trang..." 
                                required 
                            />
                        </div>
                        
                        <div>
                            <label class="block font-bold text-slate-700 dark:text-slate-300 text-xs mb-1.5">Mô tả danh mục</label>
                            <textarea 
                                class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 text-slate-800 dark:text-slate-100 text-xs rounded-2xl border border-slate-200 dark:border-slate-700 focus:border-purple-400 dark:focus:border-purple-500 focus:ring-4 focus:ring-purple-500/15 outline-none transition" 
                                name="description" 
                                rows="3" 
                                placeholder="Mô tả tóm tắt phân loại..."
                            ></textarea>
                        </div>

                        <div>
                            <label class="block font-bold text-slate-700 dark:text-slate-300 text-xs mb-1.5">Icon / Ảnh đại diện</label>
                            <input 
                                type="file" 
                                class="w-full text-xs text-slate-500 dark:text-slate-400 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-purple-50 dark:file:bg-purple-950/60 file:text-purple-700 dark:file:text-purple-300 hover:file:bg-purple-100 transition" 
                                name="image" 
                                accept="image/*" 
                                required 
                            />
                        </div>

                        <button 
                            type="submit" 
                            class="w-full bg-purple-600 hover:bg-purple-700 text-white font-bold py-3 rounded-2xl shadow-md shadow-purple-500/25 transition-all text-xs hover:scale-[1.01]"
                        >
                            + Lưu Danh Mục Mới
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Category Table Card -->
        <div class="lg:w-2/3">
            <div class="bg-white dark:bg-slate-900 rounded-3xl shadow-sm border border-slate-200/80 dark:border-slate-800 overflow-hidden transition-colors duration-200">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200/80 dark:border-slate-800 text-slate-500 dark:text-slate-400 font-bold uppercase text-[11px] tracking-wider">
                                <th class="p-4 pl-6 text-center w-12">#</th>
                                <th class="p-4">Icon</th>
                                <th class="p-4">Tên danh mục</th>
                                <th class="p-4 text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 text-xs">
                            <% if (typeof categories !== 'undefined' && categories && categories.length > 0) { %>
                                <% categories.forEach((cat, index) => { %>
                                <tr class="hover:bg-purple-50/40 dark:hover:bg-slate-800/50 transition-colors">
                                    <td class="p-4 pl-6 text-center font-bold text-slate-400 dark:text-slate-500"><%= index + 1 %></td>
                                    <td class="p-4">
                                        <% 
                                            let catImg = 'https://upload.wikimedia.org/wikipedia/commons/1/14/No_Image_Available.jpg';
                                            if (cat.image) {
                                                let rawImg = String(cat.image).trim(); 
                                                if (rawImg.includes('http')) {
                                                    catImg = rawImg.substring(rawImg.indexOf('http'));
                                                } else {
                                                    catImg = '/uploads/' + rawImg.replace(/\\/g, '/');
                                                }
                                            }
                                        %>
                                        <img src="<%= catImg %>" onerror="this.src='https://upload.wikimedia.org/wikipedia/commons/1/14/No_Image_Available.jpg'" class="w-10 h-10 object-cover rounded-xl shadow-sm border border-slate-200/60 dark:border-slate-700" />
                                    </td>
                                    <td class="p-4">
                                        <p class="font-bold text-slate-800 dark:text-slate-100 text-sm"><%= cat.name %></p>
                                        <p class="text-[10px] text-slate-400 dark:text-slate-500 line-clamp-1 mt-0.5"><%= cat.description || 'Chưa có mô tả' %></p>
                                    </td>
                                    <td class="p-4 text-center space-x-1.5 whitespace-nowrap">
                                        <a href="/categories/edit/<%= cat._id %>" class="inline-flex items-center gap-1 text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/40 hover:bg-blue-100 dark:hover:bg-blue-900/60 border border-blue-200/60 dark:border-blue-800/60 px-3 py-1.5 rounded-xl font-bold transition text-xs">
                                            ✏️ Sửa
                                        </a>
                                        <a href="/categories/delete/<%= cat._id %>" class="inline-flex items-center gap-1 text-rose-600 dark:text-rose-400 bg-rose-50 dark:bg-rose-950/40 hover:bg-rose-100 dark:hover:bg-rose-900/60 border border-rose-200/60 dark:border-rose-800/60 px-3 py-1.5 rounded-xl font-bold transition text-xs" onclick="return confirm('Bạn có chắc chắn muốn xóa danh mục này?')">
                                            🗑️ Xóa
                                        </a>
                                    </td>
                                </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4" class="text-slate-400 dark:text-slate-500 text-center py-12 italic">Chưa có danh mục nào trong hệ thống.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>