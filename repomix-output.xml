                <div className="flex justify-between items-center">
                  <span className="text-stone-500">Lý do</span>
                  <span className="text-rose-700 font-medium text-right">
                    {VNPAY_RESPONSE_MESSAGES[responseCode] || 'Giao dịch bị từ chối'}
