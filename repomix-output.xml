                </h2>
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-purple-100 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 border border-purple-200/60 dark:border-purple-800">
                    #<%= user._id.toString().slice(-6).toUpperCase() %>
                </span>
            </div>
            <p class="text-slate-500 dark:text-slate-400 text-xs mt-1 font-medium">
                Cập nhật thông tin tài khoản và quyền hạn hệ thống.
            </p>
        </div>
        <a href="/users" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:text-purple-600 dark:hover:text-purple-400 hover:bg-purple-50 dark:hover:bg-slate-700/80 transition text-xs font-bold">
            <i class="fas fa-arrow-left text-[10px]"></i>
            <span>Quay lại</span>
        </a>
    </div>

    <!-- Edit Form Card -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl shadow-sm border border-slate-200/80 dark:border-slate-800 p-8 transition-colors duration-200">
        <form action="/users/edit/<%= user._id %>" method="POST" class="space-y-5">
            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">Họ và tên <span class="text-rose-500">*</span></label>
                <input 
                    type="text" 
                    name="name" 
                    value="<%= user.name %>" 
                    required
                    class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 text-slate-800 dark:text-slate-100 text-xs rounded-2xl border border-slate-200 dark:border-slate-700 focus:border-purple-400 dark:focus:border-purple-500 focus:ring-4 focus:ring-purple-500/15 outline-none transition"
                />
            </div>
            
            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">Địa chỉ Email <span class="text-rose-500">*</span></label>
                <input 
                    type="email" 
                    name="email" 
                    value="<%= user.email %>" 
                    required
                    class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 text-slate-800 dark:text-slate-100 text-xs rounded-2xl border border-slate-200 dark:border-slate-700 focus:border-purple-400 dark:focus:border-purple-500 focus:ring-4 focus:ring-purple-500/15 outline-none transition"
                />
            </div>
            
            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">Số điện thoại</label>
                <input 
                    type="text" 
                    name="phone" 
                    value="<%= user.phone || '' %>" 
                    placeholder="Chưa cập nhật SĐT"
                    class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 text-slate-800 dark:text-slate-100 text-xs rounded-2xl border border-slate-200 dark:border-slate-700 focus:border-purple-400 dark:focus:border-purple-500 focus:ring-4 focus:ring-purple-500/15 outline-none transition"
                />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">Vai trò hệ thống</label>
                <select 
                    name="role" 
                    class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 text-slate-800 dark:text-slate-100 text-xs rounded-2xl border border-slate-200 dark:border-slate-700 focus:border-purple-400 dark:focus:border-purple-500 focus:ring-4 focus:ring-purple-500/15 outline-none transition cursor-pointer"
                >
                    <option value="Khách hàng" <%= user.role === 'Khách hàng' ? 'selected' : '' %>>Khách hàng</option>
                    <option value="Admin" <%= user.role === 'Admin' ? 'selected' : '' %>>Admin (Quản trị viên)</option>
                </select>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">Trạng thái tài khoản</label>
                <select 
                    name="status" 
                    class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 text-slate-800 dark:text-slate-100 text-xs rounded-2xl border border-slate-200 dark:border-slate-700 focus:border-purple-400 dark:focus:border-purple-500 focus:ring-4 focus:ring-purple-500/15 outline-none transition cursor-pointer"
                >
                    <option value="active" <%= (user.status !== 'locked' && !user.isBanned) ? 'selected' : '' %>>✓ Hoạt động bình thường</option>
                    <option value="locked" <%= (user.status === 'locked' || user.isBanned) ? 'selected' : '' %>>🔒 Bị khóa (Banned)</option>
                </select>
            </div>

            <div class="pt-4 flex gap-3">
                <a href="/users" class="w-1/3 text-center bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-bold py-3 rounded-2xl transition text-xs">
                    Hủy bỏ
                </a>
                <button type="submit" class="w-2/3 bg-purple-600 hover:bg-purple-700 text-white font-bold py-3 rounded-2xl shadow-md shadow-purple-500/25 transition text-xs">
                    Lưu thay đổi
                </button>
            </div>
        </form>
    </div>

</div>
</file>

<file path="admin/views/home.ejs">
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>HaiHand Admin - Quản trị hệ thống</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 font-sans">
    
    <header class="bg-yellow-400 shadow-sm sticky top-0 z-50">
        <div class="container mx-auto px-6 py-4 flex justify-between items-center">
            <h1 class="text-2xl font-black text-slate-900">⚡ HaiHand System</h1>
            <% if (user) { %>
                <div class="flex items-center gap-4">
                    <span class="font-bold">Hi, <%= user.name %></span>
                    <a href="/" class="bg-slate-900 text-white px-4 py-2 rounded-lg font-bold hover:bg-slate-700">Vào trang Quản trị ➜</a>
                </div>
            <% } else { %>
                <a href="/login" class="bg-slate-900 text-white px-4 py-2 rounded-lg font-bold hover:bg-slate-700">Đăng nhập Admin</a>
            <% } %>
        </div>
    </header>

    <div class="bg-yellow-400 pb-16 pt-10 text-center text-slate-900">
        <h2 class="text-5xl font-black mb-4">Hệ thống quản lý HaiHand</h2>
        <p class="text-xl font-medium max-w-2xl mx-auto opacity-80">Nơi kiểm duyệt tin đăng, quản lý người dùng và vận hành sàn thương mại điện tử đồ cũ lớn nhất xóm.</p>
        
        <div class="mt-8 flex justify-center gap-4">
            <div class="bg-white px-6 py-3 rounded-xl shadow-lg">
                <p class="text-3xl font-bold text-yellow-600"><%= posts.length %></p>
                <p class="text-sm font-bold text-slate-500">Tin đã duyệt</p>
            </div>
            <div class="bg-white px-6 py-3 rounded-xl shadow-lg">
                <p class="text-3xl font-bold text-slate-900">24/7</p>
                <p class="text-sm font-bold text-slate-500">Hoạt động</p>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-6 py-12 -mt-10">
        <h3 class="text-xl font-bold text-slate-800 mb-6 flex items-center gap-2">
            <span class="bg-slate-900 text-yellow-400 px-3 py-1 rounded text-sm">New</span>
            Tin vừa được duyệt công khai
        </h3>
        
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
            <% if (posts.length === 0) { %>
                <p class="text-slate-500 col-span-4 text-center py-10 bg-white rounded-xl shadow">Chưa có tin đăng nào được duyệt.</p>
            <% } %>

            <% posts.forEach(post => { %>
            <div class="bg-white rounded-xl shadow-sm hover:shadow-xl transition duration-300 overflow-hidden border border-slate-100 group cursor-pointer">
                <div class="h-48 bg-gray-200 relative overflow-hidden">
                    <img src="<%= post.image ? '/uploads/' + post.image : 'https://via.placeholder.com/400x300?text=No+Image' %>" 
                         class="w-full h-full object-cover group-hover:scale-110 transition duration-500">
                    
                    <span class="absolute bottom-2 left-2 bg-slate-900 text-yellow-400 text-xs font-bold px-2 py-1 rounded">
                        <%= post.category %>
                    </span>
                    <span class="absolute bottom-2 right-2 bg-white/90 text-slate-900 text-xs font-bold px-2 py-1 rounded flex items-center">
                        📍 <%= post.location || 'Toàn quốc' %>
                    </span>
                </div>
                
                <div class="p-4">
                    <h4 class="font-bold text-slate-800 mb-1 truncate"><%= post.title %></h4>
                    <p class="text-red-600 font-black text-lg">
                        <%= post.price.toLocaleString('vi-VN') %> đ
                    </p>
                    
                    <div class="flex justify-between items-center mt-3 pt-3 border-t border-dashed">
                        <div class="flex items-center gap-2">
                            <div class="w-6 h-6 rounded-full bg-gray-100 flex items-center justify-center text-xs">👤</div>
                            <span class="text-xs text-slate-500 font-bold"><%= post.author ? post.author.name : 'Ẩn danh' %></span>
                        </div>
                        <span class="text-xs text-slate-400"><%= new Date(post.date).toLocaleDateString('vi-VN') %></span>
                    </div>
                </div>
            </div>
            <% }) %>
        </div>
    </div>
</body>
</html>
</file>

<file path="admin/views/login.ejs">
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập Quản Trị - HaiHand Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap');
        body { font-family: 'Plus Jakarta Sans', 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gradient-to-br from-purple-100 via-indigo-50 to-slate-100 min-h-screen flex items-center justify-center p-4">

    <div class="relative w-full max-w-md">
        <!-- Background Glow Blurs -->
        <div class="absolute -top-10 -left-10 w-48 h-48 bg-purple-400/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-10 -right-10 w-48 h-48 bg-indigo-400/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative bg-white/90 backdrop-blur-xl p-8 sm:p-10 rounded-3xl shadow-xl shadow-purple-500/10 border border-white">
            <!-- Brand Icon & Header -->
            <div class="text-center mb-8">
                <div class="w-14 h-14 mx-auto mb-4 rounded-2xl bg-gradient-to-tr from-purple-600 via-purple-700 to-indigo-600 text-white flex items-center justify-center text-2xl font-bold shadow-lg shadow-purple-500/30">
                    ⚡
                </div>
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">
                    Hai<span class="text-purple-600">Hand</span> Admin
                </h1>
                <p class="text-slate-400 text-xs font-semibold mt-1">Hệ thống quản trị thương mại điện tử</p>
            </div>

            <% if (error) { %>
                <div class="bg-rose-50 border border-rose-200 text-rose-600 px-4 py-3 rounded-2xl text-xs font-bold mb-6 flex items-center gap-2">
                    <i class="fas fa-exclamation-circle text-sm shrink-0"></i>
                    <span><%= error %></span>
                </div>
            <% } %>

            <!-- Login Form -->
            <form action="/login" method="POST" class="space-y-4 mb-6">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">Tài khoản</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
                            <i class="fas fa-user text-xs"></i>
                        </span>
                        <input 
                            type="text" 
                            name="username" 
                            class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium focus:border-purple-400 focus:bg-white focus:ring-4 focus:ring-purple-500/10 outline-none transition" 
                            placeholder="Nhập tên đăng nhập" 
                            required
                        />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">Mật khẩu</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
                            <i class="fas fa-lock text-xs"></i>
                        </span>
                        <input 
                            type="password" 
                            name="password" 
                            class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium focus:border-purple-400 focus:bg-white focus:ring-4 focus:ring-purple-500/10 outline-none transition" 
                            placeholder="••••••••" 
                            required
                        />
                    </div>
                </div>

                <button 
                    type="submit" 
                    class="w-full bg-gradient-to-r from-purple-600 via-purple-700 to-indigo-600 text-white font-bold py-3 rounded-xl hover:shadow-lg hover:shadow-purple-500/25 transition-all duration-200 text-xs tracking-wider uppercase mt-2"
                >
                    Đăng Nhập Quản Trị
                </button>
            </form>

            <div class="relative my-6 text-center">
                <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-slate-200/80"></div></div>
                <span class="relative bg-white px-3 text-[11px] font-bold uppercase tracking-wider text-slate-400">Hoặc tạo tài khoản Admin</span>
            </div>

            <!-- Register Form for Admin Setup -->
            <form action="/register" method="POST" class="space-y-3">
                <input type="text" name="name" placeholder="Họ và tên" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium outline-none focus:bg-white focus:border-purple-400" required>
                <input type="email" name="email" placeholder="Email quản trị" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium outline-none focus:bg-white focus:border-purple-400" required>
                <input type="text" name="username" placeholder="Tên đăng nhập mới" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium outline-none focus:bg-white focus:border-purple-400" required>
                <input type="password" name="password" placeholder="Mật khẩu mới" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium outline-none focus:bg-white focus:border-purple-400" required>
                
                <input type="hidden" name="role" value="Admin" />

                <button type="submit" class="w-full bg-slate-100 hover:bg-purple-50 text-slate-600 hover:text-purple-700 font-bold py-2.5 rounded-xl text-xs transition">
                    Tạo Tài Khoản Admin
                </button>
            </form>
        </div>
    </div>

</body>
</html>
</file>

<file path="admin/views/order-detail.ejs">
<!-- ORDER DETAIL VIEW (Inner Content Only for AdminLayout Outlet) -->
<div class="space-y-6 max-w-4xl mx-auto">
    
    <!-- Title & Back Link -->
    <div class="flex items-center justify-between">
        <div>
            <div class="flex items-center gap-2.5">
                <h2 class="text-2xl lg:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
                    📋 Chi Tiết Đơn Hàng
                </h2>
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-purple-100 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 border border-purple-200/60 dark:border-purple-800">
                    #<%= order._id.toString().slice(-6).toUpperCase() %>
                </span>
            </div>
            <p class="text-slate-500 dark:text-slate-400 text-xs mt-1 font-medium">
                Ngày đặt: <%= new Date(order.createdAt).toLocaleString('vi-VN') %>
            </p>
        </div>
        <a href="/orders" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:text-purple-600 dark:hover:text-purple-400 hover:bg-purple-50 dark:hover:bg-slate-700/80 transition text-xs font-bold">
            <i class="fas fa-arrow-left text-[10px]"></i>
            <span>Quay lại</span>
        </a>
    </div>

    <!-- Main Order Details Card -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl shadow-sm border border-slate-200/80 dark:border-slate-800 overflow-hidden transition-colors duration-200">
        <div class="bg-gradient-to-r from-purple-600 to-indigo-600 p-6 text-white flex justify-between items-center">
            <div>
                <h3 class="text-lg font-black">Mã đơn: #<%= order._id.toString().slice(-6).toUpperCase() %></h3>
                <p class="text-xs opacity-80 mt-0.5">Trạng thái thanh toán & vận chuyển</p>
            </div>
            <div>
                <span class="px-3 py-1 rounded-full text-xs font-black uppercase bg-white/20 backdrop-blur-xs text-white border border-white/30">
                    <%= order.status %>
                </span>
            </div>
        </div>

        <div class="p-6 grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Left: Buyer & Seller Info -->
            <div class="space-y-6">
                <div>
                    <h4 class="text-slate-400 dark:text-slate-500 uppercase text-[10px] font-bold tracking-widest mb-3">Người mua</h4>
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-purple-100 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 flex items-center justify-center font-bold text-sm">
                            <%= (order.buyer?.name || 'U').charAt(0).toUpperCase() %>
                        </div>
                        <div>
                            <p class="font-bold text-slate-800 dark:text-slate-100 text-sm"><%= order.buyer?.name || 'Ẩn danh' %></p>
                            <p class="text-xs text-slate-400 dark:text-slate-500"><%= order.buyer?.email || 'Chưa có email' %></p>
                        </div>
                    </div>
                </div>

                <div class="pt-4 border-t border-slate-100 dark:border-slate-800">
                    <h4 class="text-slate-400 dark:text-slate-500 uppercase text-[10px] font-bold tracking-widest mb-3">Người bán</h4>
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-amber-100 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 flex items-center justify-center font-bold text-sm">
                            <%= (order.seller?.name || 'S').charAt(0).toUpperCase() %>
                        </div>
                        <div>
                            <p class="font-bold text-slate-800 dark:text-slate-100 text-sm"><%= order.seller?.name || 'Chưa xác định' %></p>
                            <p class="text-xs text-slate-400 dark:text-slate-500"><%= order.seller?.email || '' %></p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Products & Summary -->
            <div class="md:col-span-2 bg-slate-50 dark:bg-slate-800/40 rounded-2xl p-6 border border-slate-100 dark:border-slate-800">
                <h4 class="text-slate-700 dark:text-slate-300 font-bold mb-4 text-xs uppercase tracking-wider">Thông tin thanh toán</h4>
                <div class="space-y-3">
                    <div class="flex justify-between items-center text-xs">
                        <span class="text-slate-500 dark:text-slate-400">Địa chỉ giao hàng:</span>
                        <span class="font-medium text-slate-800 dark:text-slate-200"><%= order.address || 'Không có địa chỉ' %></span>
                    </div>
                    <div class="flex justify-between items-center text-xs">
                        <span class="text-slate-500 dark:text-slate-400">Số điện thoại liên hệ:</span>
                        <span class="font-medium text-slate-800 dark:text-slate-200"><%= order.phone || 'Không có SĐT' %></span>
                    </div>
                    <div class="flex justify-between items-center text-xs">
                        <span class="text-slate-500 dark:text-slate-400">Phương thức thanh toán:</span>
                        <span class="font-bold text-purple-600 dark:text-purple-400"><%= order.paymentMethod || 'HaiPay' %></span>
                    </div>
                </div>

                <div class="mt-6 pt-6 border-t-2 border-dashed border-slate-200 dark:border-slate-700 flex justify-between items-center">
                    <span class="text-slate-600 dark:text-slate-400 font-bold text-sm">TỔNG THANH TOÁN:</span>
                    <span class="text-2xl font-black text-emerald-600 dark:text-emerald-400"><%= (order.totalPrice || order.totalAmount || 0).toLocaleString('vi-VN') %> đ</span>
                </div>
            </div>
        </div>
    </div>

</div>
</file>

<file path="admin/views/orders.ejs">
<!-- ORDERS VIEW (Inner Content Only for AdminLayout Outlet) -->
<div class="space-y-6">
    
    <!-- Title & Search Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2.5">
                <h2 class="text-2xl lg:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
                    🛍️ Quản Lý Đơn Hàng
                </h2>
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-purple-100 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 border border-purple-200/60 dark:border-purple-800">
                    <%= typeof orders !== 'undefined' ? orders.length : 0 %> Đơn hàng
                </span>
            </div>
            <p class="text-slate-500 dark:text-slate-400 text-xs mt-1 font-medium">
                Theo dõi quy trình giao dịch, trạng thái thanh toán và giải ngân qua ví HaiPay.
            </p>
        </div>

        <div class="relative w-full sm:w-80">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400 dark:text-slate-500">
                <i class="fas fa-search text-xs"></i>
            </span>
            <input 
                type="text" 
                id="orderSearch" 
                onkeyup="filterOrders()" 
                placeholder="Tìm mã đơn hoặc tên khách..." 
                class="w-full pl-9 pr-4 py-2.5 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 text-xs font-medium rounded-2xl border border-slate-200 dark:border-slate-700 focus:border-purple-400 dark:focus:border-purple-500 focus:ring-4 focus:ring-purple-500/15 outline-none transition-all placeholder-slate-400 dark:placeholder-slate-500 shadow-sm"
            />
        </div>
    </div>

    <!-- Orders Table Card with Full Light / Dark Mode Adaptation -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl shadow-sm border border-slate-200/80 dark:border-slate-800 overflow-hidden transition-colors duration-200">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse" id="ordersTable">
                <thead>
                    <tr class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200/80 dark:border-slate-800 text-slate-500 dark:text-slate-400 font-bold uppercase text-[11px] tracking-wider">
                        <th class="px-6 py-4">Mã đơn</th>
                        <th class="px-6 py-4">Khách hàng</th>
                        <th class="px-6 py-4">Ngày đặt</th>
                        <th class="px-6 py-4 text-right">Tổng tiền</th>
                        <th class="px-6 py-4 text-center">Trạng thái</th>
                        <th class="px-6 py-4 text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 text-xs">
                    <% if(typeof orders !== 'undefined' && orders && orders.length > 0) { %>
                        <% orders.forEach(order => { %>
                        <tr class="hover:bg-purple-50/40 dark:hover:bg-slate-800/50 transition-colors order-row group">
                            <!-- Order ID -->
                            <td class="px-6 py-4 font-mono font-bold text-purple-600 dark:text-purple-400">
                                #<%= order._id.toString().slice(-6).toUpperCase() %>
                            </td>

                            <!-- Buyer Info -->
                            <td class="px-6 py-4">
                                <div class="font-bold text-slate-800 dark:text-slate-100 group-hover:text-purple-600 dark:group-hover:text-purple-400 transition"><%= order.buyer?.name || 'Ẩn danh' %></div>
                                <div class="text-[11px] text-slate-400 dark:text-slate-500 mt-0.5"><%= order.phone || 'Không có SĐT' %></div>
                            </td>

                            <!-- Date -->
                            <td class="px-6 py-4 text-slate-500 dark:text-slate-400 font-mono text-[11px]">
                                <%= new Date(order.createdAt).toLocaleDateString('vi-VN') %>
                            </td>

                            <!-- Total Price -->
                            <td class="px-6 py-4 font-black text-right text-slate-900 dark:text-white">
                                <%= (order.totalPrice || 0).toLocaleString('vi-VN') %> đ
                            </td>

                            <!-- Status -->
                            <td class="px-6 py-4 text-center">
                                <% if (order.status === 'Đã thanh toán cho người bán' || order.status === 'Đã hủy' || order.status === 'Hoàn thành') { %>
                                    <span class="px-3 py-1 rounded-full text-[10px] font-bold uppercase inline-block
                                        <%= order.status.includes('thanh toán') || order.status === 'Hoàn thành' ? 'bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800' : 'bg-rose-100 dark:bg-rose-950/60 text-rose-700 dark:text-rose-300 border border-rose-200/60 dark:border-rose-800' %>">
                                        <%= order.status %> 🔒
                                    </span>
                                <% } else { %>
                                    <form action="/orders/update-status/<%= order._id %>" method="POST" class="inline-block">
                                        <select name="status" onchange="this.form.submit()" 
                                                class="px-3 py-1.5 rounded-xl text-[10px] font-bold uppercase border border-amber-200 dark:border-amber-800/60 cursor-pointer shadow-sm transition-all bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-300 outline-none">
                                            <option value="Chờ xác nhận" <%= order.status === 'Chờ xác nhận' ? 'selected' : '' %>>Chờ xác nhận</option>
                                            <option value="Đã thanh toán (Admin giữ tiền)" <%= order.status === 'Đã thanh toán (Admin giữ tiền)' ? 'selected' : '' %>>Đã thanh toán</option>
                                            <option value="Người bán đã chuẩn bị hàng" <%= order.status === 'Người bán đã chuẩn bị hàng' ? 'selected' : '' %>>Người bán chuẩn bị xong</option>
                                            <option value="Đang giao hàng" <%= order.status === 'Đang giao hàng' ? 'selected' : '' %>>Đang giao hàng</option>
                                            <option value="Hoàn thành" <%= order.status === 'Hoàn thành' ? 'selected' : '' %>>Hoàn thành</option>
                                            <option value="Đã hủy (Chờ hoàn tiền)" <%= order.status === 'Đã hủy (Chờ hoàn tiền)' ? 'selected' : '' %>>Chờ hoàn tiền</option>
                                            <option value="Đã hủy" <%= order.status === 'Đã hủy' ? 'selected' : '' %>>Đã hủy</option>
                                        </select>
                                    </form>
                                <% } %>
                            </td>

                            <!-- Actions -->
                            <td class="px-6 py-4 text-center whitespace-nowrap space-x-1">
                                <button type="button" 
                                        onclick="openOrderDetails('<%= order._id %>', '<%= order.buyer?.name || `Ẩn danh` %>', '<%= order.phone %>', '<%= order.address %>', '<%= order.createdAt %>', '<%= order.updatedAt %>', '<%= order.totalPrice %>')" 
                                        class="bg-purple-50 dark:bg-purple-950/40 text-purple-700 dark:text-purple-300 border border-purple-200/60 dark:border-purple-800/60 px-3 py-1.5 rounded-xl text-xs font-bold hover:bg-purple-100 dark:hover:bg-purple-900/60 transition-all">
                                    Chi tiết
                                </button>

                                <% if (order.status === 'Hoàn thành') { %>
                                    <button onclick="releaseFunds('<%= order._id %>')" 
                                            class="bg-emerald-600 text-white px-3 py-1.5 rounded-xl text-xs font-bold hover:bg-emerald-700 shadow-sm transition-all">
                                        Giải ngân
                                    </button>
                                <% } %>

                                <% if (order.status === 'Đã hủy (Chờ hoàn tiền)') { %>
                                    <button onclick="refundOrder('<%= order._id %>')" 
                                            class="bg-amber-600 text-white px-3 py-1.5 rounded-xl text-xs font-bold hover:bg-amber-700 shadow-sm transition-all">
                                        Hoàn tiền
                                    </button>
                                <% } %>
                                
                                <button onclick="deleteOrder('<%= order._id %>')" 
                                        class="bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 border border-rose-200/60 dark:border-rose-800/60 px-2.5 py-1.5 rounded-xl text-xs font-bold hover:bg-rose-100 transition-all">
                                    🗑️
                                </button>
                            </td>
                        </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="p-16 text-center text-slate-400 dark:text-slate-500 italic">Chưa có đơn hàng nào trong hệ thống.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Order Details Modal (Adapted for Dark Mode) -->
    <div id="adminOrderModal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[9999] flex justify-center items-center transition-all p-4">
        <div class="bg-white dark:bg-slate-900 rounded-3xl shadow-2xl w-full max-w-md overflow-hidden transform scale-95 transition-transform border border-slate-200 dark:border-slate-800" id="modalContent">
            <div class="bg-slate-900 dark:bg-slate-800 p-5 flex justify-between items-center text-white font-bold border-b border-slate-800 dark:border-slate-700">
                <h3 class="text-sm font-bold flex items-center gap-2">📋 Chi tiết đơn hàng</h3>
                <button onclick="closeOrderDetails()" class="text-slate-400 hover:text-white text-xl">&times;</button>
            </div>
            <div class="p-6 space-y-3 text-xs text-slate-700 dark:text-slate-300">
                <p><b>Mã đơn:</b> <span id="md-id" class="font-mono text-purple-600 dark:text-purple-400 font-bold"></span></p>
                <p><b>Khách hàng:</b> <span id="md-name" class="font-bold"></span></p>
                <p><b>Số điện thoại:</b> <span id="md-phone"></span></p>
                <p><b>Địa chỉ nhận hàng:</b> <span id="md-address"></span></p>
                <p><b>Thời gian tạo:</b> <span id="md-created" class="font-mono"></span></p>
                <div class="border-t border-slate-100 dark:border-slate-800 pt-3">
                    <p class="text-right text-base font-bold text-slate-800 dark:text-slate-100">
                        Tổng thanh toán: <span id="md-price" class="text-emerald-600 dark:text-emerald-400 font-black"></span>
                    </p>
                </div>
            </div>
            <div class="p-4 bg-slate-50 dark:bg-slate-800/50 text-right border-t border-slate-100 dark:border-slate-800">
                <button onclick="closeOrderDetails()" class="bg-slate-800 dark:bg-slate-700 hover:bg-slate-900 text-white px-5 py-2 rounded-xl font-bold text-xs transition">Đóng</button>
            </div>
        </div>
    </div>

</div>

<!-- Scripts for Search, Modal, Delete and Actions -->
<script>
    function filterOrders() {
        const input = document.getElementById("orderSearch").value.toLowerCase();
        const rows = document.querySelectorAll(".order-row");
        rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            row.style.display = text.includes(input) ? "" : "none";
        });
    }

    async function deleteOrder(orderId) {
        if(!confirm("⚠️ Bạn có chắc chắn muốn xóa vĩnh viễn đơn hàng này?")) return;
        try {
            const res = await fetch(`/admin/orders/delete/${orderId}`, { method: 'POST' });
            if(res.ok) window.spaNavigate('/orders');
        } catch (e) {
            alert("Lỗi khi xóa đơn hàng!");
        }
    }

    async function releaseFunds(orderId) {
        if(!confirm("💰 Xác nhận giải ngân doanh thu cho người bán?")) return;
        try {
            const res = await fetch(`/api/admin/release-funds/${orderId}`, { method: 'POST' });
            const data = await res.json();
            alert(data.message || 'Giải ngân thành công!');
            window.spaNavigate('/orders');
        } catch (e) {
            alert("Lỗi khi giải ngân!");
        }
    }

    async function refundOrder(orderId) {
        if(!confirm("💸 Xác nhận hoàn trả lại tiền vào ví HaiPay cho khách hàng?")) return;
        try {
            const res = await fetch(`/api/admin/refund-order/${orderId}`, { method: 'POST' });
            const data = await res.json();
            alert(data.message || 'Hoàn tiền thành công!');
            window.spaNavigate('/orders');
        } catch (e) {
            alert("Lỗi hệ thống hoàn tiền!");
        }
    }

    function openOrderDetails(id, name, phone, address, created, updated, price) {
        document.getElementById('md-id').textContent = '#' + id.slice(-6).toUpperCase();
        document.getElementById('md-name').textContent = name;
        document.getElementById('md-phone').textContent = phone;
        document.getElementById('md-address').textContent = address;
        document.getElementById('md-created').textContent = new Date(created).toLocaleString('vi-VN');
        document.getElementById('md-price').textContent = Number(price).toLocaleString('vi-VN') + ' đ';
        document.getElementById('adminOrderModal').classList.remove('hidden');
        setTimeout(() => document.getElementById('modalContent').classList.remove('scale-95'), 10);
    }

    function closeOrderDetails() {
        document.getElementById('modalContent').classList.add('scale-95');
        setTimeout(() => document.getElementById('adminOrderModal').classList.add('hidden'), 150);
    }
</script>
</file>

<file path="admin/views/posts.ejs">
<!-- POSTS VIEW (Inner Content Only for AdminLayout Outlet) -->
<div class="space-y-6">
    
    <!-- Title & Search Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2.5">
                <h2 class="text-2xl lg:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
                    📦 Kiểm Duyệt Tin Đăng & Sản Phẩm
                </h2>
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-purple-100 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 border border-purple-200/60 dark:border-purple-800">
                    <%= typeof posts !== 'undefined' ? posts.length : 0 %> Bài đăng
                </span>
            </div>
            <p class="text-slate-500 dark:text-slate-400 text-xs mt-1 font-medium">
                Kiểm duyệt chất lượng sản phẩm, giá cả và nội dung an toàn cho cộng đồng HaiHand.
            </p>
        </div>

        <div class="relative w-full sm:w-80">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400 dark:text-slate-500">
                <i class="fas fa-search text-xs"></i>
            </span>
            <input 
                type="text" 
                id="postSearch" 
                onkeyup="filterPosts()" 
                placeholder="Tìm tên sản phẩm, người bán..." 
                class="w-full pl-9 pr-4 py-2.5 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 text-xs font-medium rounded-2xl border border-slate-200 dark:border-slate-700 focus:border-purple-400 dark:focus:border-purple-500 focus:ring-4 focus:ring-purple-500/15 outline-none transition-all placeholder-slate-400 dark:placeholder-slate-500 shadow-sm"
            />
        </div>
    </div>

    <!-- Posts Table Card with Full Light / Dark Mode Adaptation -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl shadow-sm border border-slate-200/80 dark:border-slate-800 overflow-hidden transition-colors duration-200">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse" id="postTable">
                <thead>
                    <tr class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200/80 dark:border-slate-800 text-slate-500 dark:text-slate-400 font-bold uppercase text-[11px] tracking-wider">
                        <th class="p-4 px-6">Sản phẩm</th>
                        <th class="p-4 px-6">Người bán</th>
                        <th class="p-4 px-6 text-right">Giá niêm yết</th>
                        <th class="p-4 px-6 text-center">Trạng thái</th>
                        <th class="p-4 px-6 text-center">Quản lý</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 text-xs">
                    <% if (typeof posts !== 'undefined' && posts && posts.length > 0) { %>
                        <% posts.forEach(post => { %>
                        <tr class="hover:bg-purple-50/40 dark:hover:bg-slate-800/50 transition-colors post-row group">
                            <!-- Product thumbnail & title -->
                            <td class="p-4 px-6">
                                <div class="flex items-center space-x-3">
                                    <% 
                                        let imgSrc = 'https://upload.wikimedia.org/wikipedia/commons/1/14/No_Image_Available.jpg';
                                        if (post.images && post.images.length > 0) {
                                            imgSrc = post.images[0].startsWith('http') ? post.images[0] : '/' + post.images[0].replace(/\\/g, '/');
                                        } else if (post.image) {
                                            imgSrc = post.image.startsWith('http') ? post.image : '/' + post.image.replace(/\\/g, '/');
                                        }
                                    %>
                                    <img src="<%= imgSrc %>" onerror="this.src='https://upload.wikimedia.org/wikipedia/commons/1/14/No_Image_Available.jpg'" class="w-12 h-12 object-cover rounded-xl shadow-sm border border-slate-200/60 dark:border-slate-700 shrink-0" />
                                    <div>
                                        <p class="font-bold text-slate-800 dark:text-slate-100 text-sm group-hover:text-purple-600 dark:group-hover:text-purple-400 transition leading-tight line-clamp-1 max-w-[240px]">
                                            <%= post.title || post.name || 'Không có tiêu đề' %>
                                        </p>
                                        <p class="text-[10px] text-slate-400 dark:text-slate-500 mt-0.5 font-mono">
                                            Mã: #<%= post._id.toString().slice(-6).toUpperCase() %>
                                        </p>
                                    </div>
                                </div>
                            </td>

                            <!-- Seller Info -->
                            <td class="p-4 px-6">
                                <p class="font-bold text-slate-700 dark:text-slate-200"><%= post.author?.name || 'Ẩn danh' %></p>
                                <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-0.5"><%= post.author?.phone || 'Chưa có SĐT' %></p>
                            </td>

                            <!-- Price -->
                            <td class="p-4 px-6 text-right font-black text-slate-900 dark:text-white text-sm">
                                <%= (post.price || 0).toLocaleString('vi-VN') %> đ
                            </td>

                            <!-- Status -->
                            <td class="p-4 px-6 text-center">
                                <span id="post-status-badge-<%= post._id %>">
                                <% if (post.status === 'APPROVED' || post.status === 'active') { %>
                                    <span class="bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800 px-3 py-1 rounded-full text-[10px] font-bold">
                                        ĐÃ DUYỆT
                                    </span>
                                <% } else if (post.status === 'inactive') { %>
                                    <span class="bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-300 dark:border-slate-700 px-3 py-1 rounded-full text-[10px] font-bold">
                                        ĐÃ GỠ
                                    </span>
                                <% } else { %>
                                    <span class="bg-amber-100 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 border border-amber-200/60 dark:border-amber-800 px-3 py-1 rounded-full text-[10px] font-bold animate-pulse">
                                        CHỜ DUYỆT
                                    </span>
                                <% } %>
                                </span>
                            </td>

                            <!-- Actions -->
                            <td class="p-4 px-6 text-center space-x-1.5 whitespace-nowrap" id="post-actions-<%= post._id %>">
                                <% if (post.status !== 'APPROVED' && post.status !== 'active') { %>
                                    <button 
                                        type="button"
                                        onclick="approvePost('<%= post._id %>')" 
                                        class="inline-flex items-center gap-1 bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-3 py-1.5 rounded-xl transition text-xs shadow-sm cursor-pointer"
                                    >
                                        <i class="fas fa-check text-[10px]"></i>
                                        <span>Duyệt</span>
                                    </button>
                                <% } %>
                                <% if (post.status !== 'inactive') { %>
                                    <button 
                                        type="button"
                                        onclick="hidePost('<%= post._id %>')" 
                                        class="inline-flex items-center gap-1 text-rose-600 dark:text-rose-400 bg-rose-50 dark:bg-rose-950/40 hover:bg-rose-100 dark:hover:bg-rose-900/60 border border-rose-200/60 dark:border-rose-800/60 px-3 py-1.5 rounded-xl font-bold transition text-xs cursor-pointer"
                                    >
                                        <i class="fas fa-eye-slash text-[10px]"></i>
                                        <span>Gỡ</span>
                                    </button>
                                <% } else { %>
                                    <button 
                                        type="button"
                                        onclick="approvePost('<%= post._id %>')" 
                                        class="inline-flex items-center gap-1 text-purple-600 dark:text-purple-400 bg-purple-50 dark:bg-purple-950/40 hover:bg-purple-100 dark:hover:bg-purple-900/60 border border-purple-200/60 dark:border-purple-800/60 px-3 py-1.5 rounded-xl font-bold transition text-xs cursor-pointer"
                                    >
                                        <i class="fas fa-redo text-[10px]"></i>
                                        <span>Khôi phục</span>
                                    </button>
                                <% } %>
                            </td>
                        </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="p-16 text-center text-slate-400 dark:text-slate-500 italic">Chưa có bài viết hoặc tin đăng nào.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <div id="noResults" class="hidden text-center py-12">
            <div class="text-4xl mb-2">🔍</div>
            <p class="text-slate-500 dark:text-slate-400 font-medium">Không tìm thấy sản phẩm nào phù hợp!</p>
        </div>
    </div>

</div>

<script>
    function filterPosts() {
        const input = document.getElementById("postSearch").value.toLowerCase();
        const rows = document.querySelectorAll(".post-row");
        let hasData = false;
        rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            if (text.includes(input)) {
                row.style.display = "";
                hasData = true;
            } else {
                row.style.display = "none";
            }
        });
        document.getElementById("noResults").classList.toggle("hidden", hasData || rows.length === 0);
        document.getElementById("postTable").classList.toggle("hidden", !hasData && rows.length > 0);
    }

    async function approvePost(postId) {
        const badgeContainer = document.getElementById(`post-status-badge-${postId}`);
        const actionsContainer = document.getElementById(`post-actions-${postId}`);
        try {
            const res = await fetch(`/api/admin/posts/approve/${postId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            if (data.success) {
                if (badgeContainer) {
                    badgeContainer.innerHTML = `<span class="bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800 px-3 py-1 rounded-full text-[10px] font-bold">ĐÃ DUYỆT</span>`;
                }
                if (actionsContainer) {
                    actionsContainer.innerHTML = `
                        <button 
                            type="button"
                            onclick="hidePost('${postId}')" 
                            class="inline-flex items-center gap-1 text-rose-600 dark:text-rose-400 bg-rose-50 dark:bg-rose-950/40 hover:bg-rose-100 dark:hover:bg-rose-900/60 border border-rose-200/60 dark:border-rose-800/60 px-3 py-1.5 rounded-xl font-bold transition text-xs cursor-pointer"
                        >
                            <i class="fas fa-eye-slash text-[10px]"></i>
                            <span>Gỡ</span>
                        </button>
                    `;
                }
            } else {
                alert(data.message || 'Lỗi khi duyệt bài đăng');
            }
        } catch (e) {
            console.error('Lỗi khi duyệt bài:', e);
        }
    }

    async function hidePost(postId) {
        const badgeContainer = document.getElementById(`post-status-badge-${postId}`);
        const actionsContainer = document.getElementById(`post-actions-${postId}`);
        try {
            const res = await fetch(`/api/admin/posts/hide/${postId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            if (data.success) {
                if (badgeContainer) {
                    badgeContainer.innerHTML = `<span class="bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-300 dark:border-slate-700 px-3 py-1 rounded-full text-[10px] font-bold">ĐÃ GỠ</span>`;
                }
                if (actionsContainer) {
                    actionsContainer.innerHTML = `
                        <button 
                            type="button"
                            onclick="approvePost('${postId}')" 
                            class="inline-flex items-center gap-1 text-purple-600 dark:text-purple-400 bg-purple-50 dark:bg-purple-950/40 hover:bg-purple-100 dark:hover:bg-purple-900/60 border border-purple-200/60 dark:border-purple-800/60 px-3 py-1.5 rounded-xl font-bold transition text-xs cursor-pointer"
                        >
                            <i class="fas fa-redo text-[10px]"></i>
                            <span>Khôi phục</span>
                        </button>
                    `;
                }
            } else {
                alert(data.message || 'Lỗi khi gỡ bài đăng');
            }
        } catch (e) {
            console.error('Lỗi khi gỡ bài:', e);
        }
    }
</script>
</file>

<file path="admin/views/reports.ejs">
<!-- REPORTS VIEW (Inner Content Only for AdminLayout Outlet) -->
<div class="space-y-6">
    
    <!-- Title & Stats Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2.5">
                <h2 class="text-2xl lg:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
