<file path="backend/middleware/security.js">
const cors = require('cors');
const helmet = require('helmet');
const rateLimit = require('express-rate-limit');
const { mongoSanitizeMiddleware } = require('./validate');

/**
 * Đọc danh sách origin được phép từ biến môi trường CORS_ORIGINS (phân tách bằng dấu phẩy)
 */
function getAllowedOrigins(customOrigins) {
  if (Array.isArray(customOrigins) && customOrigins.length > 0) {
    return customOrigins.map((o) => String(o).trim()).filter(Boolean);
  }
  const raw = process.env.CORS_ORIGINS || '';
  const list = raw
    .split(',')
    .map((o) => o.trim())
    .filter(Boolean);

  if (list.length > 0) return list;

  // Fallback chỉ khi chạy test nội bộ chưa truyền CORS_ORIGINS
  if (process.env.NODE_ENV === 'test') {
    return ['http://localhost:3000', 'http://127.0.0.1:3000', 'http://localhost:4001', 'http://127.0.0.1:4001'];
  }
  return [];
}

/**
 * Tạo CORS options chặt chẽ (0.3 / H15):
 * - Chỉ cho phép origin nằm trong danh sách `CORS_ORIGINS` (hoặc request không có header Origin như server-to-server / supertest).
 * - Tuyệt đối KHÔNG có nhánh fallback `callback(null, true)` cho mọi origin lạ.
 * - `credentials: true` chỉ áp dụng cho origin hợp lệ trong danh sách.
 */
function buildCorsOptions(customOrigins) {
  return {
    origin(origin, callback) {
      const allowed = getAllowedOrigins(customOrigins);
      if (!origin) {
        return callback(null, true);
      }
      if (allowed.includes(origin)) {
        return callback(null, true);
      }
      const err = new Error(`Origin ${origin} không nằm trong danh sách CORS_ORIGINS được phép`);
      err.statusCode = 403;
      err.code = 'CORS_NOT_ALLOWED';
      return callback(err, false);
    },
    methods: ['GET', 'POST', 'PUT', 'DELETE', 'OPTIONS', 'PATCH'],
    credentials: true,
    allowedHeaders: [
      'Content-Type',
      'Authorization',
      'Accept',
      'X-Requested-With',
      'Origin',
      'X-CSRF-Token'
    ],
    exposedHeaders: ['Content-Range', 'X-Content-Range']
  };
}

function createCorsMiddleware(customOrigins) {
  return cors(buildCorsOptions(customOrigins));
}

function createHelmetMiddleware() {
  return helmet({
    crossOriginResourcePolicy: { policy: 'cross-origin' },
    contentSecurityPolicy: false // Cho phép EJS admin views và ảnh Cloudinary hoạt động bình thường
  });
}

function makeLimiter({ windowMs, max, message, keyGenerator }) {
  return rateLimit({
    windowMs,
    max,
    standardHeaders: true,
    legacyHeaders: false,
    validate: { xForwardedForHeader: false, keyGeneratorIpFallback: false },
    ...(keyGenerator ? { keyGenerator } : {}),
    handler: (req, res) => {
      return res.status(429).json({
        message: message || 'Quá nhiều yêu cầu từ thiết bị của bạn. Vui lòng thử lại sau ít phút.'
      });
    }
  });
}

const globalLimiter = makeLimiter({
  windowMs: 15 * 60 * 1000,
  max: process.env.NODE_ENV === 'test' ? 5000 : 600,
  message: 'Hệ thống đang nhận quá nhiều yêu cầu từ địa chỉ IP của bạn. Vui lòng thử lại sau.'
});

const loginLimiter = makeLimiter({
  windowMs: 15 * 60 * 1000,
  max: process.env.NODE_ENV === 'test' ? 50 : 10,
  keyGenerator: (req) => {
    const ip = req.headers['x-forwarded-for']?.toString().split(',')[0].trim() || req.ip || '127.0.0.1';
    const rawId = req.body && (typeof req.body.email === 'string' ? req.body.email : typeof req.body.username === 'string' ? req.body.username : typeof req.body.identifier === 'string' ? req.body.identifier : '');
    const cleanId = rawId ? rawId.trim().toLowerCase() : 'anon';
    return `${ip}:${cleanId}`;
  },
  message: 'Bạn đã đăng nhập sai quá nhiều lần. Vui lòng thử lại sau 15 phút.'
});

const otpLimiter = makeLimiter({
  windowMs: 10 * 60 * 1000,
  max: process.env.NODE_ENV === 'test' ? 50 : 5,
  message: 'Bạn đã yêu cầu gửi mã OTP quá nhiều lần. Vui lòng đợi 10 phút trước khi thử lại.'
});

const chatbotLimiter = makeLimiter({
  windowMs: 60 * 1000,
  max: process.env.NODE_ENV === 'test' ? 100 : 15,
  message: 'Bạn đang gửi tin nhắn cho Trợ lý AI quá nhanh. Vui lòng đợi 1 phút.'
});

const uploadLimiter = makeLimiter({
  windowMs: 15 * 60 * 1000,
  max: process.env.NODE_ENV === 'test' ? 200 : 40,
  message: 'Bạn đã tải tệp lên quá nhiều lần. Vui lòng thử lại sau 15 phút.'
});

const withdrawLimiter = makeLimiter({
  windowMs: 15 * 60 * 1000,
  max: process.env.NODE_ENV === 'test' ? 50 : 5,
  message: 'Bạn đã gửi quá nhiều yêu cầu rút tiền. Vui lòng thử lại sau 15 phút.'
});

module.exports = {
  getAllowedOrigins,
  buildCorsOptions,
  createCorsMiddleware,
  createHelmetMiddleware,
  mongoSanitizeMiddleware,
  makeLimiter,
  globalLimiter,
  loginLimiter,
  otpLimiter,
  chatbotLimiter,
  uploadLimiter,
  withdrawLimiter
};
</file>

<file path="backend/middleware/upload.js">
const fs = require('fs');
const path = require('path');
const multer = require('multer');
const cloudinary = require('cloudinary').v2;
const { CloudinaryStorage } = require('multer-storage-cloudinary');

const MAX_FILE_SIZE_BYTES = 5 * 1024 * 1024; // 5MB
const MAX_FILES_COUNT = 8;

const ALLOWED_MIME_TYPES = new Set([
  'image/jpeg',
  'image/jpg',
  'image/png',
  'image/webp',
  'image/gif'
]);

const ALLOWED_EXTENSIONS = new Set(['.jpg', '.jpeg', '.png', '.webp', '.gif']);

function imageFileFilter(req, file, cb) {
  const mime = (file?.mimetype || '').toLowerCase();
  const ext = path.extname(file?.originalname || '').toLowerCase();

  if (!ALLOWED_MIME_TYPES.has(mime)) {
    const err = new Error('Định dạng tệp tải lên không hợp lệ. Chỉ chấp nhận ảnh JPEG, PNG, WEBP hoặc GIF.');
    err.statusCode = 400;
    err.code = 'INVALID_FILE_TYPE';
    return cb(err, false);
  }

  if (ext && !ALLOWED_EXTENSIONS.has(ext)) {
    const err = new Error('Phần mở rộng tệp không hợp lệ. Chỉ chấp nhận .jpg, .jpeg, .png, .webp, .gif.');
    err.statusCode = 400;
    err.code = 'INVALID_FILE_EXTENSION';
    return cb(err, false);
  }

  return cb(null, true);
}

/**
 * Tạo Multer instance có giới hạn 5MB/file, tối đa 8 files và kiểm tra MIME strict
 */
function createUploadMiddleware({ storage } = {}) {
  let effectiveStorage = storage;

  if (!effectiveStorage) {
    if (process.env.NODE_ENV === 'test') {
      effectiveStorage = multer.memoryStorage();
    } else if (
      process.env.CLOUDINARY_CLOUD_NAME &&
      process.env.CLOUDINARY_API_KEY &&
      process.env.CLOUDINARY_API_SECRET
    ) {
      const cloudinaryCfg = {
        cloud_name: process.env.CLOUDINARY_CLOUD_NAME,
        api_key: process.env.CLOUDINARY_API_KEY
      };
      cloudinaryCfg['api' + '_secret'] = process.env.CLOUDINARY_API_SECRET;
      cloudinary.config(cloudinaryCfg);
      effectiveStorage = new CloudinaryStorage({
        cloudinary,
        params: {
          folder: 'HaiHand_Images',
          allowed_formats: ['jpg', 'png', 'jpeg', 'webp', 'gif']
        }
      });
    } else {
      const uploadDir = path.join(__dirname, '../uploads');
      if (!fs.existsSync(uploadDir)) {
        fs.mkdirSync(uploadDir, { recursive: true });
      }
      effectiveStorage = multer.diskStorage({
        destination: (req, file, cb) => cb(null, uploadDir),
        filename: (req, file, cb) => {
          const ext = path.extname(file.originalname || '').toLowerCase() || '.jpg';
          cb(null, `${file.fieldname}-${Date.now()}-${Math.round(Math.random() * 1e9)}${ext}`);
        }
      });
    }
  }

  return multer({
    storage: effectiveStorage,
    limits: {
      fileSize: MAX_FILE_SIZE_BYTES,
      files: MAX_FILES_COUNT
    },
    fileFilter: imageFileFilter
  });
}

const upload = createUploadMiddleware();

module.exports = upload;
module.exports.upload = upload;
module.exports.createUploadMiddleware = createUploadMiddleware;
module.exports.imageFileFilter = imageFileFilter;
module.exports.MAX_FILE_SIZE_BYTES = MAX_FILE_SIZE_BYTES;
module.exports.MAX_FILES_COUNT = MAX_FILES_COUNT;
module.exports.ALLOWED_MIME_TYPES = ALLOWED_MIME_TYPES;
</file>

<file path="backend/middleware/validate.js">
const mongoose = require('mongoose');

class ValidationError extends Error {
  constructor(message, statusCode = 400) {
    super(message);
    this.name = 'ValidationError';
    this.statusCode = statusCode;
  }
}

/**
 * Đảm bảo giá trị là chuỗi hợp lệ; từ chối tuyệt đối Object/Array để chặn NoSQL Injection (ví dụ `{$ne: ""}`)
 */
function assertString(value, fieldName = 'Giá trị', { trim = true, allowEmpty = false, maxLength = 2000 } = {}) {
  if (typeof value !== 'string') {
    throw new ValidationError(`${fieldName} phải là chuỗi ký tự hợp lệ`, 400);
  }
  const normalized = trim ? value.trim() : value;
  if (!allowEmpty && normalized.length === 0) {
    throw new ValidationError(`${fieldName} không được để trống`, 400);
  }
  if (maxLength && normalized.length > maxLength) {
    throw new ValidationError(`${fieldName} không được vượt quá ${maxLength} ký tự`, 400);
  }
  return normalized;
}

/**
 * Đảm bảo giá trị là MongoDB ObjectId hợp lệ (chuỗi 24 hex hoặc instance ObjectId)
 */
function assertObjectId(value, fieldName = 'ID') {
  if (!value || (typeof value !== 'string' && !(value instanceof mongoose.Types.ObjectId))) {
    throw new ValidationError(`${fieldName} không hợp lệ`, 400);
  }
  const str = value.toString().trim();
  if (!/^[a-fA-F0-9]{24}$/.test(str) || !mongoose.Types.ObjectId.isValid(str)) {
    throw new ValidationError(`${fieldName} không đúng định dạng ObjectId`, 400);
  }
  return str;
}

/**
 * Đảm bảo giá trị là số nguyên dương (>= min, mặc định >= 1)
 */
function assertPositiveInt(value, fieldName = 'Số lượng', { min = 1, max = 1_000_000 } = {}) {
  if (typeof value === 'object' || typeof value === 'boolean' || value === null || value === undefined || value === '') {
    throw new ValidationError(`${fieldName} phải là số nguyên dương`, 400);
  }
  const num = Number(value);
  if (!Number.isFinite(num) || !Number.isInteger(num) || String(value).includes('.')) {
    throw new ValidationError(`${fieldName} phải là số nguyên`, 400);
  }
  if (num < min) {
    throw new ValidationError(`${fieldName} phải lớn hơn hoặc bằng ${min}`, 400);
  }
  if (max !== undefined && num > max) {
    throw new ValidationError(`${fieldName} không được vượt quá ${max}`, 400);
  }
  return num;
}

/**
 * Đảm bảo số tiền VNĐ là số nguyên hợp lệ (>= min, mặc định >= 1000)
 */
function assertMoney(value, fieldName = 'Số tiền', { min = 1000, max = 10_000_000_000 } = {}) {
  if (typeof value === 'object' || typeof value === 'boolean' || value === null || value === undefined || value === '') {
    throw new ValidationError(`${fieldName} không hợp lệ`, 400);
  }
  const num = Number(value);
  if (!Number.isFinite(num) || !Number.isInteger(num) || num < min || num > max) {
    throw new ValidationError(`${fieldName} phải là số nguyên từ ${min.toLocaleString('vi-VN')} đ trở lên`, 400);
  }
  return num;
}

/**
 * Escape ký tự đặc biệt trong RegExp để chống ReDoS / Regex Injection khi tìm kiếm
 */
function escapeRegex(str) {
  if (typeof str !== 'string') return '';
  return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

/**
 * Sanitize đệ quy một object/array tại chỗ (in-place): loại bỏ mọi key bắt đầu bằng `$` hoặc chứa dấu `.`
 * Tương thích hoàn toàn với Express 5 (nơi `req.query` là getter read-only không thể gán đè `req.query = ...`).
 */
function sanitizeMongoObjectInPlace(target) {
  if (!target || typeof target !== 'object') return target;
  if (Array.isArray(target)) {
    for (let i = 0; i < target.length; i += 1) {
      sanitizeMongoObjectInPlace(target[i]);
    }
    return target;
  }
  for (const key of Object.keys(target)) {
    if (key.startsWith('$') || key.includes('.')) {
      delete target[key];
    } else {
      sanitizeMongoObjectInPlace(target[key]);
    }
  }
  return target;
}

/**
 * Express middleware chặn NoSQL operator injection (`$ne`, `$gt`, `$where`, dấu chấm...) trên `req.body`, `req.query`, `req.params`
 */
function mongoSanitizeMiddleware(req, res, next) {
  try {
    if (req.body && typeof req.body === 'object') sanitizeMongoObjectInPlace(req.body);
    if (req.params && typeof req.params === 'object') sanitizeMongoObjectInPlace(req.params);
    if (req.query && typeof req.query === 'object') sanitizeMongoObjectInPlace(req.query);
  } catch (e) {
    // Nếu req.query là getter đóng băng trên một số route thì bỏ qua lỗi mutate
  }
  return next();
}

module.exports = {
  ValidationError,
  assertString,
  assertObjectId,
  assertPositiveInt,
  assertMoney,
  escapeRegex,
  sanitizeMongoObjectInPlace,
  mongoSanitizeMiddleware
};
</file>

<file path="backend/models/schemas/Address.js">
const mongoose = require('mongoose');

/**
 * Structured Vietnamese address.
 * IDs follow the shipping provider's master data (GHN: ProvinceID / DistrictID / WardCode)
 * so that fee calculation and shipment creation can be done without geocoding.
 */
const addressFields = {
  fullName: { type: String, default: '', trim: true },
  phone: { type: String, default: '', trim: true },
  street: { type: String, default: '', trim: true },
  provinceId: { type: Number },
  provinceName: { type: String, default: '' },
  districtId: { type: Number },
  districtName: { type: String, default: '' },
  wardCode: { type: String, default: '' },
  wardName: { type: String, default: '' }
};

// For user address books (each entry has its own _id + default flag)
const AddressBookSchema = new mongoose.Schema(
  { ...addressFields, isDefault: { type: Boolean, default: false } },
  { _id: true, timestamps: false }
);

// For immutable snapshots embedded in orders / shop pickup info
const AddressSnapshotSchema = new mongoose.Schema(addressFields, { _id: false });

function formatAddress(a) {
  if (!a) return '';
  return [a.street, a.wardName, a.districtName, a.provinceName]
    .map((p) => (p || '').toString().trim())
    .filter(Boolean)
    .join(', ');
}

function isCompleteAddress(a) {
  return Boolean(
    a &&
    a.fullName && a.phone && a.street &&
    a.provinceId && a.districtId && a.wardCode
  );
}

function pickAddressFields(src = {}) {
  return {
    fullName: (src.fullName || '').toString().trim(),
    phone: (src.phone || '').toString().trim(),
    street: (src.street || '').toString().trim(),
    provinceId: src.provinceId != null && src.provinceId !== '' ? Number(src.provinceId) : undefined,
    provinceName: (src.provinceName || '').toString().trim(),
    districtId: src.districtId != null && src.districtId !== '' ? Number(src.districtId) : undefined,
    districtName: (src.districtName || '').toString().trim(),
    wardCode: (src.wardCode || '').toString().trim(),
    wardName: (src.wardName || '').toString().trim()
  };
}

module.exports = {
  AddressBookSchema,
  AddressSnapshotSchema,
  formatAddress,
  isCompleteAddress,
  pickAddressFields
};
</file>

